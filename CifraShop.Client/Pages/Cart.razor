@page "/cart"
@using CifraShop.Client.Models
@using CifraShop.Client.Services
@inject CartService Cartt
@inject AuthService Auth
@inject NavigationManager Nav

<PageTitle>Корзина — CifraShop</PageTitle>

<style>
    .cart-item {
        transition: background-color 0.2s;
    }

        .cart-item:hover {
            background-color: #f8f9fa;
        }

    .cart-image {
        width: 80px;
        height: 80px;
        object-fit: cover;
        border-radius: 8px;
    }

    .quantity-control {
        width: 120px;
    }
</style>

<nav class="navbar navbar-expand-lg navbar-dark bg-dark sticky-top">
    <div class="container">
        <a class="navbar-brand fw-bold" href="/">
            <i class="bi bi-shop me-2"></i>CifraShop
        </a>
        <div class="d-flex align-items-center gap-3">
            @if (Auth.IsAuthenticated)
            {
                <span class="text-light small">
                    <i class="bi bi-person-circle me-1"></i>@Auth.CurrentUserEmail
                </span>
            }
            <a href="/" class="btn btn-outline-light btn-sm">
                <i class="bi bi-arrow-left me-1"></i>К товарам
            </a>
        </div>
    </div>
</nav>

@if (!string.IsNullOrEmpty(_notification))
{
    <div class="alert alert-@_notificationType alert-dismissible fade show m-3" role="alert">
        <i class="bi bi-@(_notificationType == "success" ? "check-circle-fill" : "exclamation-triangle-fill") me-2"></i>
        @_notification
        <button type="button" class="btn-close" @onclick="() => _notification = null"></button>
    </div>
}

<div class="container py-5">
    <h1 class="fw-bold mb-4">
        <i class="bi bi-cart3 me-2"></i>Корзина
    </h1>

    @if (Cartt.IsEmpty)
    {
        <div class="text-center py-5">
            <i class="bi bi-cart-x display-1 text-secondary"></i>
            <h3 class="mt-3 text-secondary">Корзина пуста</h3>
            <p class="text-secondary mb-4">Добавьте товары из каталога</p>
            <a href="/" class="btn btn-primary btn-lg">
                <i class="bi bi-shop me-2"></i>Перейти к товарам
            </a>
        </div>
    }
    else
    {
        <div class="row g-4">
            <div class="col-lg-8">
                <div class="card shadow-sm">
                    <div class="card-body p-0">
                        @foreach (var item in Cartt.Items)
                        {
                            <div class="cart-item border-bottom p-3">
                                <div class="row align-items-center g-3">
                                    <div class="col-auto">
                                        @if (!string.IsNullOrEmpty(item.ImageUrl))
                                        {
                                            <img src="@item.ImageUrl" class="cart-image" alt="@item.Name" />
                                        }
                                        else
                                        {
                                            <div class="cart-image bg-light d-flex align-items-center justify-content-center">
                                                <i class="bi bi-box display-6 text-secondary"></i>
                                            </div>
                                        }
                                    </div>
                                    <div class="col">
                                        <h5 class="mb-1 fw-bold">@item.Name</h5>
                                        <p class="text-primary fw-bold mb-0">@item.Price ₽</p>
                                    </div>
                                    <div class="col-auto">
                                        <div class="input-group quantity-control">
                                            <button class="btn btn-outline-secondary" type="button"
                                                    @onclick="() => UpdateQuantity(item.ProductId, item.Quantity - 1)">
                                                <i class="bi bi-dash"></i>
                                            </button>
                                            <input type="number" class="form-control text-center" value="@item.Quantity"
                                                   min="1" max="@item.MaxQuantity"
                                                   @onchange="(ChangeEventArgs e) => OnQuantityChanged(item.ProductId, e)" />
                                            <button class="btn btn-outline-secondary" type="button"
                                                    disabled="@(item.Quantity >= item.MaxQuantity)"
                                                    @onclick="() => UpdateQuantity(item.ProductId, item.Quantity + 1)">
                                                <i class="bi bi-plus"></i>
                                            </button>
                                        </div>
                                        @if (item.Quantity >= item.MaxQuantity)
                                        {
                                            <small class="text-warning"><i class="bi bi-exclamation-triangle me-1"></i>Максимум на складе</small>
                                        }
                                    </div>
                                    <div class="col-auto">
                                        <h5 class="mb-0 fw-bold text-primary">@item.Total ₽</h5>
                                    </div>
                                    <div class="col-auto">
                                        <button class="btn btn-outline-danger btn-sm"
                                                @onclick="() => RemoveItem(item.ProductId)">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <div class="mt-3 text-center">
                    <button class="btn btn-outline-secondary" @onclick="ClearCart">
                        <i class="bi bi-trash me-2"></i>Очистить корзину
                    </button>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card shadow-sm sticky-top" style="top: 80px;">
                    <div class="card-body">
                        <h4 class="fw-bold mb-3">Итого</h4>

                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-secondary">Товаров:</span>
                            <span class="fw-bold">@Cartt.ItemsCount шт.</span>
                        </div>

                        <hr />

                        <div class="d-flex justify-content-between mb-3">
                            <span class="h5 mb-0">Сумма:</span>
                            <span class="h5 mb-0 text-primary fw-bold">@Cartt.TotalSum ₽</span>
                        </div>

                        @if (Auth.IsAuthenticated)
                        {
                            <div class="mb-3">
                                <small class="text-secondary">
                                    Ваш баланс: <strong>@(Auth.CurrentBalance?.ToString() ?? "0") ₽</strong>
                                </small>
                                @if (Auth.CurrentBalance < Cartt.TotalSum)
                                {
                                    <div class="alert alert-warning py-2 mt-2 small">
                                        <i class="bi bi-exclamation-triangle me-1"></i>
                                        Недостаточно средств на балансе
                                    </div>
                                }
                            </div>

                            <button class="btn btn-success btn-lg w-100"
                                    disabled="@(!Auth.IsAuthenticated || Auth.CurrentBalance < Cartt.TotalSum)"
                                    @onclick="Checkout">
                                @if (_checkingOut)
                                {
                                    <span class="spinner-border spinner-border-sm me-2"></span>
                                    <span>Оформление...</span>
                                }
                                else
                                {
                                    <i class="bi bi-check-circle me-2"></i>
                                    <span>Оформить заказ</span>
                                }
                            </button>
                        }
                        else
                        {
                            <div class="alert alert-info py-2 small">
                                <i class="bi bi-info-circle me-1"></i>
                                Войдите в систему для оформления заказа
                            </div>
                            <a href="/login" class="btn btn-primary btn-lg w-100">
                                <i class="bi bi-box-arrow-in-right me-2"></i>Войти
                            </a>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private string? _notification;
    private string _notificationType = "success";
    private bool _checkingOut = false;

    protected override async Task OnInitializedAsync()
    {
        Cartt.OnCartChanged += StateHasChanged;
        Auth.OnAuthStateChanged += StateHasChanged;

        if (Auth.IsAuthenticated && !Auth.CurrentBalance.HasValue)
        {
            await Auth.RefreshBalanceAsync();
        }
    }

    private void UpdateQuantity(int productId, int quantity)
    {
        Cartt.UpdateQuantity(productId, quantity);
    }

    private void OnQuantityChanged(int productId, ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int quantity))
        {
            UpdateQuantity(productId, quantity);
        }
    }

    private void RemoveItem(int productId)
    {
        Cartt.RemoveItem(productId);
        ShowNotification("Товар удалён из корзины", "success");
    }

    private void ClearCart()
    {
        Cartt.Clear();
        ShowNotification("Корзина очищена", "success");
    }

    private async Task Checkout()
    {
        if (!Auth.IsAuthenticated || string.IsNullOrEmpty(Auth.CurrentUserEmail))
        {
            ShowNotification("Необходимо войти в систему", "warning");
            return;
        }

        _checkingOut = true;
        StateHasChanged();

        var (success, error) = await Cartt.CheckoutAsync(Auth.CurrentUserEmail);

        if (success)
        {
            ShowNotification("Заказ успешно оформлен!", "success");
            await Auth.RefreshBalanceAsync();
        }
        else
        {
            ShowNotification(error ?? "Ошибка оформления заказа", "danger");
        }

        _checkingOut = false;
        StateHasChanged();
    }

    private void ShowNotification(string message, string type = "success")
    {
        _notification = message;
        _notificationType = type;
        _ = Task.Delay(4000).ContinueWith(_ =>
        {
            _notification = null;
            InvokeAsync(StateHasChanged);
        });
    }
}
