@page "/login"
@using CifraShop.Client.Services
@inject AuthService Auth
@inject NavigationManager Nav

<PageTitle>Вход — CifraShop</PageTitle>

<style>
    .login-container {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    }

    .login-card {
        max-width: 400px;
        width: 100%;
    }
</style>

<div class="login-container">
    <div class="login-card">
        <div class="card shadow-lg">
            <div class="card-body p-5">
                <div class="text-center mb-4">
                    <i class="bi bi-shop display-4 text-primary"></i>
                    <h2 class="fw-bold mt-2">CifraShop</h2>
                    <p class="text-secondary">Вход в систему</p>
                </div>

                @if (!string.IsNullOrEmpty(_error))
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>@_error
                        <button type="button" class="btn-close" @onclick="() => _error = null"></button>
                    </div>
                }

                <EditForm Model="_model" OnValidSubmit="HandleLogin">
                    <DataAnnotationsValidator />

                    <div class="mb-3">
                        <label class="form-label fw-medium">
                            <i class="bi bi-envelope me-1"></i>Email
                        </label>
                        <InputText class="form-control form-control-lg" @bind-Value="_model.Email"
                                   placeholder="your@email.com" />
                        <ValidationMessage For="@(() => _model.Email)" />
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-medium">
                            <i class="bi bi-lock me-1"></i>Пароль
                        </label>
                        <InputText class="form-control form-control-lg" type="password" @bind-Value="_model.Password"
                                   placeholder="••••••••" />
                        <ValidationMessage For="@(() => _model.Password)" />
                    </div>

                    <button type="submit" class="btn btn-primary btn-lg w-100 mb-3" disabled="@_loading">
                        @if (_loading)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                            <span>Вход...</span>
                        }
                        else
                        {
                            <i class="bi bi-box-arrow-in-right me-2"></i>
                            <span>Войти</span>
                        }
                    </button>
                </EditForm>

                <div class="text-center">
                    <p class="text-secondary mb-2">Нет аккаунта?</p>
                    <button class="btn btn-outline-primary w-100" @onclick="ToggleRegister">
                        <i class="bi bi-person-plus me-2"></i>Зарегистрироваться
                    </button>
                </div>

                @if (_showRegister)
                {
                    <hr class="my-4" />
                    <h5 class="fw-bold mb-3">Регистрация</h5>
                    <EditForm Model="_registerModel" OnValidSubmit="HandleRegister">
                        <DataAnnotationsValidator />

                        <div class="mb-3">
                            <label class="form-label fw-medium">Email</label>
                            <InputText class="form-control" @bind-Value="_registerModel.Email"
                                       placeholder="your@email.com" />
                            <ValidationMessage For="@(() => _registerModel.Email)" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-medium">Пароль</label>
                            <InputText class="form-control" type="password" @bind-Value="_registerModel.Password"
                                       placeholder="Минимум 6 символов" />
                            <ValidationMessage For="@(() => _registerModel.Password)" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-medium">Подтвердите пароль</label>
                            <InputText class="form-control" type="password" @bind-Value="_registerModel.ConfirmPassword"
                                       placeholder="Повторите пароль" />
                            <ValidationMessage For="@(() => _registerModel.ConfirmPassword)" />
                        </div>

                        <button type="submit" class="btn btn-success w-100" disabled="@_loading">
                            @if (_loading)
                            {
                                <span class="spinner-border spinner-border-sm me-2"></span>
                                <span>Регистрация...</span>
                            }
                            else
                            {
                                <i class="bi bi-person-plus me-2"></i>
                                <span>Зарегистрироваться</span>
                            }
                        </button>
                    </EditForm>
                }

                <div class="text-center mt-4">
                    <a href="/" class="text-secondary text-decoration-none">
                        <i class="bi bi-arrow-left me-1"></i>Вернуться в магазин
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private LoginModel _model = new();
    private RegisterModel _registerModel = new();
    private bool _loading = false;
    private string? _error;
    private bool _showRegister = false;

    protected override async Task OnInitializedAsync()
    {
        await Auth.InitializeAsync();
        if (Auth.IsAuthenticated)
        {
            Nav.NavigateTo("/");
        }
    }

    private async Task HandleLogin()
    {
        _loading = true;
        _error = null;
        StateHasChanged();

        var (success, error) = await Auth.LoginAsync(_model.Email, _model.Password);

        if (success)
        {
            Nav.NavigateTo("/");
        }
        else
        {
            _error = error;
        }

        _loading = false;
        StateHasChanged();
    }

    private async Task HandleRegister()
    {
        if (_registerModel.Password != _registerModel.ConfirmPassword)
        {
            _error = "Пароли не совпадают";
            return;
        }

        _loading = true;
        _error = null;
        StateHasChanged();

        var (success, error) = await Auth.RegisterAsync(_registerModel.Email, _registerModel.Password);

        if (success)
        {
            Nav.NavigateTo("/");
        }
        else
        {
            _error = error;
        }

        _loading = false;
        StateHasChanged();
    }

    private void ToggleRegister()
    {
        _showRegister = !_showRegister;
        _error = null;
    }

    private class LoginModel
    {
        public string Email { get; set; } = "";
        public string Password { get; set; } = "";
    }

    private class RegisterModel
    {
        public string Email { get; set; } = "";
        public string Password { get; set; } = "";
        public string ConfirmPassword { get; set; } = "";
    }
}