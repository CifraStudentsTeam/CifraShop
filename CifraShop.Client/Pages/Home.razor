@page "/"
@using System.Net.Http.Json
@using CifraShop.Client.Models
@using CifraShop.Client.Services
@implements IDisposable
@inject HttpClient Http
@inject NavigationManager Nav
@inject CartService Cart
@inject AuthService Auth
@inject ShopSignalRService SignalR

<PageTitle>CifraShop — Магазин цифровых товаров</PageTitle>

<style>
    .product-card {
        transition: transform 0.2s, box-shadow 0.2s;
        height: 100%;
        overflow: hidden;
    }

        .product-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15);
        }

    .product-image {
        height: 280px;
        width: 100%;
        object-fit: cover;
        background-color: #f8f9fa;
        display: block;
    }

    .status-badge {
        font-size: 0.75rem;
    }

    .cart-badge {
        position: absolute;
        top: -5px;
        right: -5px;
        font-size: 0.7rem;
    }
</style>

<nav class="navbar navbar-expand-lg navbar-dark bg-dark sticky-top">
    <div class="container">
        <a class="navbar-brand fw-bold" href="/">
            <i class="bi bi-shop me-2"></i>CifraShop
        </a>

        @if (SignalR.IsConnected)
        {
            <span class="badge bg-success me-2" style="font-size: 0.6rem;">● Online</span>
        }

        <div class="d-flex align-items-center gap-3">
            @if (Auth.IsAuthenticated)
            {
                <span class="text-light small">
                    <i class="bi bi-person-circle me-1"></i>@Auth.CurrentUserEmail
                    @if (Auth.CurrentBalance.HasValue)
                    {
                        <span class="badge bg-info ms-2">@Auth.CurrentBalance.Value ₽</span>
                    }
                </span>
                <a href="/order-history" class="btn btn-outline-info btn-sm">
                    <i class="bi bi-clock-history me-1"></i>Мои заказы
                </a>
                <button class="btn btn-outline-light btn-sm" @onclick="Logout">
                    <i class="bi bi-box-arrow-right me-1"></i>Выйти
                </button>
            }
            else
            {
                <a href="/login" class="btn btn-outline-light btn-sm">
                    <i class="bi bi-box-arrow-in-right me-1"></i>Войти
                </a>
            }

            <a href="/cart" class="btn btn-warning btn-sm position-relative">
                <i class="bi bi-cart3 me-1"></i>Корзина
                @if (Cart.ItemsCount > 0)
                {
                    <span class="badge bg-danger cart-badge">@Cart.ItemsCount</span>
                }
            </a>
        </div>
    </div>
</nav>

@if (!string.IsNullOrEmpty(_notification))
{
    <div class="alert alert-@_notificationType alert-dismissible fade show m-3" role="alert">
        <i class="bi bi-@(_notificationType == "success" ? "check-circle-fill" : "exclamation-triangle-fill") me-2"></i>
        @_notification
        <button type="button" class="btn-close" @onclick="() => _notification = null"></button>
    </div>
}

<div class="bg-light py-4 mb-4">
    <div class="container">
        <h1 class="fw-bold mb-2">Добро пожаловать в CifraShop</h1>
        <p class="text-secondary mb-0">Магазин цифровых товаров</p>
    </div>
</div>

<div class="container mb-4">
    <div class="row g-3">
        <div class="col-md-6">
            <div class="input-group">
                <span class="input-group-text"><i class="bi bi-search"></i></span>
                <input type="text" class="form-control" placeholder="Поиск товаров..."
                       value="@_search" @oninput="OnSearchInput" />
            </div>
        </div>
        <div class="col-md-3">
            <select class="form-select" @onchange="OnFilterChanged">
                <option value="">Все статусы</option>
                <option value="0">В наличии</option>
                <option value="1">Нет в наличии</option>
                <option value="2">Скоро поступит</option>
            </select>
        </div>
        <div class="col-md-3">
            <select class="form-select" @onchange="OnSortChanged">
                <option value="">Сортировка</option>
                <option value="price_asc">Цена: по возрастанию</option>
                <option value="price_desc">Цена: по убыванию</option>
                <option value="name_asc">Название: А-Я</option>
                <option value="name_desc">Название: Я-А</option>
            </select>
        </div>
    </div>
</div>

<div class="container mb-5">
    @if (_loading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Загрузка...</span>
            </div>
            <p class="text-secondary mt-3">Загрузка товаров...</p>
        </div>
    }
    else if (!Products.Any())
    {
        <div class="text-center py-5">
            <i class="bi bi-inbox display-1 text-secondary"></i>
            <p class="text-secondary mt-3">Товары не найдены</p>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var product in Products)
            {
                <div class="col-sm-6 col-lg-4 col-xl-3">
                    <div class="card product-card shadow-sm">
                        @{
                            var allImageUrls = new List<string>();
                            if (product.Images.Any())
                                allImageUrls = product.Images.OrderBy(i => i.SortOrder).Select(i => i.Url).ToList();
                            else if (!string.IsNullOrEmpty(product.ImageUrl))
                                allImageUrls.Add(product.ImageUrl);
                        }
                        @if (allImageUrls.Count > 1)
                        {
                            var carouselId = $"carousel-{product.Id}";
                            <div id="@carouselId" class="carousel slide" data-bs-ride="false">
                                <div class="carousel-indicators" style="margin-bottom:0.3rem;">
                                    @for (int i = 0; i < allImageUrls.Count; i++)
                                    {
                                        var idx = i;
                                        <button type="button" data-bs-target="#@carouselId" data-bs-slide-to="@idx"
                                                class="@(idx == 0 ? "active" : "")" style="width:8px;height:8px;border-radius:50%;"></button>
                                    }
                                </div>
                                <div class="carousel-inner">
                                    @for (int i = 0; i < allImageUrls.Count; i++)
                                    {
                                        var idx = i;
                                        <div class="carousel-item @(idx == 0 ? "active" : "")">
                                            <img src="@allImageUrls[idx]" class="card-img-top product-image" alt="@product.Name" />
                                        </div>
                                    }
                                </div>
                                @if (allImageUrls.Count > 1)
                                {
                                    <button class="carousel-control-prev" type="button" data-bs-target="#@carouselId" data-bs-slide="prev" style="width:25px;">
                                        <span class="carousel-control-prev-icon" style="width:12px;height:12px;background-size:100%;filter:none;"></span>
                                    </button>
                                    <button class="carousel-control-next" type="button" data-bs-target="#@carouselId" data-bs-slide="next" style="width:25px;">
                                        <span class="carousel-control-next-icon" style="width:12px;height:12px;background-size:100%;filter:none;"></span>
                                    </button>
                                }
                            </div>
                        }
                        else if (allImageUrls.Count == 1)
                        {
                            <img src="@allImageUrls[0]" class="card-img-top product-image" alt="@product.Name" />
                        }
                        else
                        {
                            <div class="product-image d-flex align-items-center justify-content-center">
                                <i class="bi bi-box display-1 text-secondary"></i>
                            </div>
                        }
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title fw-bold mb-2">@product.Name</h5>
                            <p class="card-text text-secondary small flex-grow-1">
                                @(string.IsNullOrEmpty(product.Description) ? "Описание отсутствует" : product.Description)
                            </p>

                            <div class="mb-2">
                                @switch (product.Status)
                                {
                                    case StatusProduct.InStock:
                                        <span class="badge bg-success status-badge">
                                            <i class="bi bi-check-circle me-1"></i>В наличии (@product.Quantity шт.)
                                        </span>
                                        break;
                                    case StatusProduct.OutOfStock:
                                        <span class="badge bg-danger status-badge">
                                            <i class="bi bi-x-circle me-1"></i>Нет в наличии
                                        </span>
                                        break;
                                    case StatusProduct.ComingSoon:
                                        <span class="badge bg-warning text-dark status-badge">
                                            <i class="bi bi-clock me-1"></i>Скоро поступит
                                        </span>
                                        break;
                                }
                            </div>

                            <div class="d-flex justify-content-between align-items-center mt-auto">
                                <span class="h5 mb-0 text-primary fw-bold">@product.Price ₽</span>
                                <button class="btn btn-primary btn-sm"
                                        disabled="@(product.Status != StatusProduct.InStock)"
                                        @onclick="() => AddToCart(product)">
                                    <i class="bi bi-cart-plus me-1"></i>В корзину
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        @if (_totalPages > 1)
        {
            <nav class="mt-4">
                <ul class="pagination justify-content-center">
                    <li class="page-item @(_currentPage == 0 ? "disabled" : "")">
                        <a class="page-link" href="#" @onclick="() => GoToPage(_currentPage - 1)">
                            <i class="bi bi-chevron-left"></i>
                        </a>
                    </li>
                    @for (int i = 0; i < _totalPages; i++)
                    {
                        var page = i;
                        <li class="page-item @(page == _currentPage ? "active" : "")">
                            <a class="page-link" href="#" @onclick="() => GoToPage(page)">@(_currentPage + 1)</a>
                        </li>
                    }
                    <li class="page-item @(_currentPage >= _totalPages - 1 ? "disabled" : "")">
                        <a class="page-link" href="#" @onclick="() => GoToPage(_currentPage + 1)">
                            <i class="bi bi-chevron-right"></i>
                        </a>
                    </li>
                </ul>
            </nav>
        }
    }
</div>

<footer class="bg-dark text-light py-4 mt-5">
    <div class="container text-center">
        <p class="mb-0">&copy; 2026 CifraShop. Все права защищены.</p>
    </div>
</footer>

@code {
    private List<ProductDto> Products = new();
    private bool _loading = true;
    private string? _notification;
    private string _notificationType = "success";

    private string _search = "";
    private string _filter = "";
    private string _sort = "";
    private int _currentPage = 0;
    private int _pageSize = 12;
    private int _totalCount = 0;
    private int _totalPages => Math.Max(1, (int)Math.Ceiling(_totalCount / (double)_pageSize));

    private CancellationTokenSource? _searchCts;

    protected override async Task OnInitializedAsync()
    {
        Auth.OnAuthStateChanged += StateHasChanged;
        Cart.OnCartChanged += StateHasChanged;

        await Auth.InitializeAsync();
        await LoadProducts();

        SignalR.OnNotify += HandleSignalRNotify;
        try { await SignalR.StartAsync(); }
        catch (Exception ex) { ShowNotification($"SignalR: {ex.Message}", "warning"); }
    }

    private void HandleSignalRNotify(string entity, string action)
    {
        _ = InvokeAsync(async () =>
        {
            if (entity == "product")
            {
                await LoadProducts();
                StateHasChanged();
            }
        });
    }

    private async Task LoadProducts()
    {
        try
        {
            _loading = true;
            StateHasChanged();

            var url = $"api/Product/paged?page={_currentPage}&pageSize={_pageSize}";
            if (!string.IsNullOrEmpty(_search)) url += $"&search={Uri.EscapeDataString(_search)}";
            if (!string.IsNullOrEmpty(_filter)) url += $"&status={_filter}";

            var response = await Http.GetFromJsonAsync<PagedProductResponse>(url);
            if (response != null)
            {
                Products = response.Items;
                _totalCount = response.TotalCount;
                ApplySorting();
            }
        }
        catch (Exception ex)
        {
            ShowNotification($"Ошибка загрузки товаров: {ex.Message}", "danger");
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private void ApplySorting()
    {
        Products = _sort switch
        {
            "price_asc" => Products.OrderBy(p => p.Price).ToList(),
            "price_desc" => Products.OrderByDescending(p => p.Price).ToList(),
            "name_asc" => Products.OrderBy(p => p.Name).ToList(),
            "name_desc" => Products.OrderByDescending(p => p.Name).ToList(),
            _ => Products
        };
    }

    private async Task OnSearchInput(ChangeEventArgs e)
    {
        _search = e.Value?.ToString() ?? "";
        _currentPage = 0;

        _searchCts?.Cancel();
        _searchCts?.Dispose();
        _searchCts = new CancellationTokenSource();

        try
        {
            await Task.Delay(300, _searchCts.Token);
            await LoadProducts();
        }
        catch (TaskCanceledException) { }
    }

    private async Task OnFilterChanged(ChangeEventArgs e)
    {
        _filter = e.Value?.ToString() ?? "";
        _currentPage = 0;
        await LoadProducts();
    }

    private async Task OnSortChanged(ChangeEventArgs e)
    {
        _sort = e.Value?.ToString() ?? "";
        ApplySorting();
        StateHasChanged();
    }

    private async Task GoToPage(int page)
    {
        if (page < 0 || page >= _totalPages) return;
        _currentPage = page;
        await LoadProducts();
    }

    private void AddToCart(ProductDto product)
    {
        Cart.AddItem(product);
        ShowNotification($"Товар \"{product.Name}\" добавлен в корзину", "success");
    }

    private async Task Logout()
    {
        await Auth.LogoutAsync();
        Nav.NavigateTo("/");
    }

    private void ShowNotification(string message, string type = "success")
    {
        _notification = message;
        _notificationType = type;
        _ = Task.Delay(4000).ContinueWith(_ =>
        {
            _notification = null;
            InvokeAsync(StateHasChanged);
        });
    }

    public void Dispose()
    {
        SignalR.OnNotify -= HandleSignalRNotify;
        Cart.OnCartChanged -= StateHasChanged;
        Auth.OnAuthStateChanged -= StateHasChanged;
        _searchCts?.Cancel();
        _searchCts?.Dispose();
    }

    private class PagedProductResponse
    {
        public List<ProductDto> Items { get; set; } = new();
        public int Page { get; set; }
        public int PageSize { get; set; }
        public int TotalCount { get; set; }
    }
}