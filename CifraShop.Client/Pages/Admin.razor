    private async Task LoadProductImages(int productId)
    {
        try
        {
            _productImages = await Http.GetFromJsonAsync<List<ProductImageDto>>($"api/ProductImage/by-product?productId={productId}") ?? new();
        }
        catch { _productImages = new(); }
    }

    private async Task OnImageUpload(InputFileChangeEventArgs e)
    {
        if (_editingProduct == null) return;
        var file = e.File;
        if (file == null) return;

        using var content = new MultipartFormDataContent();
        var stream = file.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024);
        var fileContent = new StreamContent(stream);
        content.Add(fileContent, "file", file.Name);
        content.Add(new StringContent(_editingProduct.Id.ToString()), "productId");
        content.Add(new StringContent((_productImages.Count == 0).ToString()), "isPrimary");

        var r = await Http.PostAsync("api/ProductImage/upload", content);
        if (r.IsSuccessStatusCode)
        {
            var result = await r.Content.ReadFromJsonAsync<UploadResult>();
            if (result != null)
            {
                _productImages.Add(new ProductImageDto
                {
                    Id = result.Id,
                    Url = result.Url,
                    FileName = result.FileName,
                    IsPrimary = result.IsPrimary,
                    SortOrder = result.SortOrder
                });
                if (result.IsPrimary) _editingProduct.ImageUrl = result.Url;
            }
            ShowNotification("Изображение загружено");
        }
        else ShowNotification($"Ошибка загрузки: {await r.Content.ReadAsStringAsync()}", "danger");
    }

    private async Task SetPrimaryImage(ProductImageDto img)
    {
        var r = await Http.PostAsJsonAsync($"api/ProductImage/set-primary?imageId={img.Id}", new { });
        if (r.IsSuccessStatusCode && _editingProduct != null)
        {
            foreach (var i in _productImages) i.IsPrimary = i.Id == img.Id;
            _editingProduct.ImageUrl = img.Url;
            ShowNotification("Главное изображение изменено");
            StateHasChanged();
        }
    }

    private async Task DeleteProductImage(ProductImageDto img)
    {
        var r = await Http.DeleteAsync($"api/ProductImage?id={img.Id}");
        if (r.IsSuccessStatusCode && _editingProduct != null)
        {
            _productImages.Remove(img);
            if (img.IsPrimary && _productImages.Any())
            {
                var newPrimary = _productImages.First();
                newPrimary.IsPrimary = true;
                _editingProduct.ImageUrl = newPrimary.Url;
            }
            else if (!_productImages.Any())
            {
                _editingProduct.ImageUrl = null;
            }
            ShowNotification("Изображение удалено");
            StateHasChanged();
        }
    }

    private class UploadResult { public int Id { get; set; } public string Url { get; set; } = ""; public string FileName { get; set; } = ""; public bool IsPrimary { get; set; } public int SortOrder { get; set; } }

    private void CloseProductModal() => _showProductModal = false;

    private async Task SaveProduct()
    {
        _saving = true;
        try
        {
            var body = new { Name = _formName, Description = _formDescription, Price = _formPrice, Quantity = _formQuantity };
            if (_editingProduct == null)
            {
                var r = await Http.PostAsJsonAsync("api/Product/create-product", body);
                if (r.IsSuccessStatusCode)
                {
                    var c = await r.Content.ReadFromJsonAsync<ProductDto>();
                    if (c != null) Products.Add(c);
                    await LogAction("Создание", $"Товар «{_formName}»");
                    ShowNotification("Товар создан");
                    CloseProductModal();
                }
                else ShowNotification($"Ошибка: {await r.Content.ReadAsStringAsync()}", "danger");
            }
            else
            {
                var r = await Http.PutAsJsonAsync($"api/Product/update-product?id={_editingProduct.Id}", body);
                if (r.IsSuccessStatusCode)
                {
                    (_editingProduct.Name, _editingProduct.Description, _editingProduct.Price, _editingProduct.Quantity)
                        = (_formName, _formDescription, _formPrice, _formQuantity);
                    _editingProduct.ImageUrl = _formImageUrl;
                    await LogAction("Изменение", $"Товар #{_editingProduct.Id} «{_formName}»");
                    ShowNotification("Товар обновлён");
                    CloseProductModal();
                }
                else ShowNotification($"Ошибка: {await r.Content.ReadAsStringAsync()}", "danger");
            }
        }
        catch (Exception ex) { ShowNotification($"Ошибка: {ex.Message}", "danger"); }
        finally { _saving = false; }
    }

    private async Task OnQuantityChanged(ProductDto product, ChangeEventArgs e)
    {
        var oldQuantity = product.Quantity;
        if (short.TryParse(e.Value?.ToString(), out short q) && product.Quantity != q)
        {
            var r = await Http.PutAsJsonAsync($"api/Product/update-product?id={product.Id}", new { Quantity = q });
            if (r.IsSuccessStatusCode)
            {
                product.Quantity = q;
                await LogAction("Изменение", $"«{product.Name}»: склад = {q}");
                ShowNotification($"«{product.Name}»: количество = {q}");
            }
            else
            {
                product.Quantity = oldQuantity;
                ShowNotification($"Не удалось обновить количество «{product.Name}»", "danger");
            }
        }
    }

    private async Task ToggleProductStatus(ProductDto product)
    {
        var newStatus = product.Status switch
        {
            StatusProduct.InStock => StatusProduct.OutOfStock,
            StatusProduct.OutOfStock => StatusProduct.ComingSoon,
            _ => StatusProduct.InStock
        };
        var r = await Http.PutAsJsonAsync($"api/Product/update-product?id={product.Id}", new { Status = (int)newStatus });
        if (r.IsSuccessStatusCode) { product.Status = newStatus; await LogAction("Изменение", $"«{product.Name}»: {StatusText(newStatus)}"); ShowNotification($"«{product.Name}»: {StatusText(newStatus)}"); }
    }

    private void DeleteProduct(ProductDto product)
    {
        ShowConfirm($"Удалить «{product.Name}»?", async () =>
        {
            var r = await Http.DeleteAsync($"api/Product/delete-product?id={product.Id}");
            if (r.IsSuccessStatusCode) { Products.Remove(product); _productTotalCount--; await LogAction("Удаление", $"Товар «{product.Name}»"); ShowNotification("Товар удалён"); StateHasChanged(); }
        });
    }

    private void DeleteSelectedProducts()
    {
        var sel = Products.Where(p => p.IsSelected).ToList();
        ShowConfirm($"Удалить {sel.Count} товар(ов)?", async () =>
        {
            var ids = sel.Select(p => p.Id).ToList();
            var r = await Http.PostAsJsonAsync("api/Product/batch-delete", new { ProductIds = ids });
            if (r.IsSuccessStatusCode)
            {
                foreach (var p in sel) Products.Remove(p);
                _productTotalCount -= sel.Count;
                await LogAction("Удаление", $"{sel.Count} товар(ов)");
                ShowNotification($"Удалено: {sel.Count} товар(ов)");
                StateHasChanged();
            }
        });
    }

    private async Task ShowSelectedProducts() => await SetSelectedProductStatus(StatusProduct.InStock);
    private async Task HideSelectedProducts() => await SetSelectedProductStatus(StatusProduct.OutOfStock);

    private async Task SetSelectedProductStatus(StatusProduct status)
    {
        var sel = Products.Where(p => p.IsSelected).ToList();
        foreach (var product in sel)
        {
            var r = await Http.PutAsJsonAsync($"api/Product/update-product?id={product.Id}", new { Status = (int)status });
            if (r.IsSuccessStatusCode) product.Status = status;
        }
        await LogAction("Изменение", $"{sel.Count} товар(ов): {StatusText(status)}");
        ShowNotification($"Обновлено: {sel.Count} товар(ов)");
        StateHasChanged();
    }

    private async Task ChangeOrderStatus(OrderDto order, StatusOrder newStatus)
    {
        var r = await Http.PutAsJsonAsync($"api/Order/update-order?id={order.Id}", new { Status = (int)newStatus });
        if (r.IsSuccessStatusCode)
        {
            order.Status = newStatus;
            await LogAction("Изменение", $"Заказ #{order.Id}: статус = {OrderStatuses[((int)newStatus).ToString()]}");
            ShowNotification($"Заказ #{order.Id}: статус изменён");
        }
    }

    private async Task MassChangeOrderStatus(StatusOrder newStatus)
    {
        var sel = Orders.Where(o => o.IsSelected).ToList();
        var ids = sel.Select(o => o.Id).ToList();
        var r = await Http.PostAsJsonAsync("api/Order/batch-update-status", new { OrderIds = ids, NewStatus = (int)newStatus });
        if (r.IsSuccessStatusCode) foreach (var o in sel) o.Status = newStatus;
        await LogAction("Изменение", $"{sel.Count} заказ(ов): {OrderStatuses[((int)newStatus).ToString()]}");
        ShowNotification($"Обновлено: {sel.Count} заказ(ов)");
        StateHasChanged();
    }

