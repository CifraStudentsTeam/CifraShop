@page "/admin"
@using System.Net.Http.Json
@using CifraShop.Client.Models
@implements IDisposable
@inject HttpClient Http

<PageTitle>Админ-панель — CifraShop</PageTitle>

<div class="container-fluid px-3 py-2">

    <!-- ШАПКА -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="fw-bold mb-0"><i class="bi bi-grid-3x3-gap me-2"></i>Админ-панель</h5>
        <span class="text-secondary small">Авто-обновление каждые 30 сек</span>
    </div>

    <!-- УВЕДОМЛЕНИЯ -->
    @if (!string.IsNullOrEmpty(_notification))
    {
        <div class="alert alert-@_notificationType alert-dismissible fade show py-2 small" role="alert">
            <i class="bi bi-@(_notificationType == "success" ? "check-circle-fill" : "exclamation-triangle-fill") me-1"></i>
            @_notification
            <button type="button" class="btn-close btn-close-sm" @onclick="() => _notification = null"></button>
        </div>
    }

    <!-- МЕТРИКИ -->
    <div class="row g-2 mb-3">
        <MetricCard Title="Товаров" Count="@Products.Count" Icon="bi-box" Color="primary" />
        <MetricCard Title="Заказы" Count="@Orders.Count" Icon="bi-cart-check" Color="warning" />
        <MetricCard Title="Пользователи" Count="@Users.Count" Icon="bi-people" Color="success" />
    </div>

    <!-- ==================== ТОВАРЫ ==================== -->
    <div class="row g-3 mb-3">
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-header bg-white border-0 pt-3 px-3 d-flex justify-content-between align-items-center">
                    <h6 class="fw-semibold mb-0">Товары</h6>
                    <button class="btn btn-primary btn-sm" @onclick="() => OpenProductModal()">
                        <i class="bi bi-plus-lg me-1"></i>Добавить
                    </button>
                </div>
                <div class="card-body pt-0">
                    <SearchBar Value="@ProductSearch" ValueChanged="@((string v) => ProductSearch = v)"
                               FilterValue="@ProductFilter" FilterValueChanged="@((string v) => ProductFilter = v)"
                               Placeholder="Название, описание...">
                        <option value="">Все</option>
                        <option value="0">В наличии</option>
                        <option value="1">Нет в наличии</option>
                        <option value="2">Скоро</option>
                    </SearchBar>

                    @if (Products.Any(p => p.IsSelected))
                    {
                        <div class="d-flex gap-2 mb-2 p-2 bg-light rounded">
                            <span class="small text-secondary me-auto align-self-center">Выбрано: @Products.Count(p => p.IsSelected)</span>
                            <button class="btn btn-outline-success btn-sm" @onclick="ShowSelectedProducts">
                                <i class="bi bi-eye me-1"></i>Показать
                            </button>
                            <button class="btn btn-outline-secondary btn-sm" @onclick="HideSelectedProducts">
                                <i class="bi bi-eye-slash me-1"></i>Скрыть
                            </button>
                            <button class="btn btn-outline-danger btn-sm" @onclick="DeleteSelectedProducts">
                                <i class="bi bi-trash me-1"></i>Удалить
                            </button>
                        </div>
                    }

                    @if (_loadingProducts)
                    {
                        <Spinner />
                    }
                    else if (!FilteredProducts.Any())
                    {
                        <EmptyState />
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-sm align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th style="width:36px;">
                                            <input type="checkbox" class="form-check-input"
                                                   checked="@IsAllSelected"
                                                   @onchange="ToggleSelectAll" />
                                        </th>
                                        <th style="cursor:pointer" @onclick='() => ToggleProductSort("name")'>Товар @_productSort.Icon("name")</th>
                                        <th style="width:70px;cursor:pointer" @onclick='() => ToggleProductSort("price")'>Цена @_productSort.Icon("price")</th>
                                        <th style="width:80px;cursor:pointer" @onclick='() => ToggleProductSort("quantity")'>Склад @_productSort.Icon("quantity")</th>
                                        <th style="width:100px;cursor:pointer" @onclick='() => ToggleProductSort("status")'>Статус @_productSort.Icon("status")</th>
                                        <th style="width:70px;"></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var p in PagedProducts)
                                    {
                                        <tr class="@(p.Status != 0 ? "opacity-50" : "")">
                                            <td><input type="checkbox" class="form-check-input" @bind="p.IsSelected" /></td>
                                            <td>
                                                <div class="fw-semibold text-truncate" style="max-width:200px;">@p.Name</div>
                                                @if (!string.IsNullOrEmpty(p.Description))
                                                {
                                                    <small class="text-secondary text-truncate d-block" style="max-width:200px;">@p.Description</small>
                                                }
                                            </td>
                                            <td>@p.Price ₽</td>
                                            <td>
                                                <input type="number" class="form-control form-control-sm"
                                                       style="width:60px;" value="@p.Quantity"
                                                       @onchange="(ChangeEventArgs e) => OnQuantityChanged(p, e)" />
                                            </td>
                                            <td>
                                                <span class="badge @(ProductStatusBadge(p.Status))">@ProductStatusText(p.Status)</span>
                                            </td>
                                            <td class="text-nowrap">
                                                <button class="btn btn-sm btn-outline-primary me-1" title="Редактировать"
                                                        @onclick="() => OpenProductModal(p)">
                                                    <i class="bi bi-pencil"></i>
                                                </button>
                                                <button class="btn btn-sm btn-outline-danger" title="Удалить"
                                                        @onclick="() => DeleteProduct(p)">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mt-2">
                            <small class="text-secondary">@(FilteredProducts.Count()) товар(ов)</small>
                            @RenderPagination(ProductPage, TotalProductPages, p => ProductPage = p)
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- ==================== ЗАКАЗЫ ==================== -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-header bg-white border-0 pt-3 px-3">
                    <h6 class="fw-semibold mb-0">Заказы</h6>
                </div>
                <div class="card-body pt-0">
                    <SearchBar Value="@OrderSearch" ValueChanged="@((string v) => OrderSearch = v)"
                               FilterValue="@OrderStatusFilter" FilterValueChanged="@((string v) => OrderStatusFilter = v)"
                               Placeholder="Номер, email...">
                        <option value="">Все</option>
                        <option value="0">Ожидание</option>
                        <option value="1">Ожидает оплаты</option>
                        <option value="2">Оплачен</option>
                        <option value="3">В производстве</option>
                        <option value="4">Выполнен</option>
                    </SearchBar>

                    @if (_loadingOrders)
                    {
                        <Spinner />
                    }
                    else if (!FilteredOrders.Any())
                    {
                        <EmptyState />
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-sm align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th style="cursor:pointer" @onclick='() => ToggleOrderSort("id")'>№ @_orderSort.Icon("id")</th>
                                        <th style="cursor:pointer" @onclick='() => ToggleOrderSort("customer")'>Покупатель @_orderSort.Icon("customer")</th>
                                        <th>Состав</th>
                                        <th>Дата</th>
                                        <th style="cursor:pointer" @onclick='() => ToggleOrderSort("sum")'>Сумма @_orderSort.Icon("sum")</th>
                                        <th style="cursor:pointer" @onclick='() => ToggleOrderSort("status")'>Статус @_orderSort.Icon("status")</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var o in PagedOrders)
                                    {
                                        var items = string.Join(", ", o.Items.Select(i => $"{i.Quantity}\u00d7{i.ProductName}"));
                                        <tr>
                                            <td class="fw-semibold">#@o.Id</td>
                                            <td class="text-truncate" style="max-width:120px;">@o.CustomerLogin</td>
                                            <td><small class="text-truncate d-block" style="max-width:150px;">@items</small></td>
                                            <td><small>@o.DateOfPurchase.ToString("dd.MM.yy")</small></td>
                                            <td>@o.Sum ₽</td>
                                            <td>
                                                <select class="form-select form-select-sm py-0"
                                                        value="@o.Status"
                                                        @onchange="e => ChangeOrderStatus(o, int.Parse(e.Value!.ToString()!))">
                                                    <option value="0">Ожидание</option>
                                                    <option value="1">Ожидает оплаты</option>
                                                    <option value="2">Оплачен</option>
                                                    <option value="3">В производстве</option>
                                                    <option value="4">Выполнен</option>
                                                </select>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mt-2">
                            <small class="text-secondary">@(FilteredOrders.Count()) заказ(ов)</small>
                            @RenderPagination(OrderPage, TotalOrderPages, p => OrderPage = p)
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- ==================== ПОЛЬЗОВАТЕЛИ ==================== -->
    <div class="row g-3">
        <div class="col-12">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-header bg-white border-0 pt-3 px-3">
                    <h6 class="fw-semibold mb-0">Пользователи</h6>
                </div>
                <div class="card-body pt-0">
                    <SearchBar Value="@UserSearch" ValueChanged="@((string v) => UserSearch = v)"
                               FilterValue="@UserRoleFilter" FilterValueChanged="@((string v) => UserRoleFilter = v)"
                               Placeholder="Email...">
                        <option value="">Все</option>
                        <option value="0">Студенты</option>
                        <option value="1">Админы</option>
                    </SearchBar>

                    @if (_loadingUsers)
                    {
                        <Spinner />
                    }
                    else if (!FilteredUsers.Any())
                    {
                        <EmptyState />
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-sm align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th style="cursor:pointer" @onclick='() => ToggleUserSort("email")'>Email @_userSort.Icon("email")</th>
                                        <th style="cursor:pointer" @onclick='() => ToggleUserSort("balance")'>Баланс @_userSort.Icon("balance")</th>
                                        <th style="cursor:pointer" @onclick='() => ToggleUserSort("role")'>Роль @_userSort.Icon("role")</th>
                                        <th style="width:50px;"></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var u in PagedUsers)
                                    {
                                        <tr>
                                            <td class="text-truncate" style="max-width:250px;">@u.Email</td>
                                            <td>@(u.Balance?.ToString() ?? "—")</td>
                                            <td>
                                                <span class="badge @(u.Role == 1 ? "bg-warning text-dark" : "bg-info")">
                                                    @(u.Role == 1 ? "Админ" : "Студент")
                                                </span>
                                            </td>
                                            <td>
                                                <button class="btn btn-sm btn-outline-danger" title="Удалить"
                                                        @onclick="() => DeleteUser(u)">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mt-2">
                            <small class="text-secondary">@(FilteredUsers.Count()) пользовател(ей)</small>
                            @RenderPagination(UserPage, TotalUserPages, p => UserPage = p)
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- ==================== МОДАЛКА ТОВАРА ==================== -->
    @if (_showProductModal)
    {
        <div class="modal fade show d-block" tabindex="-1"
             style="background-color: rgba(0,0,0,0.5);"
             @onclick="CloseProductModal">
            <div class="modal-dialog modal-dialog-centered"
                 @onclick:stopPropagation="true">
                <div class="modal-content rounded-3 shadow">
                    <div class="modal-header border-0 pb-0">
                        <h6 class="modal-title fw-semibold">
                            <i class="bi bi-@(_editingProduct == null ? "plus-circle" : "pencil-square") me-1"></i>
                            @(_editingProduct == null ? "Новый товар" : "Редактирование товара")
                        </h6>
                        <button type="button" class="btn-close" @onclick="CloseProductModal"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label small fw-medium">Название <span class="text-danger">*</span></label>
                            <input type="text" class="form-control @(_formName.Length > 0 ? "is-valid" : "")"
                                   @bind="_formName" placeholder="Введите название" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-medium">Описание</label>
                            <textarea class="form-control" rows="2" @bind="_formDescription"
                                      placeholder="Краткое описание товара"></textarea>
                        </div>
                        <div class="row g-3">
                            <div class="col-6">
                                <label class="form-label small fw-medium">Цена (₽)</label>
                                <input type="number" class="form-control" @bind="_formPrice" min="0" />
                            </div>
                            <div class="col-6">
                                <label class="form-label small fw-medium">Количество</label>
                                <input type="number" class="form-control" @bind="_formQuantity" min="0" />
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer border-0 pt-0">
                        <button type="button" class="btn btn-secondary btn-sm" @onclick="CloseProductModal">Отмена</button>
                        <button type="button" class="btn btn-primary btn-sm"
                                disabled="@(_formName.Length == 0)"
                                @onclick="SaveProduct">
                            <i class="bi bi-check-lg me-1"></i>Сохранить
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- МОДАЛКА ПОДТВЕРЖДЕНИЯ -->
    @if (_showConfirmModal)
    {
        <div class="modal fade show d-block" tabindex="-1"
             style="background-color: rgba(0,0,0,0.5);"
             @onclick="CancelConfirm">
            <div class="modal-dialog modal-sm modal-dialog-centered"
                 @onclick:stopPropagation="true">
                <div class="modal-content rounded-3 shadow">
                    <div class="modal-body text-center py-4">
                        <i class="bi bi-exclamation-triangle text-warning fs-1 mb-2 d-block"></i>
                        <p class="mb-3 fw-medium">@_confirmMessage</p>
                        <div class="d-flex gap-2 justify-content-center">
                            <button class="btn btn-secondary btn-sm px-3" @onclick="CancelConfirm">Отмена</button>
                            <button class="btn btn-danger btn-sm px-3" @onclick="ExecuteConfirm">Удалить</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    // ==================== ДАННЫЕ ====================
    private List<ProductDto> Products = new();
    private List<OrderDto> Orders = new();
    private List<UserDto> Users = new();

    private string? _notification;
    private string _notificationType = "success";
    private bool _loadingProducts = true;
    private bool _loadingOrders = true;
    private bool _loadingUsers = true;

    private PeriodicTimer? _refreshTimer;

    // ==================== ПОИСК / ФИЛЬТР ====================
    private string _search_products = "";
    private string _filter_products = "";
    private string _search_orders = "";
    private string _filter_orders = "";
    private string _search_users = "";
    private string _filter_users = "";

    private string ProductSearch { get => _search_products; set { _search_products = value; ProductPage = 0; } }
    private string ProductFilter { get => _filter_products; set { _filter_products = value; ProductPage = 0; } }
    private string OrderSearch { get => _search_orders; set { _search_orders = value; OrderPage = 0; } }
    private string OrderStatusFilter { get => _filter_orders; set { _filter_orders = value; OrderPage = 0; } }
    private string UserSearch { get => _search_users; set { _search_users = value; UserPage = 0; } }
    private string UserRoleFilter { get => _filter_users; set { _filter_users = value; UserPage = 0; } }

    // ==================== ПАГИНАЦИЯ ====================
    private const int PageSize = 8;
    private int ProductPage, OrderPage, UserPage;

    // ==================== СОРТИРОВКА ====================
    private SortState _productSort = new();
    private SortState _orderSort = new();
    private SortState _userSort = new();

    private void ToggleProductSort(string col) { _productSort.Toggle(col); ProductPage = 0; }
    private void ToggleOrderSort(string col) { _orderSort.Toggle(col); OrderPage = 0; }
    private void ToggleUserSort(string col) { _userSort.Toggle(col); UserPage = 0; }

    // ==================== ФИЛЬТРЫ ====================
    private IEnumerable<ProductDto> FilteredProducts =>
        Products
            .Where(p => string.IsNullOrEmpty(_search_products) ||
                (p.Name ?? "").Contains(_search_products, StringComparison.OrdinalIgnoreCase) ||
                (p.Description ?? "").Contains(_search_products, StringComparison.OrdinalIgnoreCase))
            .Where(p => string.IsNullOrEmpty(_filter_products) || p.Status.ToString() == _filter_products);

    private IEnumerable<OrderDto> FilteredOrders =>
        Orders
            .Where(o => string.IsNullOrEmpty(_search_orders) ||
                o.Id.ToString().Contains(_search_orders) ||
                (o.CustomerLogin ?? "").Contains(_search_orders, StringComparison.OrdinalIgnoreCase))
            .Where(o => string.IsNullOrEmpty(_filter_orders) || o.Status.ToString() == _filter_orders);

    private IEnumerable<UserDto> FilteredUsers =>
        Users
            .Where(u => string.IsNullOrEmpty(_search_users) ||
                (u.Email ?? "").Contains(_search_users, StringComparison.OrdinalIgnoreCase))
            .Where(u => string.IsNullOrEmpty(_filter_users) || u.Role.ToString() == _filter_users);

    // ==================== СОРТИРОВАННАЯ + ПАГИНИРОВАННАЯ ВЫБОРКА ====================
    private IEnumerable<ProductDto> SortedProducts => SortCollection(FilteredProducts, _productSort,
        ("name", p => p.Name), ("price", p => p.Price), ("quantity", p => p.Quantity), ("status", p => p.Status));
    private IEnumerable<OrderDto> SortedOrders => SortCollection(FilteredOrders, _orderSort,
        ("id", o => o.Id), ("customer", o => o.CustomerLogin), ("sum", o => o.Sum), ("status", o => o.Status));
    private IEnumerable<UserDto> SortedUsers => SortCollection(FilteredUsers, _userSort,
        ("email", u => u.Email), ("balance", u => u.Balance), ("role", u => u.Role));

    private static IEnumerable<T> SortCollection<T>(IEnumerable<T> source, SortState sort,
        params (string col, Func<T, IComparable> key)[] keys)
    {
        var map = keys.ToDictionary(k => k.col, k => k.key);
        return sort.Column != null && map.TryGetValue(sort.Column, out var key)
            ? (sort.Asc ? source.OrderBy(key) : source.OrderByDescending(key))
            : source;
    }

    private IEnumerable<ProductDto> PagedProducts => SortedProducts.Skip(ProductPage * PageSize).Take(PageSize);
    private IEnumerable<OrderDto> PagedOrders => SortedOrders.Skip(OrderPage * PageSize).Take(PageSize);
    private IEnumerable<UserDto> PagedUsers => SortedUsers.Skip(UserPage * PageSize).Take(PageSize);

    private int TotalProductPages => Math.Max(1, (int)Math.Ceiling(FilteredProducts.Count() / (double)PageSize));
    private int TotalOrderPages => Math.Max(1, (int)Math.Ceiling(FilteredOrders.Count() / (double)PageSize));
    private int TotalUserPages => Math.Max(1, (int)Math.Ceiling(FilteredUsers.Count() / (double)PageSize));

    // ==================== ЧЕКБОКС ====================
    private bool IsAllSelected => PagedProducts.Any() && PagedProducts.All(p => p.IsSelected);

    // ==================== МОДАЛКА ТОВАРА ====================
    private bool _showProductModal;
    private ProductDto? _editingProduct;
    private string _formName = "";
    private string _formDescription = "";
    private short _formPrice;
    private short _formQuantity;

    // ==================== ПОДТВЕРЖДЕНИЕ ====================
    private bool _showConfirmModal;
    private string _confirmMessage = "";
    private Func<Task>? _onConfirmAction;

    // ==================== ЖИЗНЕННЫЙ ЦИКЛ ====================
    protected override async Task OnInitializedAsync()
    {
        await LoadAllData();
        _refreshTimer = new PeriodicTimer(TimeSpan.FromSeconds(30));
        _ = RefreshLoop();
    }

    private async Task RefreshLoop()
    {
        while (_refreshTimer is not null && await _refreshTimer.WaitForNextTickAsync())
        {
            await LoadAllData();
            await InvokeAsync(StateHasChanged);
        }
    }

    public void Dispose() => _refreshTimer?.Dispose();

    // ==================== ЗАГРУЗКА ====================
    private async Task LoadAllData()
    {
        var productsTask = LoadSection<List<ProductDto>>("api/Product/all", r => Products = r ?? new(), () => _loadingProducts = false);
        var ordersTask = LoadSection<List<OrderDto>>("api/Order/all", r => Orders = r ?? new(), () => _loadingOrders = false);
        var usersTask = LoadSection<List<UserDto>>("api/User/all", r => Users = r ?? new(), () => _loadingUsers = false);
        await Task.WhenAll(productsTask, ordersTask, usersTask);
    }

    private async Task LoadSection<T>(string url, Action<T?> setter, Action onFinally)
    {
        try { setter(await Http.GetFromJsonAsync<T>(url)); }
        catch (Exception ex) { ShowNotification($"Ошибка загрузки: {ex.Message}", "danger"); }
        finally { onFinally(); }
    }

    // ==================== УВЕДОМЛЕНИЯ ====================
    private void ShowNotification(string message, string type = "success")
    {
        _notification = message;
        _notificationType = type;
        _ = Task.Delay(4000).ContinueWith(_ =>
        {
            if (_notification == message) _notification = null;
            InvokeAsync(StateHasChanged);
        });
    }

    // ==================== ПОДТВЕРЖДЕНИЕ ====================
    private void ShowConfirm(string message, Func<Task> action)
    {
        _confirmMessage = message;
        _onConfirmAction = action;
        _showConfirmModal = true;
    }

    private void CancelConfirm() { _showConfirmModal = false; _onConfirmAction = null; }

    private async Task ExecuteConfirm()
    {
        _showConfirmModal = false;
        if (_onConfirmAction is not null) await _onConfirmAction();
        _onConfirmAction = null;
    }

    // ==================== МАССОВЫЕ ДЕЙСТВИЯ ====================
    private void ToggleSelectAll(ChangeEventArgs e)
    {
        var val = (bool)e.Value!;
        foreach (var p in PagedProducts) p.IsSelected = val;
    }

    private void DeleteSelectedProducts()
    {
        var selected = Products.Where(p => p.IsSelected).ToList();
        ShowConfirm($"Удалить {selected.Count} товар(ов)?", async () =>
        {
            foreach (var p in selected)
            {
                var r = await Http.DeleteAsync($"api/Product/delete-product?id={p.Id}");
                if (r.IsSuccessStatusCode) Products.Remove(p);
            }
            ShowNotification($"Удалено: {selected.Count} товар(ов)");
            StateHasChanged();
        });
    }

    private async Task ShowSelectedProducts() => await SetSelectedStatus(0);
    private async Task HideSelectedProducts() => await SetSelectedStatus(1);

    private async Task SetSelectedStatus(int status)
    {
        var selected = Products.Where(p => p.IsSelected).ToList();
        foreach (var p in selected)
        {
            var r = await Http.PutAsJsonAsync($"api/Product/update-product?id={p.Id}", new { Status = status });
            if (r.IsSuccessStatusCode) p.Status = status;
        }
        ShowNotification($"Обновлено: {selected.Count} товар(ов)");
        StateHasChanged();
    }

    // ==================== ТОВАРЫ ====================
    private void OpenProductModal(ProductDto? product = null)
    {
        _editingProduct = product;
        _formName = product?.Name ?? "";
        _formDescription = product?.Description ?? "";
        _formPrice = product?.Price ?? 0;
        _formQuantity = product?.Quantity ?? 0;
        _showProductModal = true;
    }

    private void CloseProductModal() => _showProductModal = false;

    private async Task SaveProduct()
    {
        try
        {
            var body = new { Name = _formName, Description = _formDescription, Price = _formPrice, Quantity = _formQuantity };

            if (_editingProduct == null)
            {
                var r = await Http.PostAsJsonAsync("api/Product/create-product", body);
                if (r.IsSuccessStatusCode)
                {
                    var c = await r.Content.ReadFromJsonAsync<ProductDto>();
                    if (c != null) Products.Add(c);
                    ShowNotification("Товар создан");
                }
                else ShowNotification($"Ошибка: {await r.Content.ReadAsStringAsync()}", "danger");
            }
            else
            {
                var r = await Http.PutAsJsonAsync($"api/Product/update-product?id={_editingProduct.Id}", body);
                if (r.IsSuccessStatusCode)
                {
                    (_editingProduct.Name, _editingProduct.Description, _editingProduct.Price, _editingProduct.Quantity)
                        = (_formName, _formDescription, _formPrice, _formQuantity);
                    ShowNotification("Товар обновлён");
                }
                else ShowNotification($"Ошибка: {await r.Content.ReadAsStringAsync()}", "danger");
            }
            CloseProductModal();
        }
        catch (Exception ex) { ShowNotification($"Ошибка: {ex.Message}", "danger"); }
    }

    private async Task OnQuantityChanged(ProductDto product, ChangeEventArgs e)
    {
        if (short.TryParse(e.Value?.ToString(), out short q) && product.Quantity != q)
        {
            var r = await Http.PutAsJsonAsync($"api/Product/update-product?id={product.Id}", new { Quantity = q });
            if (r.IsSuccessStatusCode)
            {
                product.Quantity = q;
                ShowNotification($"«{product.Name}»: количество = {q}");
            }
        }
    }

    private void DeleteProduct(ProductDto product)
    {
        ShowConfirm($"Удалить «{product.Name}»?", async () =>
        {
            var r = await Http.DeleteAsync($"api/Product/delete-product?id={product.Id}");
            if (r.IsSuccessStatusCode) { Products.Remove(product); ShowNotification("Товар удалён"); StateHasChanged(); }
        });
    }

    // ==================== ЗАКАЗЫ ====================
    private async Task ChangeOrderStatus(OrderDto order, int newStatus)
    {
        var r = await Http.PutAsJsonAsync($"api/Order/update-order?id={order.Id}", new { Status = newStatus });
        if (r.IsSuccessStatusCode) { order.Status = newStatus; ShowNotification($"Заказ #{order.Id}: статус изменён"); }
    }

    // ==================== ПОЛЬЗОВАТЕЛИ ====================
    private void DeleteUser(UserDto user)
    {
        ShowConfirm($"Удалить «{user.Email}»?", async () =>
        {
            var r = await Http.DeleteAsync($"api/User?id={user.Id}");
            if (r.IsSuccessStatusCode) { Users.Remove(user); ShowNotification($"Пользователь «{user.Email}» удалён"); StateHasChanged(); }
        });
    }

    // ==================== ХЕЛПЕРЫ ====================
    private static string ProductStatusBadge(int s) => s switch { 0 => "bg-success", 1 => "bg-secondary", _ => "bg-info" };
    private static string ProductStatusText(int s) => s switch { 0 => "В наличии", 1 => "Нет", _ => "Скоро" };

    private static RenderFragment RenderPagination(int page, int totalPages, Action<int> setPage) => __builder =>
    {
        if (totalPages <= 1) return;

        __builder.OpenElement(0, "ul");
        __builder.AddAttribute(1, "class", "pagination pagination-sm mb-0");

        // Prev
        __builder.OpenElement(2, "li");
        __builder.AddAttribute(3, "class", $"page-item {(page == 0 ? "disabled" : "")}");
        __builder.OpenElement(4, "button");
        __builder.AddAttribute(5, "class", "page-link");
        __builder.AddAttribute(6, "disabled", page == 0);
        __builder.AddAttribute(7, "onclick", EventCallback.Factory.Create(__builder, () => setPage(page - 1)));
        __builder.OpenElement(8, "i");
        __builder.AddAttribute(9, "class", "bi bi-chevron-left");
        __builder.CloseElement();
        __builder.CloseElement();
        __builder.CloseElement();

        for (int i = 0; i < totalPages; i++)
        {
            var idx = i;
            __builder.OpenElement(10, "li");
            __builder.AddAttribute(11, "class", $"page-item {(idx == page ? "active" : "")}");
            __builder.OpenElement(12, "button");
            __builder.AddAttribute(13, "class", "page-link");
            __builder.AddAttribute(14, "onclick", EventCallback.Factory.Create(__builder, () => setPage(idx)));
            __builder.AddContent(15, idx + 1);
            __builder.CloseElement();
            __builder.CloseElement();
        }

        // Next
        __builder.OpenElement(20, "li");
        __builder.AddAttribute(21, "class", $"page-item {(page >= totalPages - 1 ? "disabled" : "")}");
        __builder.OpenElement(22, "button");
        __builder.AddAttribute(23, "class", "page-link");
        __builder.AddAttribute(24, "disabled", page >= totalPages - 1);
        __builder.AddAttribute(25, "onclick", EventCallback.Factory.Create(__builder, () => setPage(page + 1)));
        __builder.OpenElement(26, "i");
        __builder.AddAttribute(27, "class", "bi bi-chevron-right");
        __builder.CloseElement();
        __builder.CloseElement();
        __builder.CloseElement();

        __builder.CloseElement();
    };

    // ==================== КЛАСС СОРТИРОВКИ ====================
    private class SortState
    {
        public string? Column { get; private set; }
        public bool Asc { get; private set; } = true;

        public void Toggle(string column)
        {
            if (Column == column) Asc = !Asc;
            else { Column = column; Asc = true; }
        }

        public string Icon(string column) => Column != column ? "" : Asc ? " \u25b2" : " \u25bc";
    }
}
