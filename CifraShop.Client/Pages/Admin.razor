@page "/admin"
@using System.Net.Http.Json
@using CifraShop.Client.Models
@implements IDisposable
@inject HttpClient Http

<PageTitle>Админ-панель — CifraShop</PageTitle>

<div class="container-fluid px-3 py-2">

    <!-- ШАПКА -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="fw-bold mb-0"><i class="bi bi-grid-3x3-gap me-2"></i>Админ-панель</h5>
        <span class="text-secondary small">Авто-обновление каждые 30 сек</span>
    </div>

    <!-- УВЕДОМЛЕНИЯ -->
    @if (!string.IsNullOrEmpty(_notification))
    {
        <div class="alert alert-@_notificationType alert-dismissible fade show py-2 small" role="alert">
            <i class="bi bi-@(_notificationType == "success" ? "check-circle-fill" : "exclamation-triangle-fill") me-1"></i>
            @_notification
            <button type="button" class="btn-close btn-close-sm" @onclick="() => _notification = null"></button>
        </div>
    }

    <!-- МЕТРИКИ -->
    <div class="row g-2 mb-3">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-3 h-100">
                <div class="card-body py-3 px-3 d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-secondary small">Товаров</div>
                        <div class="fs-3 fw-bold mb-0">@Products.Count</div>
                    </div>
                    <div class="bg-primary bg-opacity-10 rounded-3 p-2">
                        <i class="bi bi-box text-primary fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-3 h-100">
                <div class="card-body py-3 px-3 d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-secondary small">Заказы</div>
                        <div class="fs-3 fw-bold mb-0">@Orders.Count</div>
                    </div>
                    <div class="bg-warning bg-opacity-10 rounded-3 p-2">
                        <i class="bi bi-cart-check text-warning fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-3 h-100">
                <div class="card-body py-3 px-3 d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-secondary small">Пользователи</div>
                        <div class="fs-3 fw-bold mb-0">@Users.Count</div>
                    </div>
                    <div class="bg-success bg-opacity-10 rounded-3 p-2">
                        <i class="bi bi-people text-success fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ==================== ТОВАРЫ ==================== -->
    <div class="row g-3 mb-3">
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-header bg-white border-0 pt-3 px-3 d-flex justify-content-between align-items-center">
                    <h6 class="fw-semibold mb-0">Товары</h6>
                    <button class="btn btn-primary btn-sm" @onclick="() => OpenProductModal()">
                        <i class="bi bi-plus-lg me-1"></i>Добавить
                    </button>
                </div>
                <div class="card-body pt-0">
                    <!-- Поиск + фильтр -->
                    <div class="d-flex gap-2 mb-2">
                        <div class="input-group input-group-sm">
                            <span class="input-group-text bg-light border-0"><i class="bi bi-search text-secondary"></i></span>
                            <input type="text" class="form-control bg-light border-0"
                                   placeholder="Название, описание..."
                                   @bind="ProductSearch" @bind:event="oninput" />
                        </div>
                        <select class="form-select form-select-sm" style="width:auto;" @bind="ProductFilter">
                            <option value="">Все</option>
                            <option value="0">В наличии</option>
                            <option value="1">Нет в наличии</option>
                            <option value="2">Скоро</option>
                        </select>
                    </div>
                    <!-- Массовые действия -->
                    @if (Products.Any(p => p.IsSelected))
                    {
                        <div class="d-flex gap-2 mb-2 p-2 bg-light rounded">
                            <span class="small text-secondary me-auto align-self-center">Выбрано: @Products.Count(p => p.IsSelected)</span>
                            <button class="btn btn-outline-success btn-sm" @onclick="ShowSelectedProducts">
                                <i class="bi bi-eye me-1"></i>Показать
                            </button>
                            <button class="btn btn-outline-secondary btn-sm" @onclick="HideSelectedProducts">
                                <i class="bi bi-eye-slash me-1"></i>Скрыть
                            </button>
                            <button class="btn btn-outline-danger btn-sm" @onclick="DeleteSelectedProducts">
                                <i class="bi bi-trash me-1"></i>Удалить
                            </button>
                        </div>
                    }
                    @if (_loading)
                    {
                        <div class="text-center py-4 text-secondary"><div class="spinner-border spinner-border-sm me-1"></div>Загрузка...</div>
                    }
                    else if (!FilteredProducts.Any())
                    {
                        <div class="text-center py-4 text-secondary small">Ничего не найдено</div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-sm align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th style="width:36px;">
                                            <input type="checkbox" class="form-check-input"
                                                   checked="@IsAllSelected"
                                                   @onchange="ToggleSelectAll" />
                                        </th>
                                        <th style="cursor:pointer" @onclick='() => ToggleProductSort("name")'>Товар @SortIcon("name", _productSortColumn, _productSortAsc)</th>
                                        <th style="width:70px;cursor:pointer" @onclick='() => ToggleProductSort("price")'>Цена @SortIcon("price", _productSortColumn, _productSortAsc)</th>
                                        <th style="width:80px;cursor:pointer" @onclick='() => ToggleProductSort("quantity")'>Склад @SortIcon("quantity", _productSortColumn, _productSortAsc)</th>
                                        <th style="width:100px;cursor:pointer" @onclick='() => ToggleProductSort("status")'>Статус @SortIcon("status", _productSortColumn, _productSortAsc)</th>
                                        <th style="width:70px;"></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var p in PagedProducts)
                                    {
                                        <tr class="@(p.Status != 0 ? "opacity-50" : "")">
                                            <td><input type="checkbox" class="form-check-input" @bind="p.IsSelected" /></td>
                                            <td>
                                                <div class="fw-semibold text-truncate" style="max-width:200px;">@p.Name</div>
                                                @if (!string.IsNullOrEmpty(p.Description))
                                                {
                                                    <small class="text-secondary text-truncate d-block" style="max-width:200px;">@p.Description</small>
                                                }
                                            </td>
                                            <td>@p.Price ₽</td>
                                            <td>
                                                <input type="number" class="form-control form-control-sm"
                                                       style="width:60px;" value="@p.Quantity"
                                                       @onchange="(ChangeEventArgs e) => OnQuantityChanged(p, e)" />
                                            </td>
                                            <td>
                                                <span class="badge @(p.Status switch { 0 => "bg-success", 1 => "bg-secondary", _ => "bg-info" })">
                                                    @(p.Status switch { 0 => "В наличии", 1 => "Нет", _ => "Скоро" })
                                                </span>
                                            </td>
                                            <td class="text-nowrap">
                                                <button class="btn btn-sm btn-outline-primary me-1" title="Редактировать"
                                                        @onclick="() => OpenProductModal(p)">
                                                    <i class="bi bi-pencil"></i>
                                                </button>
                                                <button class="btn btn-sm btn-outline-danger" title="Удалить"
                                                        @onclick="() => DeleteProduct(p)">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <!-- Информация + пагинация -->
                        <div class="d-flex justify-content-between align-items-center mt-2">
                            <small class="text-secondary">
                                @(FilteredProducts.Count()) товар(ов)
                            </small>
                            @if (TotalProductPages > 1)
                            {
                                <ul class="pagination pagination-sm mb-0">
                                    <li class="page-item @(ProductPage == 0 ? "disabled" : "")">
                                        <button class="page-link" @onclick="() => ProductPage--" disabled="@(ProductPage == 0)">
                                            <i class="bi bi-chevron-left"></i>
                                        </button>
                                    </li>
                                    @for (int i = 0; i < TotalProductPages; i++)
                                    {
                                        var idx = i;
                                        <li class="page-item @(idx == ProductPage ? "active" : "")">
                                            <button class="page-link" @onclick="() => ProductPage = idx">@(idx + 1)</button>
                                        </li>
                                    }
                                    <li class="page-item @(ProductPage >= TotalProductPages - 1 ? "disabled" : "")">
                                        <button class="page-link" @onclick="() => ProductPage++" disabled="@(ProductPage >= TotalProductPages - 1)">
                                            <i class="bi bi-chevron-right"></i>
                                        </button>
                                    </li>
                                </ul>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- ==================== ЗАКАЗЫ ==================== -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-header bg-white border-0 pt-3 px-3">
                    <h6 class="fw-semibold mb-0">Заказы</h6>
                </div>
                <div class="card-body pt-0">
                    <div class="d-flex gap-2 mb-2">
                        <div class="input-group input-group-sm">
                            <span class="input-group-text bg-light border-0"><i class="bi bi-search text-secondary"></i></span>
                            <input type="text" class="form-control bg-light border-0"
                                   placeholder="Номер, email..."
                                   @bind="OrderSearch" @bind:event="oninput" />
                        </div>
                        <select class="form-select form-select-sm" style="width:auto;" @bind="OrderStatusFilter">
                            <option value="">Все</option>
                            <option value="0">Ожидание</option>
                            <option value="1">Ожидает оплаты</option>
                            <option value="2">Оплачен</option>
                            <option value="3">В производстве</option>
                            <option value="4">Выполнен</option>
                        </select>
                    </div>
                    @if (_loading)
                    {
                        <div class="text-center py-4 text-secondary"><div class="spinner-border spinner-border-sm me-1"></div>Загрузка...</div>
                    }
                    else if (!FilteredOrders.Any())
                    {
                        <div class="text-center py-4 text-secondary small">Ничего не найдено</div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-sm align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th style="cursor:pointer" @onclick='() => ToggleOrderSort("id")'>№ @SortIcon("id", _orderSortColumn, _orderSortAsc)</th>
                                        <th style="cursor:pointer" @onclick='() => ToggleOrderSort("customer")'>Покупатель @SortIcon("customer", _orderSortColumn, _orderSortAsc)</th>
                                        <th>Состав</th>
                                        <th style="cursor:pointer" @onclick='() => ToggleOrderSort("sum")'>Сумма @SortIcon("sum", _orderSortColumn, _orderSortAsc)</th>
                                        <th style="cursor:pointer" @onclick='() => ToggleOrderSort("status")'>Статус @SortIcon("status", _orderSortColumn, _orderSortAsc)</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var o in PagedOrders)
                                    {
                                        var items = string.Join(", ",
                                            o.Items.Select(i => $"{i.Quantity}×{i.ProductName}"));
                                        <tr>
                                            <td class="fw-semibold">#@o.Id</td>
                                            <td class="text-truncate" style="max-width:120px;">@o.CustomerLogin</td>
                                            <td><small class="text-truncate d-block" style="max-width:150px;">@items</small></td>
                                            <td>@o.Sum ₽</td>
                                            <td>
                                                <select class="form-select form-select-sm py-0"
                                                        value="@o.Status"
                                                        @onchange="e => ChangeOrderStatus(o, int.Parse(e.Value!.ToString()!))">
                                                    <option value="0">Ожидание</option>
                                                    <option value="1">Ожидает оплаты</option>
                                                    <option value="2">Оплачен</option>
                                                    <option value="3">В производстве</option>
                                                    <option value="4">Выполнен</option>
                                                </select>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mt-2">
                            <small class="text-secondary">@(FilteredOrders.Count()) заказ(ов)</small>
                            @if (TotalOrderPages > 1)
                            {
                                <ul class="pagination pagination-sm mb-0">
                                    <li class="page-item @(OrderPage == 0 ? "disabled" : "")">
                                        <button class="page-link" @onclick="() => OrderPage--" disabled="@(OrderPage == 0)">
                                            <i class="bi bi-chevron-left"></i>
                                        </button>
                                    </li>
                                    @for (int i = 0; i < TotalOrderPages; i++)
                                    {
                                        var idx = i;
                                        <li class="page-item @(idx == OrderPage ? "active" : "")">
                                            <button class="page-link" @onclick="() => OrderPage = idx">@(idx + 1)</button>
                                        </li>
                                    }
                                    <li class="page-item @(OrderPage >= TotalOrderPages - 1 ? "disabled" : "")">
                                        <button class="page-link" @onclick="() => OrderPage++" disabled="@(OrderPage >= TotalOrderPages - 1)">
                                            <i class="bi bi-chevron-right"></i>
                                        </button>
                                    </li>
                                </ul>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- ==================== ПОЛЬЗОВАТЕЛИ ==================== -->
    <div class="row g-3">
        <div class="col-12">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-header bg-white border-0 pt-3 px-3">
                    <h6 class="fw-semibold mb-0">Пользователи</h6>
                </div>
                <div class="card-body pt-0">
                    <div class="d-flex gap-2 mb-2">
                        <div class="input-group input-group-sm">
                            <span class="input-group-text bg-light border-0"><i class="bi bi-search text-secondary"></i></span>
                            <input type="text" class="form-control bg-light border-0"
                                   placeholder="Email..."
                                   @bind="UserSearch" @bind:event="oninput" />
                        </div>
                        <select class="form-select form-select-sm" style="width:auto;" @bind="UserRoleFilter">
                            <option value="">Все</option>
                            <option value="0">Студенты</option>
                            <option value="1">Админы</option>
                        </select>
                    </div>
                    @if (_loading)
                    {
                        <div class="text-center py-4 text-secondary"><div class="spinner-border spinner-border-sm me-1"></div>Загрузка...</div>
                    }
                    else if (!FilteredUsers.Any())
                    {
                        <div class="text-center py-4 text-secondary small">Ничего не найдено</div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-sm align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th style="cursor:pointer" @onclick='() => ToggleUserSort("email")'>Email @SortIcon("email", _userSortColumn, _userSortAsc)</th>
                                        <th style="cursor:pointer" @onclick='() => ToggleUserSort("balance")'>Баланс @SortIcon("balance", _userSortColumn, _userSortAsc)</th>
                                        <th style="cursor:pointer" @onclick='() => ToggleUserSort("role")'>Роль @SortIcon("role", _userSortColumn, _userSortAsc)</th>
                                        <th style="width:50px;"></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var u in PagedUsers)
                                    {
                                        <tr>
                                            <td class="text-truncate" style="max-width:250px;">@u.Email</td>
                                            <td>@(u.Balance?.ToString() ?? "—")</td>
                                            <td>
                                                <span class="badge @(u.Role == 1 ? "bg-warning text-dark" : "bg-info")">
                                                    @(u.Role == 1 ? "Админ" : "Студент")
                                                </span>
                                            </td>
                                            <td>
                                                <button class="btn btn-sm btn-outline-danger" title="Удалить"
                                                        @onclick="() => DeleteUser(u)">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mt-2">
                            <small class="text-secondary">@(FilteredUsers.Count()) пользовател(ей)</small>
                            @if (TotalUserPages > 1)
                            {
                                <ul class="pagination pagination-sm mb-0">
                                    <li class="page-item @(UserPage == 0 ? "disabled" : "")">
                                        <button class="page-link" @onclick="() => UserPage--" disabled="@(UserPage == 0)">
                                            <i class="bi bi-chevron-left"></i>
                                        </button>
                                    </li>
                                    @for (int i = 0; i < TotalUserPages; i++)
                                    {
                                        var idx = i;
                                        <li class="page-item @(idx == UserPage ? "active" : "")">
                                            <button class="page-link" @onclick="() => UserPage = idx">@(idx + 1)</button>
                                        </li>
                                    }
                                    <li class="page-item @(UserPage >= TotalUserPages - 1 ? "disabled" : "")">
                                        <button class="page-link" @onclick="() => UserPage++" disabled="@(UserPage >= TotalUserPages - 1)">
                                            <i class="bi bi-chevron-right"></i>
                                        </button>
                                    </li>
                                </ul>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- ==================== МОДАЛКА ТОВАРА ==================== -->
    @if (_showProductModal)
    {
        <div class="modal fade show d-block" tabindex="-1"
             style="background-color: rgba(0,0,0,0.5);"
             @onclick="CloseProductModal">
            <div class="modal-dialog modal-dialog-centered"
                 @onclick:stopPropagation="true">
                <div class="modal-content rounded-3 shadow">
                    <div class="modal-header border-0 pb-0">
                        <h6 class="modal-title fw-semibold">
                            <i class="bi bi-@(_editingProduct == null ? "plus-circle" : "pencil-square") me-1"></i>
                            @(_editingProduct == null ? "Новый товар" : "Редактирование товара")
                        </h6>
                        <button type="button" class="btn-close" @onclick="CloseProductModal"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label small fw-medium">Название <span class="text-danger">*</span></label>
                            <input type="text" class="form-control @(_formName.Length > 0 ? "is-valid" : "")"
                                   @bind="_formName" placeholder="Введите название" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-medium">Описание</label>
                            <textarea class="form-control" rows="2" @bind="_formDescription"
                                      placeholder="Краткое описание товара"></textarea>
                        </div>
                        <div class="row g-3">
                            <div class="col-6">
                                <label class="form-label small fw-medium">Цена (₽)</label>
                                <input type="number" class="form-control" @bind="_formPrice" min="0" />
                            </div>
                            <div class="col-6">
                                <label class="form-label small fw-medium">Количество</label>
                                <input type="number" class="form-control" @bind="_formQuantity" min="0" />
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer border-0 pt-0">
                        <button type="button" class="btn btn-secondary btn-sm" @onclick="CloseProductModal">Отмена</button>
                        <button type="button" class="btn btn-primary btn-sm"
                                disabled="@(_formName.Length == 0)"
                                @onclick="SaveProduct">
                            <i class="bi bi-check-lg me-1"></i>Сохранить
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- МОДАЛКА ПОДТВЕРЖДЕНИЯ -->
    @if (_showConfirmModal)
    {
        <div class="modal fade show d-block" tabindex="-1"
             style="background-color: rgba(0,0,0,0.5);"
             @onclick="CancelConfirm">
            <div class="modal-dialog modal-sm modal-dialog-centered"
                 @onclick:stopPropagation="true">
                <div class="modal-content rounded-3 shadow">
                    <div class="modal-body text-center py-4">
                        <i class="bi bi-exclamation-triangle text-warning fs-1 mb-2 d-block"></i>
                        <p class="mb-3 fw-medium">@_confirmMessage</p>
                        <div class="d-flex gap-2 justify-content-center">
                            <button class="btn btn-secondary btn-sm px-3" @onclick="CancelConfirm">Отмена</button>
                            <button class="btn btn-danger btn-sm px-3" @onclick="ExecuteConfirm">Удалить</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private List<ProductDto> Products = new();
    private List<OrderDto> Orders = new();
    private List<UserDto> Users = new();

    private string? _notification;
    private string _notificationType = "success";
    private bool _loading = true;

    private string _productSearch = "";
    private string ProductSearch { get => _productSearch; set { _productSearch = value; ProductPage = 0; } }
    private string _productFilter = "";
    private string ProductFilter { get => _productFilter; set { _productFilter = value; ProductPage = 0; } }
    private string _orderSearch = "";
    private string OrderSearch { get => _orderSearch; set { _orderSearch = value; OrderPage = 0; } }
    private string _orderStatusFilter = "";
    private string OrderStatusFilter { get => _orderStatusFilter; set { _orderStatusFilter = value; OrderPage = 0; } }
    private string _userSearch = "";
    private string UserSearch { get => _userSearch; set { _userSearch = value; UserPage = 0; } }
    private string _userRoleFilter = "";
    private string UserRoleFilter { get => _userRoleFilter; set { _userRoleFilter = value; UserPage = 0; } }

    private const int PageSize = 8;
    private int ProductPage;
    private int OrderPage;
    private int UserPage;

    private bool _showProductModal;
    private ProductDto? _editingProduct;
    private string _formName = "";
    private string _formDescription = "";
    private short _formPrice;
    private short _formQuantity;

    private PeriodicTimer? _refreshTimer;

    // ========== ФИЛЬТРЫ ==========
    private IEnumerable<ProductDto> FilteredProducts =>
        Products
            .Where(p => string.IsNullOrEmpty(_productSearch) ||
                (p.Name ?? "").Contains(_productSearch, StringComparison.OrdinalIgnoreCase) ||
                (p.Description ?? "").Contains(_productSearch, StringComparison.OrdinalIgnoreCase))
            .Where(p => string.IsNullOrEmpty(_productFilter) || p.Status.ToString() == _productFilter);

    private IEnumerable<OrderDto> FilteredOrders =>
        Orders
            .Where(o => string.IsNullOrEmpty(_orderSearch) ||
                o.Id.ToString().Contains(_orderSearch) ||
                (o.CustomerLogin ?? "").Contains(_orderSearch, StringComparison.OrdinalIgnoreCase))
            .Where(o => string.IsNullOrEmpty(_orderStatusFilter) || o.Status.ToString() == _orderStatusFilter);

    private IEnumerable<UserDto> FilteredUsers =>
        Users
            .Where(u => string.IsNullOrEmpty(_userSearch) ||
                (u.Email ?? "").Contains(_userSearch, StringComparison.OrdinalIgnoreCase))
            .Where(u => string.IsNullOrEmpty(_userRoleFilter) || u.Role.ToString() == _userRoleFilter);

    // ========== ПАГИНАЦИЯ ==========
    private IEnumerable<ProductDto> PagedProducts => SortedProducts.Skip(ProductPage * PageSize).Take(PageSize);
    private IEnumerable<OrderDto> PagedOrders => SortedOrders.Skip(OrderPage * PageSize).Take(PageSize);
    private IEnumerable<UserDto> PagedUsers => SortedUsers.Skip(UserPage * PageSize).Take(PageSize);

    private int TotalProductPages => Math.Max(1, (int)Math.Ceiling(FilteredProducts.Count() / (double)PageSize));
    private int TotalOrderPages => Math.Max(1, (int)Math.Ceiling(FilteredOrders.Count() / (double)PageSize));
    private int TotalUserPages => Math.Max(1, (int)Math.Ceiling(FilteredUsers.Count() / (double)PageSize));

    // ========== СОРТИРОВКА ==========
    private string? _productSortColumn;
    private bool _productSortAsc = true;
    private string? _orderSortColumn;
    private bool _orderSortAsc = true;
    private string? _userSortColumn;
    private bool _userSortAsc = true;

    private void ToggleProductSort(string column)
    {
        if (_productSortColumn == column) _productSortAsc = !_productSortAsc;
        else { _productSortColumn = column; _productSortAsc = true; }
        ProductPage = 0;
    }

    private void ToggleOrderSort(string column)
    {
        if (_orderSortColumn == column) _orderSortAsc = !_orderSortAsc;
        else { _orderSortColumn = column; _orderSortAsc = true; }
        OrderPage = 0;
    }

    private void ToggleUserSort(string column)
    {
        if (_userSortColumn == column) _userSortAsc = !_userSortAsc;
        else { _userSortColumn = column; _userSortAsc = true; }
        UserPage = 0;
    }

    private string SortIcon(string column, string? sortColumn, bool asc) =>
        sortColumn != column ? "" : asc ? " ▲" : " ▼";

    private IEnumerable<ProductDto> SortedProducts => _productSortColumn switch
    {
        "name" => _productSortAsc ? FilteredProducts.OrderBy(p => p.Name) : FilteredProducts.OrderByDescending(p => p.Name),
        "price" => _productSortAsc ? FilteredProducts.OrderBy(p => p.Price) : FilteredProducts.OrderByDescending(p => p.Price),
        "quantity" => _productSortAsc ? FilteredProducts.OrderBy(p => p.Quantity) : FilteredProducts.OrderByDescending(p => p.Quantity),
        "status" => _productSortAsc ? FilteredProducts.OrderBy(p => p.Status) : FilteredProducts.OrderByDescending(p => p.Status),
        _ => FilteredProducts
    };

    private IEnumerable<OrderDto> SortedOrders => _orderSortColumn switch
    {
        "id" => _orderSortAsc ? FilteredOrders.OrderBy(o => o.Id) : FilteredOrders.OrderByDescending(o => o.Id),
        "customer" => _orderSortAsc ? FilteredOrders.OrderBy(o => o.CustomerLogin) : FilteredOrders.OrderByDescending(o => o.CustomerLogin),
        "sum" => _orderSortAsc ? FilteredOrders.OrderBy(o => o.Sum) : FilteredOrders.OrderByDescending(o => o.Sum),
        "status" => _orderSortAsc ? FilteredOrders.OrderBy(o => o.Status) : FilteredOrders.OrderByDescending(o => o.Status),
        _ => FilteredOrders
    };

    private IEnumerable<UserDto> SortedUsers => _userSortColumn switch
    {
        "email" => _userSortAsc ? FilteredUsers.OrderBy(u => u.Email) : FilteredUsers.OrderByDescending(u => u.Email),
        "balance" => _userSortAsc ? FilteredUsers.OrderBy(u => u.Balance) : FilteredUsers.OrderByDescending(u => u.Balance),
        "role" => _userSortAsc ? FilteredUsers.OrderBy(u => u.Role) : FilteredUsers.OrderByDescending(u => u.Role),
        _ => FilteredUsers
    };

    // ========== ЧЕКБОКС ==========
    private bool IsAllSelected => PagedProducts.Any() && PagedProducts.All(p => p.IsSelected);

    // ========== ЖИЗНЕННЫЙ ЦИКЛ ==========
    protected override async Task OnInitializedAsync()
    {
        await LoadAllData();
        _refreshTimer = new PeriodicTimer(TimeSpan.FromSeconds(30));
        _ = RefreshLoop();
    }

    private async Task RefreshLoop()
    {
        while (_refreshTimer is not null && await _refreshTimer.WaitForNextTickAsync())
        {
            await LoadAllData();
            await InvokeAsync(StateHasChanged);
        }
    }

    public void Dispose() => _refreshTimer?.Dispose();

    // ========== ЗАГРУЗКА ==========
    private async Task LoadAllData()
    {
        try
        {
            var productsTask = Http.GetFromJsonAsync<List<ProductDto>>("api/Product/all");
            var ordersTask = Http.GetFromJsonAsync<List<OrderDto>>("api/Order/all");
            var usersTask = Http.GetFromJsonAsync<List<UserDto>>("api/User/all");
            await Task.WhenAll(productsTask, ordersTask, usersTask);
            Products = productsTask.Result ?? new();
            Orders = ordersTask.Result ?? new();
            Users = usersTask.Result ?? new();
        }
        catch (Exception ex) { ShowNotification($"Ошибка загрузки: {ex.Message}", "danger"); }
        finally { _loading = false; }
    }

    // ========== УВЕДОМЛЕНИЯ ==========
    private void ShowNotification(string message, string type = "success")
    {
        _notification = message;
        _notificationType = type;
        _ = Task.Delay(4000).ContinueWith(_ =>
        {
            if (_notification == message) _notification = null;
            InvokeAsync(StateHasChanged);
        });
    }

    // ========== ПОДТВЕРЖДЕНИЕ ==========
    private bool _showConfirmModal;
    private string _confirmMessage = "";
    private Func<Task>? _onConfirmAction;

    private void ShowConfirm(string message, Func<Task> action)
    {
        _confirmMessage = message;
        _onConfirmAction = action;
        _showConfirmModal = true;
    }

    private void CancelConfirm()
    {
        _showConfirmModal = false;
        _onConfirmAction = null;
    }

    private async Task ExecuteConfirm()
    {
        _showConfirmModal = false;
        if (_onConfirmAction is not null)
            await _onConfirmAction();
        _onConfirmAction = null;
    }

    // ========== МАССОВЫЕ ДЕЙСТВИЯ ==========
    private void ToggleSelectAll(ChangeEventArgs e)
    {
        var val = (bool)e.Value!;
        foreach (var p in PagedProducts) p.IsSelected = val;
    }

    private void DeleteSelectedProducts()
    {
        var selected = Products.Where(p => p.IsSelected).ToList();
        ShowConfirm($"Удалить {selected.Count} товар(ов)?", async () =>
        {
            foreach (var p in selected)
            {
                var r = await Http.DeleteAsync($"api/Product/delete-product?id={p.Id}");
                if (r.IsSuccessStatusCode) Products.Remove(p);
            }
            ShowNotification($"Удалено: {selected.Count} товар(ов)");
            StateHasChanged();
        });
    }

    private async Task ShowSelectedProducts() => await SetSelectedStatus(0);

    private async Task HideSelectedProducts() => await SetSelectedStatus(1);

    private async Task SetSelectedStatus(int status)
    {
        var selected = Products.Where(p => p.IsSelected).ToList();
        foreach (var p in selected)
        {
            var r = await Http.PutAsJsonAsync($"api/Product/update-product?id={p.Id}",
                new { Status = status });
            if (r.IsSuccessStatusCode) p.Status = status;
        }
        ShowNotification($"Обновлено: {selected.Count} товар(ов)");
        StateHasChanged();
    }

    // ========== ТОВАРЫ ==========
    private void OpenProductModal(ProductDto? product = null)
    {
        _editingProduct = product;
        _formName = product?.Name ?? "";
        _formDescription = product?.Description ?? "";
        _formPrice = product?.Price ?? 0;
        _formQuantity = product?.Quantity ?? 0;
        _showProductModal = true;
    }

    private void CloseProductModal() => _showProductModal = false;

    private async Task SaveProduct()
    {
        try
        {
            if (_editingProduct == null)
            {
                var body = new { Name = _formName, Description = _formDescription, Price = _formPrice, Quantity = _formQuantity };
                var r = await Http.PostAsJsonAsync("api/Product/create-product", body);
                if (r.IsSuccessStatusCode)
                {
                    var c = await r.Content.ReadFromJsonAsync<ProductDto>();
                    if (c != null) Products.Add(c);
                    ShowNotification("Товар создан");
                }
                else ShowNotification("Ошибка создания товара", "danger");
            }
            else
            {
                var body = new { Name = _formName, Description = _formDescription, Price = _formPrice, Quantity = _formQuantity };
                var r = await Http.PutAsJsonAsync($"api/Product/update-product?id={_editingProduct.Id}", body);
                if (r.IsSuccessStatusCode)
                {
                    _editingProduct.Name = _formName;
                    _editingProduct.Description = _formDescription;
                    _editingProduct.Price = _formPrice;
                    _editingProduct.Quantity = _formQuantity;
                    ShowNotification("Товар обновлён");
                }
                else ShowNotification("Ошибка обновления товара", "danger");
            }
            CloseProductModal();
        }
        catch (Exception ex) { ShowNotification($"Ошибка: {ex.Message}", "danger"); }
    }

    private async Task OnQuantityChanged(ProductDto product, ChangeEventArgs e)
    {
        if (short.TryParse(e.Value?.ToString(), out short q) && product.Quantity != q)
        {
            var r = await Http.PutAsJsonAsync($"api/Product/update-product?id={product.Id}", new { Quantity = q });
            if (r.IsSuccessStatusCode)
            {
                product.Quantity = q;
                ShowNotification($"«{product.Name}»: количество = {q}");
            }
        }
    }

    private void DeleteProduct(ProductDto product)
    {
        ShowConfirm($"Удалить «{product.Name}»?", async () =>
        {
            var r = await Http.DeleteAsync($"api/Product/delete-product?id={product.Id}");
            if (r.IsSuccessStatusCode)
            {
                Products.Remove(product);
                ShowNotification("Товар удалён");
                StateHasChanged();
            }
        });
    }

    // ========== ЗАКАЗЫ ==========
    private async Task ChangeOrderStatus(OrderDto order, int newStatus)
    {
        var r = await Http.PutAsJsonAsync($"api/Order/update-order?id={order.Id}", new { Status = newStatus });
        if (r.IsSuccessStatusCode)
        {
            order.Status = newStatus;
            ShowNotification($"Заказ #{order.Id}: статус изменён");
        }
    }

    // ========== ПОЛЬЗОВАТЕЛИ ==========
    private void DeleteUser(UserDto user)
    {
        ShowConfirm($"Удалить «{user.Email}»?", async () =>
        {
            var r = await Http.DeleteAsync($"api/User?id={user.Id}");
            if (r.IsSuccessStatusCode)
            {
                Users.Remove(user);
                ShowNotification($"Пользователь «{user.Email}» удалён");
                StateHasChanged();
            }
        });
    }
}
