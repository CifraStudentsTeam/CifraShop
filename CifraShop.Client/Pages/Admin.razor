    protected override async Task OnInitializedAsync()
    {
        await LoadAllData();
        await LoadHistory();
        _refreshTimer = new PeriodicTimer(TimeSpan.FromSeconds(30));
        _ = RefreshLoop();
    }

    private async Task RefreshLoop()
    {
        while (_refreshTimer is not null && await _refreshTimer.WaitForNextTickAsync())
        {
            await LoadAllData();
            await InvokeAsync(StateHasChanged);
        }
    }

    public void Dispose()
    {
        _refreshTimer?.Dispose();
        _productSearchCts?.Dispose();
        _orderSearchCts?.Dispose();
        _userSearchCts?.Dispose();
    }

    private async Task LoadAllData()
    {
        await Task.WhenAll(LoadProducts(), LoadOrders(), LoadUsers(), LoadNotificationSettings());
        _lastUpdated = DateTime.Now;
    }

    private async Task LoadProducts()
    {
        try
        {
            _loadingProducts = Products.Count == 0;
            var url = $"api/Product/paged?page={_productPage}&pageSize={PageSize}";
            if (!string.IsNullOrEmpty(_productSearch)) url += $"&search={Uri.EscapeDataString(_productSearch)}";
            if (!string.IsNullOrEmpty(_productFilter)) url += $"&status={_productFilter}";
            var r = await Http.GetFromJsonAsync<PagedProductResponse>(url);
            if (r != null) { Products = r.Items; _productTotalCount = r.TotalCount; }
        }
        catch (Exception ex) { ShowNotification($"Ошибка загрузки товаров: {ex.Message}", "danger"); }
        finally { _loadingProducts = false; }
    }

    private async Task LoadOrders()
    {
        try
        {
            _loadingOrders = Orders.Count == 0;
            var url = $"api/Order/paged?page={_orderPage}&pageSize={PageSize}";
            if (!string.IsNullOrEmpty(_orderSearch)) url += $"&search={Uri.EscapeDataString(_orderSearch)}";
            if (!string.IsNullOrEmpty(_orderFilter)) url += $"&status={_orderFilter}";
            if (!string.IsNullOrEmpty(_orderDateFrom)) url += $"&dateFrom={_orderDateFrom}";
            if (!string.IsNullOrEmpty(_orderDateTo)) url += $"&dateTo={_orderDateTo}";
            var r = await Http.GetFromJsonAsync<PagedOrderResponse>(url);
            if (r != null) { Orders = r.Items; _orderTotalCount = r.TotalCount; }
        }
        catch (Exception ex) { ShowNotification($"Ошибка загрузки заказов: {ex.Message}", "danger"); }
        finally { _loadingOrders = false; }
    }

    private async Task LoadUsers()
    {
        try
        {
            _loadingUsers = Users.Count == 0;
            var url = $"api/User/paged?page={_userPage}&pageSize={PageSize}";
            if (!string.IsNullOrEmpty(_userSearch)) url += $"&search={Uri.EscapeDataString(_userSearch)}";
            if (!string.IsNullOrEmpty(_userFilter)) url += $"&role={_userFilter}";
            var r = await Http.GetFromJsonAsync<PagedUserResponse>(url);
            if (r != null) { Users = r.Items; _userTotalCount = r.TotalCount; }
        }
        catch (Exception ex) { ShowNotification($"Ошибка загрузки пользователей: {ex.Message}", "danger"); }
        finally { _loadingUsers = false; }
    }

