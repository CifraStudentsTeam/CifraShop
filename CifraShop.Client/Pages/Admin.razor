@page "/admin"
@using System.Net.Http.Json
@using CifraShop.Client.Models
@using CifraShop.Client.Pages.Components
@using CifraShop.Client.Services
@implements IDisposable
@inject HttpClient Http
@inject NavigationManager Nav
@inject SignalRService SignalR

<PageTitle>Админ-панель — CifraShop</PageTitle>

<style>
    .autocomplete-item:hover { background: #e9ecef; }
    .editable-cell:hover { border-bottom-color: #0d6efd; }
</style>

<div class="container-fluid px-3 py-2" @onkeydown="HandleKeyDown">

    @if (!string.IsNullOrEmpty(_notification))
    {
        <div class="alert alert-@_notificationType alert-dismissible fade show py-2 small" role="alert">
            <i class="bi bi-@(_notificationType == "success" ? "check-circle-fill" : "exclamation-triangle-fill") me-1"></i>
            @_notification
            <button type="button" class="btn-close btn-close-sm" @onclick="() => _notification = null"></button>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-2">
        <div class="d-flex align-items-center gap-3">
            <h5 class="fw-bold mb-0"><i class="bi bi-grid-3x3-gap me-1"></i>Админ-панель</h5>
            @if (SignalR.IsConnected)
            {
                <span class="badge bg-success" style="font-size:0.6rem;cursor:help;" title="SignalR подключён: все изменения отображаются мгновенно, без перезагрузки">● Online</span>
            }
            else
            {
                <span class="badge bg-danger" style="font-size:0.6rem;cursor:help;" title="SignalR отключён: данные обновляются каждые 5 минут. Перезагрузите страницу для немедленного подключения">● Offline</span>
            }
            @if (_lastUpdated.HasValue)
            {
                <small class="text-secondary"><i class="bi bi-arrow-clockwise me-1"></i>Обновлено @_lastUpdated.Value.ToString("HH:mm:ss")</small>
            }
        </div>
        <div class="d-flex align-items-center gap-2">
            <small class="text-secondary">Филиал (фильтр):</small>
            <select class="form-select form-select-sm w-auto" @bind="_selectedBranch">
                <option value="">Все филиалы</option>
                @foreach (var branch in _notificationSettings.Select(s => s.Branch).Distinct().OrderBy(b => b))
                {
                    <option value="@branch">@branch</option>
                }
            </select>
        </div>
    </div>
    <div class="row g-2 mb-3">
        <MetricCard Title="Товаров" Count="@_productTotalCount" Subtitle="@_lowStockSubtitle" Icon="bi-box" Color="primary" />
        <MetricCard Title="Заказы" Count="@_orderTotalCount" Subtitle="@($"{_totalRevenue:N0}  выручка")" Icon="bi-cart-check" Color="warning" />
        <MetricCard Title="Пользователи" Count="@_userTotalCount" Subtitle="@($"{_adminCount} админ(ов)")" Icon="bi-people" Color="success" />
        <MetricCard Title="Филиалы" Count="@_notificationSettings.Count" Subtitle="@($"{_configuredFilials} настроено")" Icon="bi-geo-alt" Color="info" />
    </div>

    <div class="row g-3 mb-3">
        <AdminProductsPanel Products="Products" TotalCount="_productTotalCount" Page="_productPage"
                            PageSize="_productPageSize" TotalPages="_productTotalPages" Loading="_loadingProducts"
                            Search="_productSearch" Filter="_productFilter" SortField="_productSortField" SortAsc="_productSortAsc"
                            TotalStockValue="_totalStockValue"
                            OnSearchChanged="OnProductSearchChanged" OnFilterChanged="OnProductFilterChanged"
                            OnPageChanged="OnProductPageChanged" OnPageSizeChanged="OnProductPageSizeChanged"
                            OnSortToggle="ToggleProductSort"
                            OnNotification="NotifyFromChild" OnConfirm="ConfirmFromChild" OnLogAction="LogFromChild"
                            OnMetricsChanged="LoadMetrics" />

        <AdminOrdersPanel Orders="Orders" TotalCount="_orderTotalCount" Page="_orderPage"
                          PageSize="_orderPageSize" TotalPages="_orderTotalPages" Loading="_loadingOrders"
                          Search="_orderSearch" Filter="_orderFilter" DateFrom="_orderDateFrom" DateTo="_orderDateTo"
                          SortField="_orderSortField" SortAsc="_orderSortAsc" ExpandedOrderId="_expandedOrderId"
                          TotalRevenue="_totalRevenue" AllProducts="_allProductsForOrder" AllUsersCache="_allUsersCache"
                          OnSearchChanged="OnOrderSearchChanged" OnFilterChanged="OnOrderFilterChanged"
                          OnDateFromChanged="OnOrderDateFromChanged" OnDateToChanged="OnOrderDateToChanged"
                          OnPageChanged="OnOrderPageChanged" OnPageSizeChanged="OnOrderPageSizeChanged"
                          OnSortToggle="ToggleOrderSort" OnOrderExpand="OnOrderExpandWrapper"
                          OnNotification="NotifyFromChild" OnConfirm="ConfirmFromChild" OnLogAction="LogFromChild"
                          OnMetricsChanged="LoadMetrics" />
    </div>

    <div class="row g-3 mb-3">
        <AdminUsersPanel Users="Users" TotalCount="_userTotalCount" Page="_userPage"
                         PageSize="_userPageSize" TotalPages="_userTotalPages" Loading="_loadingUsers"
                         Search="_userSearch" Filter="_userFilter" SortField="_userSortField" SortAsc="_userSortAsc"
                         OnSearchChanged="OnUserSearchChanged" OnFilterChanged="OnUserFilterChanged"
                         OnPageChanged="OnUserPageChanged" OnPageSizeChanged="OnUserPageSizeChanged"
                         OnSortToggle="ToggleUserSort"
                         OnNotification="NotifyFromChild" OnConfirm="ConfirmFromChild" OnLogAction="LogFromChild" />
    </div>

    <div class="row g-3 mb-3">
        <AdminNotificationsPanel Settings="_notificationSettings" OnNotification="NotifyFromChild" />
        <AdminHistoryPanel History="_actionHistory" AvailableBranches="_availableBranches" />
    </div>

    @if (_showConfirmModal)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);" @onclick="CancelConfirm">
            <div class="modal-dialog modal-sm modal-dialog-centered" @onclick:stopPropagation="true">
                <div class="modal-content rounded-3 shadow">
                    <div class="modal-body text-center py-4">
                        <i class="bi bi-exclamation-triangle text-warning fs-1 mb-2 d-block"></i>
                        <p class="mb-3 fw-medium">@_confirmMessage</p>
                        <div class="d-flex gap-2 justify-content-center">
                            <button class="btn btn-secondary btn-sm px-3" @onclick="CancelConfirm">Отмена</button>
                            <button class="btn btn-danger btn-sm px-3" @onclick="ExecuteConfirm">@_confirmButtonText</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private List<ProductDto> Products = new();
    private List<OrderDto> Orders = new();
    private List<UserDto> Users = new();
    private List<UserDto> _allUsersCache = new();
    private List<AdminActionDto> _actionHistory = new();
    private List<NotificationSettingsDto> _notificationSettings = new();
    private List<ProductDto> _allProductsForOrder = new();

    private string? _notification;
    private string _notificationType = "success";
    private bool _loadingProducts = true;
    private bool _loadingOrders = true;
    private bool _loadingUsers = true;

    private int _productTotalCount, _orderTotalCount, _userTotalCount;
    private int _productPage, _orderPage, _userPage;
    private int _productTotalPages => Math.Max(1, (int)Math.Ceiling(_productTotalCount / (double)_productPageSize));
    private int _orderTotalPages => Math.Max(1, (int)Math.Ceiling(_orderTotalCount / (double)_orderPageSize));
    private int _userTotalPages => Math.Max(1, (int)Math.Ceiling(_userTotalCount / (double)_userPageSize));

    private DateTime? _lastUpdated;
    private int _totalRevenue;
    private int _adminCount;
    private int _lowStockCount;
    private string _lowStockSubtitle
    {
        get
        {
            var outOfStock = _outOfStockCount;
            var lowStock = _lowStockCount;
            var parts = new List<string>();
            if (outOfStock > 0) parts.Add($"{outOfStock} без наличия");
            if (lowStock > 0) parts.Add($"{lowStock} с низким остатком");
            return parts.Count > 0 ? string.Join(", ", parts) : "Все в наличии";
        }
    }
    private int _outOfStockCount;
    private int _configuredFilials => _notificationSettings.Count(s => !string.IsNullOrEmpty(s.Email) || !string.IsNullOrEmpty(s.TelegramChatId));
    private int _totalStockValue;

    private string _productSearch = "", _productFilter = "";
    private string _orderSearch = "", _orderFilter = "", _orderDateFrom = "", _orderDateTo = "";
    private string _userSearch = "", _userFilter = "";
    private string _selectedBranch = "";
    private List<string> _availableBranches = new();

    private string _productSortField = "";
    private bool _productSortAsc = true;
    private string _orderSortField = "";
    private bool _orderSortAsc = true;
    private string _userSortField = "";
    private bool _userSortAsc = true;
    private int _productPageSize = 8;
    private int _orderPageSize = 8;
    private int _userPageSize = 8;

    private int? _expandedOrderId;

    private bool _showConfirmModal;
    private string _confirmMessage = "", _confirmButtonText = "Удалить";
    private Func<Task>? _onConfirmAction;

    private CancellationTokenSource? _productSearchCts, _orderSearchCts, _userSearchCts, _notificationCts;
    private PeriodicTimer? _fallbackTimer;

    protected override async Task OnInitializedAsync()
    {
        RestoreFiltersFromUrl();
        await LoadAllData();
        await LoadHistory();

        SignalR.OnNotify += HandleSignalRNotify;
        try { await SignalR.StartAsync(); }
        catch (Exception ex) { ShowNotification($"SignalR: {ex.Message}", "warning"); }

        _fallbackTimer = new PeriodicTimer(TimeSpan.FromMinutes(5));
        _ = FallbackLoop();
    }

    private void HandleSignalRNotify(string entity, string action)
    {
        _ = InvokeAsync(async () =>
        {
            try
            {
                var expandedId = _expandedOrderId;
                switch (entity)
                {
                    case "product":
                        await LoadProducts();
                        await LoadMetrics();
                        await LoadAllProducts();
                        break;
                    case "order":
                        await LoadOrders();
                        _expandedOrderId = expandedId;
                        await LoadMetrics();
                        break;
                    case "user":
                        await LoadUsers();
                        await LoadUsersMetrics();
                        break;
                    case "notification":
                        await LoadNotificationSettings();
                        break;
                }
                _lastUpdated = DateTime.Now;
                StateHasChanged();
            }
            catch (Exception ex)
            {
                Console.WriteLine($"[SignalR] HandleNotify error: {ex.Message}");
            }
        });
    }

    private async Task FallbackLoop()
    {
        while (_fallbackTimer is not null && await _fallbackTimer.WaitForNextTickAsync())
        {
            try
            {
                if (SignalR.IsConnected) continue;
                await LoadAllData();
                await InvokeAsync(StateHasChanged);
            }
            catch { }
        }
    }

    public void Dispose()
    {
        SignalR.OnNotify -= HandleSignalRNotify;
        _fallbackTimer?.Dispose();
        _productSearchCts?.Cancel(); _productSearchCts?.Dispose();
        _orderSearchCts?.Cancel(); _orderSearchCts?.Dispose();
        _userSearchCts?.Cancel(); _userSearchCts?.Dispose();
        _notificationCts?.Cancel(); _notificationCts?.Dispose();
    }

    private async Task LoadAllData()
    {
        await Task.WhenAll(LoadProducts(), LoadOrders(), LoadUsers(), LoadNotificationSettings(), LoadMetrics(), LoadUsersMetrics(), LoadAllProducts());
        _lastUpdated = DateTime.Now;
    }

    private async Task LoadMetrics()
    {
        try
        {
            var allProducts = await Http.GetFromJsonAsync<List<ProductDto>>("api/Product/all") ?? new();
            var allOrders = await Http.GetFromJsonAsync<List<OrderDto>>("api/Order/all") ?? new();
            _totalRevenue = allOrders.Sum(o => o.Sum);
            _lowStockCount = allProducts.Count(p => p.Status == StatusProduct.InStock && p.Quantity <= 5);
            _outOfStockCount = allProducts.Count(p => p.Status == StatusProduct.OutOfStock);
            _totalStockValue = allProducts.Where(p => p.Status == StatusProduct.InStock).Sum(p => p.Price * p.Quantity);
        }
        catch { }
    }

    private async Task LoadUsersMetrics()
    {
        try
        {
            await LoadAllUsers();
            _adminCount = _allUsersCache.Count(u => u.Role == UserRole.Admin);
        }
        catch { }
    }

    private async Task LoadProducts()
    {
        try
        {
            _loadingProducts = true;
            var url = $"api/Product/paged?page={_productPage}&pageSize={_productPageSize}";
            if (!string.IsNullOrEmpty(_productSearch)) url += $"&search={Uri.EscapeDataString(_productSearch)}";
            if (!string.IsNullOrEmpty(_productFilter)) url += $"&status={_productFilter}";
            var r = await Http.GetFromJsonAsync<PagedProductResponse>(url);
            if (r != null) { Products = r.Items; _productTotalCount = r.TotalCount; }
        }
        catch (Exception ex) { ShowNotification($"Ошибка загрузки товаров: {ex.Message}", "danger"); }
        finally { _loadingProducts = false; }
    }

    private async Task LoadOrders()
    {
        try
        {
            _expandedOrderId = null;
            _loadingOrders = true;
            var url = $"api/Order/paged?page={_orderPage}&pageSize={_orderPageSize}";
            if (!string.IsNullOrEmpty(_orderSearch)) url += $"&search={Uri.EscapeDataString(_orderSearch)}";
            if (!string.IsNullOrEmpty(_orderFilter)) url += $"&status={_orderFilter}";
            if (!string.IsNullOrEmpty(_orderDateFrom)) url += $"&dateFrom={_orderDateFrom}";
            if (!string.IsNullOrEmpty(_orderDateTo)) url += $"&dateTo={_orderDateTo}";
            var r = await Http.GetFromJsonAsync<PagedOrderResponse>(url);
            if (r != null) { Orders = r.Items; _orderTotalCount = r.TotalCount; }
        }
        catch (Exception ex) { ShowNotification($"Ошибка загрузки заказов: {ex.Message}", "danger"); }
        finally { _loadingOrders = false; }
    }

    private async Task LoadUsers()
    {
        try
        {
            _loadingUsers = true;
            var url = $"api/User/paged?page={_userPage}&pageSize={_userPageSize}";
            if (!string.IsNullOrEmpty(_userSearch)) url += $"&search={Uri.EscapeDataString(_userSearch)}";
            if (!string.IsNullOrEmpty(_userFilter)) url += $"&role={_userFilter}";
            var r = await Http.GetFromJsonAsync<PagedUserResponse>(url);
            if (r != null) { Users = r.Items; _userTotalCount = r.TotalCount; }
        }
        catch (Exception ex) { ShowNotification($"Ошибка загрузки пользователей: {ex.Message}", "danger"); }
        finally { _loadingUsers = false; }
    }

    private async Task LoadAllUsers()
    {
        try { _allUsersCache = await Http.GetFromJsonAsync<List<UserDto>>("api/User/all") ?? new(); }
        catch { _allUsersCache = new(); }
    }

    private async Task LoadAllProducts()
    {
        try { _allProductsForOrder = await Http.GetFromJsonAsync<List<ProductDto>>("api/Product/all") ?? new(); }
        catch { _allProductsForOrder = new(); }
    }

    private async Task LoadHistory()
    {
        try
        {
            _actionHistory = await Http.GetFromJsonAsync<List<AdminActionDto>>("api/AdminAction/last?count=100") ?? new();
            _availableBranches = _actionHistory
                .Select(a => a.Branch)
                .Where(b => !string.IsNullOrEmpty(b))
                .Distinct()
                .OrderBy(b => b)
                .ToList();
        }
        catch { }
    }

    private async Task LoadNotificationSettings()
    {
        try { _notificationSettings = await Http.GetFromJsonAsync<List<NotificationSettingsDto>>("api/NotificationSettings/all") ?? new(); }
        catch { _notificationSettings = new(); }
    }

    private async Task OnProductSearchChanged(string value)
    {
        _productSearch = value;
        _productPage = 0;
        UpdateUrlFilters();
        _productSearchCts?.Cancel();
        _productSearchCts?.Dispose();
        _productSearchCts = new CancellationTokenSource();
        try { await Task.Delay(300, _productSearchCts.Token); } catch (TaskCanceledException) { return; }
        await LoadProducts();
    }

    private async Task OnProductFilterChanged(string value)
    {
        _productFilter = value;
        _productPage = 0;
        UpdateUrlFilters();
        await LoadProducts();
    }

    private async Task OnOrderSearchChanged(string value)
    {
        _orderSearch = value;
        _orderPage = 0;
        UpdateUrlFilters();
        _orderSearchCts?.Cancel();
        _orderSearchCts?.Dispose();
        _orderSearchCts = new CancellationTokenSource();
        try { await Task.Delay(300, _orderSearchCts.Token); } catch (TaskCanceledException) { return; }
        await LoadOrders();
    }

    private async Task OnOrderFilterChanged(string value)
    {
        _orderFilter = value;
        _orderPage = 0;
        UpdateUrlFilters();
        await LoadOrders();
    }

    private async Task OnOrderDateFromChanged(ChangeEventArgs e)
    {
        _orderDateFrom = e.Value?.ToString() ?? "";
        _orderPage = 0;
        UpdateUrlFilters();
        await LoadOrders();
    }

    private async Task OnOrderDateToChanged(ChangeEventArgs e)
    {
        _orderDateTo = e.Value?.ToString() ?? "";
        _orderPage = 0;
        UpdateUrlFilters();
        await LoadOrders();
    }

    private async Task OnUserSearchChanged(string value)
    {
        _userSearch = value;
        _userPage = 0;
        UpdateUrlFilters();
        _userSearchCts?.Cancel();
        _userSearchCts?.Dispose();
        _userSearchCts = new CancellationTokenSource();
        try { await Task.Delay(300, _userSearchCts.Token); } catch (TaskCanceledException) { return; }
        await LoadUsers();
    }

    private async Task OnUserFilterChanged(string value)
    {
        _userFilter = value;
        _userPage = 0;
        UpdateUrlFilters();
        await LoadUsers();
    }

    private async Task OnProductPageChanged(int page) { _productPage = page; await LoadProducts(); }
    private async Task OnOrderPageChanged(int page) { _orderPage = page; await LoadOrders(); }
    private async Task OnUserPageChanged(int page) { _userPage = page; await LoadUsers(); }

    private void ToggleProductSort(string field)
    {
        if (_productSortField == field) _productSortAsc = !_productSortAsc;
        else { _productSortField = field; _productSortAsc = true; }
        Products = field switch
        {
            "name" => _productSortAsc ? Products.OrderBy(p => p.Name).ToList() : Products.OrderByDescending(p => p.Name).ToList(),
            "price" => _productSortAsc ? Products.OrderBy(p => p.Price).ToList() : Products.OrderByDescending(p => p.Price).ToList(),
            "quantity" => _productSortAsc ? Products.OrderBy(p => p.Quantity).ToList() : Products.OrderByDescending(p => p.Quantity).ToList(),
            _ => Products
        };
        StateHasChanged();
    }

    private void ToggleOrderSort(string field)
    {
        if (_orderSortField == field) _orderSortAsc = !_orderSortAsc;
        else { _orderSortField = field; _orderSortAsc = true; }
        Orders = field switch
        {
            "id" => _orderSortAsc ? Orders.OrderBy(o => o.Id).ToList() : Orders.OrderByDescending(o => o.Id).ToList(),
            "date" => _orderSortAsc ? Orders.OrderBy(o => o.DateOfPurchase).ToList() : Orders.OrderByDescending(o => o.DateOfPurchase).ToList(),
            "sum" => _orderSortAsc ? Orders.OrderBy(o => o.Sum).ToList() : Orders.OrderByDescending(o => o.Sum).ToList(),
            _ => Orders
        };
        StateHasChanged();
    }

    private void ToggleUserSort(string field)
    {
        if (_userSortField == field) _userSortAsc = !_userSortAsc;
        else { _userSortField = field; _userSortAsc = true; }
        Users = field switch
        {
            "id" => _userSortAsc ? Users.OrderBy(u => u.Id).ToList() : Users.OrderByDescending(u => u.Id).ToList(),
            "email" => _userSortAsc ? Users.OrderBy(u => u.Email).ToList() : Users.OrderByDescending(u => u.Email).ToList(),
            "balance" => _userSortAsc ? Users.OrderBy(u => u.Balance ?? 0).ToList() : Users.OrderByDescending(u => u.Balance ?? 0).ToList(),
            _ => Users
        };
        StateHasChanged();
    }

    private async Task OnProductPageSizeChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int size) && size > 0)
        { _productPageSize = size; _productPage = 0; await LoadProducts(); }
    }
    private async Task OnOrderPageSizeChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int size) && size > 0)
        { _orderPageSize = size; _orderPage = 0; await LoadOrders(); }
    }
    private async Task OnUserPageSizeChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int size) && size > 0)
        { _userPageSize = size; _userPage = 0; await LoadUsers(); }
    }

    private void ToggleOrderExpand(int id) => _expandedOrderId = _expandedOrderId == id ? null : id;
    private void OnOrderExpandWrapper(int? id) { if (id.HasValue) ToggleOrderExpand(id.Value); }

    private void RestoreFiltersFromUrl()
    {
        var uri = new Uri(Nav.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
        _productSearch = query["ps"] ?? "";
        _productFilter = query["pf"] ?? "";
        _orderSearch = query["os"] ?? "";
        _orderFilter = query["of"] ?? "";
        _orderDateFrom = query["odf"] ?? "";
        _orderDateTo = query["odt"] ?? "";
        _userSearch = query["us"] ?? "";
        _userFilter = query["uf"] ?? "";
    }

    private void UpdateUrlFilters()
    {
        var query = new Dictionary<string, string?>();
        if (!string.IsNullOrEmpty(_productSearch)) query["ps"] = _productSearch;
        if (!string.IsNullOrEmpty(_productFilter)) query["pf"] = _productFilter;
        if (!string.IsNullOrEmpty(_orderSearch)) query["os"] = _orderSearch;
        if (!string.IsNullOrEmpty(_orderFilter)) query["of"] = _orderFilter;
        if (!string.IsNullOrEmpty(_orderDateFrom)) query["odf"] = _orderDateFrom;
        if (!string.IsNullOrEmpty(_orderDateTo)) query["odt"] = _orderDateTo;
        if (!string.IsNullOrEmpty(_userSearch)) query["us"] = _userSearch;
        if (!string.IsNullOrEmpty(_userFilter)) query["uf"] = _userFilter;
        var qs = string.Join("&", query.Select(kv => $"{kv.Key}={Uri.EscapeDataString(kv.Value ?? "")}"));
        var baseUri = Nav.Uri.Split('?')[0];
        Nav.NavigateTo(string.IsNullOrEmpty(qs) ? baseUri : $"{baseUri}?{qs}", forceLoad: false, replace: true);
    }

    private async Task LogAction(string type, string details)
    {
        var branch = _selectedBranch;
        if (string.IsNullOrEmpty(branch) && _notificationSettings.Any())
            branch = _notificationSettings.First().Branch;
        try { await Http.PostAsJsonAsync("api/AdminAction", new { ActionType = type, Details = details, Branch = branch }); }
        catch { }
        _actionHistory.Insert(0, new AdminActionDto { ActionType = type, Details = details, Branch = branch ?? "", CreatedAt = DateTime.Now });
        if (_actionHistory.Count > 100) _actionHistory.RemoveAt(_actionHistory.Count - 1);
        await InvokeAsync(StateHasChanged);
    }

    private void NotifyFromChild(string msg) => ShowNotification(msg);
    private void ConfirmFromChild((string message, Func<Task> action) t) => ShowConfirm(t.message, t.action);
    private async Task LogFromChild((string type, string details) t) => await LogAction(t.type, t.details);

    private void ShowNotification(string message, string type = "success")
    {
        _notificationCts?.Cancel();
        _notificationCts?.Dispose();
        _notification = message; _notificationType = type;
        _notificationCts = new CancellationTokenSource();
        var token = _notificationCts.Token;
        _ = Task.Delay(4000, token).ContinueWith(_ =>
        {
            if (!token.IsCancellationRequested && _notification == message)
            { _notification = null; InvokeAsync(StateHasChanged); }
        }, token);
    }

    private void ShowConfirm(string message, Func<Task> action, string buttonText = "Удалить")
    { _confirmMessage = message; _onConfirmAction = action; _confirmButtonText = buttonText; _showConfirmModal = true; }

    private void CancelConfirm() { _showConfirmModal = false; _onConfirmAction = null; }
    private async Task ExecuteConfirm()
    { _showConfirmModal = false; if (_onConfirmAction is not null) await _onConfirmAction(); _onConfirmAction = null; }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape" && _showConfirmModal) CancelConfirm();
    }

    private class PagedProductResponse { public List<ProductDto> Items { get; set; } = new(); public int Page { get; set; } public int PageSize { get; set; } public int TotalCount { get; set; } }
    private class PagedOrderResponse { public List<OrderDto> Items { get; set; } = new(); public int Page { get; set; } public int PageSize { get; set; } public int TotalCount { get; set; } }
    private class PagedUserResponse { public List<UserDto> Items { get; set; } = new(); public int Page { get; set; } public int PageSize { get; set; } public int TotalCount { get; set; } }
}
