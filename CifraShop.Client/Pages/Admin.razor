    private async Task CreateOrder()
    {
        _creatingOrder = true;
        try
        {
            var items = _newOrderItems
                .Where(i => i.ProductId > 0)
                .Select(i => new { ProductId = i.ProductId, Quantity = (int)i.Quantity })
                .ToList();

            if (!items.Any())
            {
                ShowNotification("Добавьте хотя бы один товар", "warning");
                return;
            }

            var body = new { CustomerEmail = _newOrderEmail, Items = items };
            var r = await Http.PostAsJsonAsync("api/Order/create-order", body);
            if (r.IsSuccessStatusCode)
            {
                await LogAction("Создание", $"Заказ для «{_newOrderEmail}» ({items.Count} поз.)");
                ShowNotification("Заказ создан");
                _showOrderModal = false;
                _newOrderEmail = ""; _newOrderItems.Clear();
                _orderPage = 0;
                await LoadOrders();
            }
            else
            {
                var error = await r.Content.ReadAsStringAsync();
                ShowNotification($"Ошибка: {error}", "danger");
            }
        }
        catch (Exception ex) { ShowNotification($"Ошибка: {ex.Message}", "danger"); }
        finally { _creatingOrder = false; }
    }

