    private async Task SaveNotificationSettings(NotificationSettingsDto settings)
    {
        var body = new { settings.Email, settings.TelegramBotToken, settings.TelegramChatId, settings.Branch, settings.AdminEmails, settings.NotifyOnNewOrder, settings.NotifyOnStatusChange, settings.NotifyOnLowStock, settings.LowStockThreshold };
        try
        {
            if (settings.Id == 0)
            {
                var r = await Http.PostAsJsonAsync("api/NotificationSettings", body);
                if (r.IsSuccessStatusCode)
                {
                    var created = await r.Content.ReadFromJsonAsync<NotificationSettingsDto>();
                    if (created != null) { settings.Id = created.Id; }
                    ShowNotification($"Настройка «{settings.Branch}» создана");
                    StateHasChanged();
                }
                else ShowNotification($"Ошибка: {await r.Content.ReadAsStringAsync()}", "danger");
            }
            else
            {
                var r = await Http.PutAsJsonAsync($"api/NotificationSettings?id={settings.Id}", body);
                if (r.IsSuccessStatusCode)
                {
                    ShowNotification($"Настройка «{settings.Branch}» обновлена");
                    StateHasChanged();
                }
                else ShowNotification($"Ошибка: {await r.Content.ReadAsStringAsync()}", "danger");
            }
        }
        catch (Exception ex) { ShowNotification($"Ошибка: {ex.Message}", "danger"); }
    }

    private async Task DeleteNotificationSettings(NotificationSettingsDto settings)
    {
        if (settings.Id > 0)
        {
            var r = await Http.DeleteAsync($"api/NotificationSettings?id={settings.Id}");
            if (r.IsSuccessStatusCode) ShowNotification($"Настройка «{settings.Branch}» удалена");
        }
        _notificationSettings.Remove(settings);
    }

    private static string StatusBadge(StatusProduct s) => s switch
    {
        StatusProduct.InStock => "bg-success",
        StatusProduct.OutOfStock => "bg-secondary",
        _ => "bg-info"
    };

    private static string StatusText(StatusProduct s) => s switch
    {
        StatusProduct.InStock => "В наличии",
        StatusProduct.OutOfStock => "Нет в наличии",
        _ => "Скоро в продаже"
    };
    private static string ActionBadge(string t) => t switch { "Создание" => "bg-success", "Удаление" => "bg-danger", "Изменение" => "bg-primary", _ => "bg-secondary" };
    private static string ActionColor(string t) => t switch { "Создание" => "#198754", "Удаление" => "#dc3545", "Изменение" => "#0d6efd", _ => "#6c757d" };
    private static string OrderBadge(StatusOrder s) => s switch
    {
        StatusOrder.Pending => "bg-secondary",
        StatusOrder.AwaitingPayment => "bg-warning text-dark",
        StatusOrder.Paid => "bg-info",
        StatusOrder.Manufactured => "bg-primary",
        StatusOrder.Completed => "bg-success",
        _ => "bg-secondary"
    };

