        try
        {
            var body = new { Email = _newUserEmail, Password = _newUserPassword };
            var url = _newUserRole == "Admin" ? "api/User/create-admin" : "api/User/create-student";
            var r = await Http.PostAsJsonAsync(url, body);
            if (r.IsSuccessStatusCode)
            {
                var user = await r.Content.ReadFromJsonAsync<UserDto>();
                if (user != null) Users.Add(user);
                _userTotalCount++;
                await LogAction("Создание", $"Пользователь «{_newUserEmail}» ({_newUserRole})");
                ShowNotification("Пользователь создан");
                _showUserModal = false;
                _newUserEmail = ""; _newUserPassword = ""; _newUserRole = "Student";
                StateHasChanged();
            }
            else ShowNotification($"Ошибка: {await r.Content.ReadAsStringAsync()}", "danger");
        }
        catch (Exception ex) { ShowNotification($"Ошибка: {ex.Message}", "danger"); }
        finally { _creatingUser = false; }
    }

