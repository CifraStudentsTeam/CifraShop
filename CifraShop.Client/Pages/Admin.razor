@page "/admin"
@using System.Net.Http.Json
@implements IDisposable
@inject HttpClient Http

<PageTitle>Админ-панель — CifraShop</PageTitle>

<div class="container-fluid px-3 py-2">

    <!-- ШАПКА -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="fw-bold mb-0"><i class="bi bi-grid-3x3-gap me-2"></i>Админ-панель</h5>
        <span class="text-secondary small">Авто-обновление каждые 30 сек</span>
    </div>

    <!-- УВЕДОМЛЕНИЯ -->
    @if (!string.IsNullOrEmpty(_notification))
    {
        <div class="alert alert-@_notificationType alert-dismissible fade show py-2 small" role="alert">
            <i class="bi bi-@(_notificationType == "success" ? "check-circle-fill" : "exclamation-triangle-fill") me-1"></i>
            @_notification
            <button type="button" class="btn-close btn-close-sm" @onclick="() => _notification = null"></button>
        </div>
    }

    <!-- МЕТРИКИ -->
    <div class="row g-2 mb-3">
        <MetricCard Title="Товаров" Count="@_productTotalCount" Icon="bi-box" Color="primary" />
        <MetricCard Title="Заказы" Count="@_orderTotalCount" Icon="bi-cart-check" Color="warning" />
        <MetricCard Title="Пользователи" Count="@_userTotalCount" Icon="bi-people" Color="success" />
    </div>

    <!-- ==================== ТОВАРЫ ==================== -->
    <div class="row g-3 mb-3">
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-header bg-white border-0 pt-3 px-3 d-flex justify-content-between align-items-center">
                    <h6 class="fw-semibold mb-0">Товары</h6>
                    <button class="btn btn-primary btn-sm" @onclick="() => OpenProductModal()">
                        <i class="bi bi-plus-lg me-1"></i>Добавить
                    </button>
                </div>
                <div class="card-body pt-0">
                    <SearchBar Value="@_productSearch" ValueChanged="OnProductSearchChanged"
                               FilterValue="@_productFilter" FilterValueChanged="OnProductFilterChanged"
                               Placeholder="Название, описание...">
                        <option value="">Все</option>
                        <option value="0">В наличии</option>
                        <option value="1">Нет в наличии</option>
                        <option value="2">Скоро</option>
                    </SearchBar>

                    @if (Products.Any(p => p.IsSelected))
                    {
                        <div class="d-flex gap-2 mb-2 p-2 bg-light rounded flex-wrap">
                            <span class="small text-secondary me-auto align-self-center">Выбрано: @Products.Count(p => p.IsSelected)</span>
                            <button class="btn btn-outline-success btn-sm" @onclick="ShowSelectedProducts">
                                <i class="bi bi-eye me-1"></i>Показать
                            </button>
                            <button class="btn btn-outline-secondary btn-sm" @onclick="HideSelectedProducts">
                                <i class="bi bi-eye-slash me-1"></i>Скрыть
                            </button>
                            <button class="btn btn-outline-danger btn-sm" @onclick="DeleteSelectedProducts">
                                <i class="bi bi-trash me-1"></i>Удалить
                            </button>
                        </div>
                    }

                    @if (_loadingProducts)
                    {
                        <Spinner />
                    }
                    else if (!Products.Any())
                    {
                        <EmptyState />
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-sm align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th style="width:2.25rem">
                                            <input type="checkbox" class="form-check-input"
                                                   checked="@(IsAllProductsSelected)"
                                                   indeterminate="@(IsProductPartialSelected)"
                                                   @onchange="ToggleSelectAllProducts" />
                                        </th>
                                        <th>Товар</th>
                                        <th style="width:4rem;">Цена</th>
                                        <th style="width:5rem;">Склад</th>
                                        <th style="width:6rem;">Статус</th>
                                        <th style="width:4rem;"></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var p in Products)
                                    {
                                        <tr class="@(p.Status != 0 ? "opacity-50" : "")">
                                            <td><input type="checkbox" class="form-check-input" @bind="p.IsSelected" /></td>
                                            <td>
                                                <div class="fw-semibold text-truncate" style="max-width:12rem;">@p.Name</div>
                                                @if (!string.IsNullOrEmpty(p.Description))
                                                {
                                                    <small class="text-secondary text-truncate d-block" style="max-width:12rem;">@p.Description</small>
                                                }
                                            </td>
                                            <td>@p.Price ₽</td>
                                            <td>
                                                <input type="number" class="form-control form-control-sm"
                                                       style="width:3.75rem;" value="@p.Quantity"
                                                       @onchange="(ChangeEventArgs e) => OnQuantityChanged(p, e)" />
                                            </td>
                                            <td>
                                                <span class="badge @(StatusBadge(p.Status))"
                                                      style="cursor:pointer"
                                                      @onclick="() => ToggleProductStatus(p)"
                                                      title="Нажмите для смены статуса">
                                                    @StatusText(p.Status)
                                                </span>
                                            </td>
                                            <td class="text-nowrap">
                                                <button class="btn btn-sm btn-outline-primary me-1" title="Редактировать"
                                                        @onclick="() => OpenProductModal(p)">
                                                    <i class="bi bi-pencil"></i>
                                                </button>
                                                <button class="btn btn-sm btn-outline-danger" title="Удалить"
                                                        @onclick="() => DeleteProduct(p)">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mt-2">
                            <small class="text-secondary">@_productTotalCount товар(ов)</small>
                            <Pagination Page="_productPage" TotalPages="@_productTotalPages"
                                         PageChanged="p => { _productPage = p; _ = LoadProducts(); }" />
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- ==================== ЗАКАЗЫ ==================== -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-header bg-white border-0 pt-3 px-3 d-flex justify-content-between align-items-center">
                    <h6 class="fw-semibold mb-0">Заказы</h6>
                    <button class="btn btn-primary btn-sm" @onclick="() => _showOrderModal = true">
                        <i class="bi bi-plus-lg me-1"></i>Создать
                    </button>
                </div>
                <div class="card-body pt-0">
                    <div class="d-flex gap-2 mb-2 flex-wrap">
                        <SearchBar Value="@_orderSearch" ValueChanged="OnOrderSearchChanged"
                                   FilterValue="@_orderFilter" FilterValueChanged="OnOrderFilterChanged"
                                   Placeholder="Номер, email...">
                            <option value="">Все</option>
                            @foreach (var s in OrderStatuses)
                            {
                                <option value="@s.Key">@s.Value</option>
                            }
                        </SearchBar>
                        <input type="date" class="form-control form-control-sm" style="width:auto;"
                               value="@_orderDateFrom" @onchange="OnOrderDateFromChanged" />
                        <input type="date" class="form-control form-control-sm" style="width:auto;"
                               value="@_orderDateTo" @onchange="OnOrderDateToChanged" />
                    </div>

                    @if (Orders.Any(o => o.IsSelected))
                    {
                        <div class="d-flex gap-2 mb-2 p-2 bg-light rounded flex-wrap">
                            <span class="small text-secondary me-auto align-self-center">Выбрано: @Orders.Count(o => o.IsSelected)</span>
                            <select class="form-select form-select-sm" style="width:auto;"
                                    @onchange="e => { if (int.TryParse(e.Value?.ToString(), out int s)) MassChangeOrderStatus(s); }">
                                <option value="">Сменить статус на...</option>
                                @foreach (var s in OrderStatuses)
                                {
                                    <option value="@s.Key">@s.Value</option>
                                }
                            </select>
                        </div>
                    }

                    @if (_loadingOrders)
                    {
                        <Spinner />
                    }
                    else if (!Orders.Any())
                    {
                        <EmptyState />
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-sm align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th style="width:2.25rem">
                                            <input type="checkbox" class="form-check-input"
                                                   checked="@(IsAllOrdersSelected)"
                                                   indeterminate="@(IsOrderPartialSelected)"
                                                   @onchange="ToggleSelectAllOrders" />
                                        </th>
                                        <th>№</th>
                                        <th>Покупатель</th>
                                        <th>Состав</th>
                                        <th>Дата</th>
                                        <th>Сумма</th>
                                        <th>Статус</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var o in Orders)
                                    {
                                        var items = string.Join(", ", o.Items.Select(i => $"{i.Quantity}\u00d7{i.ProductName}"));
                                        var isExpanded = _expandedOrderId == o.Id;
                                        <tr style="cursor:pointer" @onclick="() => ToggleOrderExpand(o.Id)"
                                            class="@(isExpanded ? "table-active" : "")">
                                            <td @onclick:stopPropagation="true">
                                                <input type="checkbox" class="form-check-input" @bind="o.IsSelected" />
                                            </td>
                                            <td class="fw-semibold">#@o.Id</td>
                                            <td class="text-truncate" style="max-width:7.5rem;">@o.CustomerLogin</td>
                                            <td><small class="text-truncate d-block" style="max-width:9rem;">@items</small></td>
                                            <td><small>@o.DateOfPurchase.ToString("dd.MM.yy")</small></td>
                                            <td>@o.Sum ₽</td>
                                            <td @onclick:stopPropagation="true">
                                                <select class="form-select form-select-sm py-0"
                                                        value="@o.Status"
                                                        @onchange="e => ChangeOrderStatus(o, int.Parse(e.Value!.ToString()!))">
                                                    @foreach (var s in OrderStatuses)
                                                    {
                                                        <option value="@s.Key" selected="@(o.Status.ToString() == s.Key)">@s.Value</option>
                                                    }
                                                </select>
                                            </td>
                                        </tr>
                                        @if (isExpanded)
                                        {
                                            <tr>
                                                <td colspan="7" class="bg-light p-3">
                                                    <div class="small">
                                                        <div class="fw-semibold mb-1">Состав заказа:</div>
                                                        @if (o.Items.Any())
                                                        {
                                                            @foreach (var item in o.Items)
                                                            {
                                                                <div class="d-flex justify-content-between">
                                                                    <span>@item.ProductName (@item.Quantity шт. × @item.Price ₽)</span>
                                                                    <span class="fw-semibold">@item.Total ₽</span>
                                                                </div>
                                                            }
                                                            <div class="border-top mt-1 pt-1 fw-bold d-flex justify-content-between">
                                                                <span>Итого:</span>
                                                                <span>@o.Items.Sum(i => i.Total) ₽</span>
                                                            </div>
                                                        }
                                                        else
                                                        {
                                                            <span class="text-secondary">Нет позиций</span>
                                                        }
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mt-2">
                            <small class="text-secondary">@_orderTotalCount заказ(ов)</small>
                            <Pagination Page="_orderPage" TotalPages="@_orderTotalPages"
                                         PageChanged="p => { _orderPage = p; _ = LoadOrders(); }" />
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- ==================== ПОЛЬЗОВАТЕЛИ ==================== -->
    <div class="row g-3 mb-3">
        <div class="col-12">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-header bg-white border-0 pt-3 px-3 d-flex justify-content-between align-items-center">
                    <h6 class="fw-semibold mb-0">Пользователи</h6>
                    <button class="btn btn-primary btn-sm" @onclick="() => _showUserModal = true">
                        <i class="bi bi-plus-lg me-1"></i>Добавить
                    </button>
                </div>
                <div class="card-body pt-0">
                    <SearchBar Value="@_userSearch" ValueChanged="OnUserSearchChanged"
                               FilterValue="@_userFilter" FilterValueChanged="OnUserFilterChanged"
                               Placeholder="Email...">
                        <option value="">Все</option>
                        <option value="0">Студенты</option>
                        <option value="1">Админы</option>
                    </SearchBar>

                    @if (_loadingUsers)
                    {
                        <Spinner />
                    }
                    else if (!Users.Any())
                    {
                        <EmptyState />
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-sm align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Email</th>
                                        <th>Баланс</th>
                                        <th>Роль</th>
                                        <th style="width:5rem;"></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var u in Users)
                                    {
                                        <tr>
                                            <td class="text-truncate" style="max-width:15rem;">@u.Email</td>
                                            <td>
                                                <span style="cursor:pointer" @onclick="() => OpenEditUserModal(u)">
                                                    @(u.Balance?.ToString() ?? "—")
                                                </span>
                                            </td>
                                            <td>
                                                <span class="badge @(u.Role == 1 ? "bg-warning text-dark" : "bg-info")">
                                                    @(u.Role == 1 ? "Админ" : "Студент")
                                                </span>
                                            </td>
                                            <td>
                                                <button class="btn btn-sm btn-outline-danger" title="Удалить"
                                                        @onclick="() => DeleteUser(u)">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mt-2">
                            <small class="text-secondary">@_userTotalCount пользовател(ей)</small>
                            <Pagination Page="_userPage" TotalPages="@_userTotalPages"
                                         PageChanged="p => { _userPage = p; _ = LoadUsers(); }" />
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- ==================== ИСТОРИЯ ДЕЙСТВИЙ ==================== -->
    <div class="row g-3 mb-3">
        <div class="col-12">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-header bg-white border-0 pt-3 px-3 d-flex justify-content-between align-items-center"
                     style="cursor:pointer" @onclick="() => _showHistory = !_showHistory">
                    <h6 class="fw-semibold mb-0">
                        <i class="bi bi-clock-history me-1"></i>История действий (@_actionHistory.Count)
                    </h6>
                    <i class="bi bi-chevron-@(_showHistory ? "up" : "down") text-secondary"></i>
                </div>
                @if (_showHistory)
                {
                    <div class="card-body pt-0" style="max-height:15rem;overflow-y:auto;">
                        @if (!_actionHistory.Any())
                        {
                            <div class="text-center py-3 text-secondary small">Нет записей</div>
                        }
                        else
                        {
                            @foreach (var a in _actionHistory)
                            {
                                <div class="d-flex align-items-start gap-2 py-1 border-bottom">
                                    <small class="text-secondary" style="min-width:3.75rem;">@a.CreatedAt.ToString("HH:mm:ss")</small>
                                    <span class="badge @(ActionBadge(a.ActionType))" style="min-width:4rem;text-align:center;">@a.ActionType</span>
                                    <small>@a.Details</small>
                                </div>
                            }
                        }
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- ==================== МОДАЛКА ТОВАРА ==================== -->
    @if (_showProductModal)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);" @onclick="CloseProductModal">
            <div class="modal-dialog modal-dialog-centered" @onclick:stopPropagation="true">
                <div class="modal-content rounded-3 shadow">
                    <div class="modal-header border-0 pb-0">
                        <h6 class="modal-title fw-semibold">
                            <i class="bi bi-@(_editingProduct == null ? "plus-circle" : "pencil-square") me-1"></i>
                            @(_editingProduct == null ? "Новый товар" : "Редактирование товара")
                        </h6>
                        <button type="button" class="btn-close" @onclick="CloseProductModal"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label small fw-medium">Название <span class="text-danger">*</span></label>
                            <input type="text" class="form-control @(_formName.Length > 0 ? "is-valid" : "")"
                                   @bind="_formName" placeholder="Введите название" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-medium">Описание</label>
                            <textarea class="form-control" rows="2" @bind="_formDescription" placeholder="Краткое описание товара"></textarea>
                        </div>
                        <div class="row g-3">
                            <div class="col-6">
                                <label class="form-label small fw-medium">Цена (₽)</label>
                                <input type="number" class="form-control" @bind="_formPrice" min="0" />
                            </div>
                            <div class="col-6">
                                <label class="form-label small fw-medium">Количество</label>
                                <input type="number" class="form-control" @bind="_formQuantity" min="0" />
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer border-0 pt-0">
                        <button type="button" class="btn btn-secondary btn-sm" @onclick="CloseProductModal" disabled="@_saving">Отмена</button>
                        <button type="button" class="btn btn-primary btn-sm"
                                disabled="@(_formName.Length == 0 || _saving)"
                                @onclick="SaveProduct">
                            @if (_saving)
                            {
                                <span class="spinner-border spinner-border-sm me-1"></span>
                            }
                            else
                            {
                                <i class="bi bi-check-lg me-1"></i>
                            }
                            Сохранить
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- МОДАЛКА ПОЛЬЗОВАТЕЛЯ -->
    @if (_showUserModal)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);" @onclick="() => _showUserModal = false">
            <div class="modal-dialog modal-sm modal-dialog-centered" @onclick:stopPropagation="true">
                <div class="modal-content rounded-3 shadow">
                    <div class="modal-header border-0 pb-0">
                        <h6 class="modal-title fw-semibold"><i class="bi bi-person-plus me-1"></i>Новый пользователь</h6>
                        <button type="button" class="btn-close" @onclick="() => _showUserModal = false"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label small fw-medium">Email <span class="text-danger">*</span></label>
                            <input type="email" class="form-control" @bind="_newUserEmail" placeholder="user@example.com" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-medium">Пароль <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" @bind="_newUserPassword" placeholder="Пароль" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-medium">Роль</label>
                            <select class="form-select form-select-sm" @bind="_newUserRole">
                                <option value="Student">Студент</option>
                                <option value="Admin">Админ</option>
                            </select>
                        </div>
                    </div>
                    <div class="modal-footer border-0 pt-0">
                        <button type="button" class="btn btn-secondary btn-sm" @onclick="() => _showUserModal = false">Отмена</button>
                        <button type="button" class="btn btn-primary btn-sm"
                                disabled="@(_newUserEmail.Length == 0 || _newUserPassword.Length == 0)"
                                @onclick="CreateUser">
                            <i class="bi bi-check-lg me-1"></i>Создать
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- МОДАЛКА РЕДАКТИРОВАНИЯ БАЛАНСА -->
    @if (_showEditUserModal && _editingUser != null)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);" @onclick="() => _showEditUserModal = false">
            <div class="modal-dialog modal-sm modal-dialog-centered" @onclick:stopPropagation="true">
                <div class="modal-content rounded-3 shadow">
                    <div class="modal-header border-0 pb-0">
                        <h6 class="modal-title fw-semibold"><i class="bi bi-wallet2 me-1"></i>Баланс — @_editingUser.Email</h6>
                        <button type="button" class="btn-close" @onclick="() => _showEditUserModal = false"></button>
                    </div>
                    <div class="modal-body">
                        <label class="form-label small fw-medium">Баланс</label>
                        <input type="number" class="form-control" @bind="_editBalance" />
                    </div>
                    <div class="modal-footer border-0 pt-0">
                        <button type="button" class="btn btn-secondary btn-sm" @onclick="() => _showEditUserModal = false">Отмена</button>
                        <button type="button" class="btn btn-primary btn-sm" @onclick="SaveUserBalance">
                            <i class="bi bi-check-lg me-1"></i>Сохранить
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- МОДАЛКА СОЗДАНИЯ ЗАКАЗА -->
    @if (_showOrderModal)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);" @onclick="() => _showOrderModal = false">
            <div class="modal-dialog modal-dialog-centered" @onclick:stopPropagation="true">
                <div class="modal-content rounded-3 shadow">
                    <div class="modal-header border-0 pb-0">
                        <h6 class="modal-title fw-semibold"><i class="bi bi-cart-plus me-1"></i>Новый заказ</h6>
                        <button type="button" class="btn-close" @onclick="() => _showOrderModal = false"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label small fw-medium">Email покупателя <span class="text-danger">*</span></label>
                            <input type="email" class="form-control" @bind="_newOrderLogin" placeholder="user@example.com" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-medium">Товары</label>
                            @foreach (var item in _newOrderItems)
                            {
                                <div class="d-flex gap-2 mb-2 align-items-center">
                                    <select class="form-select form-select-sm" style="flex:1;" @bind="item.ProductId">
                                        <option value="0">Выберите товар</option>
                                        @foreach (var p in _allProductsForOrder)
                                        {
                                            <option value="@p.Id">@p.Name (@p.Price ₽)</option>
                                        }
                                    </select>
                                    <input type="number" class="form-control form-control-sm" style="width:4rem;" @bind="item.Quantity" min="1" />
                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => _newOrderItems.Remove(item)">
                                        <i class="bi bi-x"></i>
                                    </button>
                                </div>
                            }
                            <button class="btn btn-sm btn-outline-primary" @onclick="() => _newOrderItems.Add(new OrderItemForm())">
                                <i class="bi bi-plus me-1"></i>Добавить позицию
                            </button>
                        </div>
                    </div>
                    <div class="modal-footer border-0 pt-0">
                        <button type="button" class="btn btn-secondary btn-sm" @onclick="() => _showOrderModal = false">Отмена</button>
                        <button type="button" class="btn btn-primary btn-sm"
                                disabled="@(_newOrderLogin.Length == 0 || !_newOrderItems.Any(i => i.ProductId > 0))"
                                @onclick="CreateOrder">
                            <i class="bi bi-check-lg me-1"></i>Создать
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- МОДАЛКА ПОДТВЕРЖДЕНИЯ -->
    @if (_showConfirmModal)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);" @onclick="CancelConfirm">
            <div class="modal-dialog modal-sm modal-dialog-centered" @onclick:stopPropagation="true">
                <div class="modal-content rounded-3 shadow">
                    <div class="modal-body text-center py-4">
                        <i class="bi bi-exclamation-triangle text-warning fs-1 mb-2 d-block"></i>
                        <p class="mb-3 fw-medium">@_confirmMessage</p>
                        <div class="d-flex gap-2 justify-content-center">
                            <button class="btn btn-secondary btn-sm px-3" @onclick="CancelConfirm">Отмена</button>
                            <button class="btn btn-danger btn-sm px-3" @onclick="ExecuteConfirm">Удалить</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private List<ProductDto> Products = new();
    private List<OrderDto> Orders = new();
    private List<UserDto> Users = new();
    private List<AdminActionDto> _actionHistory = new();
    private List<ProductDto> _allProductsForOrder = new();

    private string? _notification;
    private string _notificationType = "success";
    private bool _loadingProducts = true;
    private bool _loadingOrders = true;
    private bool _loadingUsers = true;
    private bool _saving;

    private int _productTotalCount, _orderTotalCount, _userTotalCount;
    private int _productPage, _orderPage, _userPage;
    private const int PageSize = 8;
    private int _productTotalPages => Math.Max(1, (int)Math.Ceiling(_productTotalCount / (double)PageSize));
    private int _orderTotalPages => Math.Max(1, (int)Math.Ceiling(_orderTotalCount / (double)PageSize));
    private int _userTotalPages => Math.Max(1, (int)Math.Ceiling(_userTotalCount / (double)PageSize));

    private PeriodicTimer? _refreshTimer;

    private static readonly Dictionary<string, string> OrderStatuses = new()
    {
        ["0"] = "Ожидание", ["1"] = "Ожидает оплаты", ["2"] = "Оплачен",
        ["3"] = "В производстве", ["4"] = "Выполнен"
    };

    private string _productSearch = "", _productFilter = "";
    private string _orderSearch = "", _orderFilter = "", _orderDateFrom = "", _orderDateTo = "";
    private string _userSearch = "", _userFilter = "";

    private CancellationTokenSource? _productSearchCts, _orderSearchCts, _userSearchCts;

    private async Task OnProductSearchChanged(string value)
    {
        _productSearch = value;
        _productPage = 0;
        _productSearchCts?.Cancel();
        _productSearchCts = new CancellationTokenSource();
        try { await Task.Delay(300, _productSearchCts.Token); } catch (TaskCanceledException) { return; }
        await LoadProducts();
    }

    private async Task OnProductFilterChanged(string value)
    {
        _productFilter = value;
        _productPage = 0;
        await LoadProducts();
    }

    private async Task OnOrderSearchChanged(string value)
    {
        _orderSearch = value;
        _orderPage = 0;
        _orderSearchCts?.Cancel();
        _orderSearchCts = new CancellationTokenSource();
        try { await Task.Delay(300, _orderSearchCts.Token); } catch (TaskCanceledException) { return; }
        await LoadOrders();
    }

    private async Task OnOrderFilterChanged(string value)
    {
        _orderFilter = value;
        _orderPage = 0;
        await LoadOrders();
    }

    private async Task OnOrderDateFromChanged(ChangeEventArgs e)
    {
        _orderDateFrom = e.Value?.ToString() ?? "";
        _orderPage = 0;
        await LoadOrders();
    }

    private async Task OnOrderDateToChanged(ChangeEventArgs e)
    {
        _orderDateTo = e.Value?.ToString() ?? "";
        _orderPage = 0;
        await LoadOrders();
    }

    private async Task OnUserSearchChanged(string value)
    {
        _userSearch = value;
        _userPage = 0;
        _userSearchCts?.Cancel();
        _userSearchCts = new CancellationTokenSource();
        try { await Task.Delay(300, _userSearchCts.Token); } catch (TaskCanceledException) { return; }
        await LoadUsers();
    }

    private async Task OnUserFilterChanged(string value)
    {
        _userFilter = value;
        _userPage = 0;
        await LoadUsers();
    }

    private bool IsAllProductsSelected => Products.Any() && Products.All(p => p.IsSelected);
    private bool IsProductPartialSelected => Products.Any(p => p.IsSelected) && !IsAllProductsSelected;
    private bool IsAllOrdersSelected => Orders.Any() && Orders.All(o => o.IsSelected);
    private bool IsOrderPartialSelected => Orders.Any(o => o.IsSelected) && !IsAllOrdersSelected;

    private void ToggleSelectAllProducts(ChangeEventArgs e) { var v = (bool)e.Value!; foreach (var p in Products) p.IsSelected = v; }
    private void ToggleSelectAllOrders(ChangeEventArgs e) { var v = (bool)e.Value!; foreach (var o in Orders) o.IsSelected = v; }

    private int? _expandedOrderId;
    private void ToggleOrderExpand(int id) => _expandedOrderId = _expandedOrderId == id ? null : id;

    private bool _showProductModal, _showConfirmModal, _showHistory;
    private bool _showUserModal, _showEditUserModal, _showOrderModal;
    private ProductDto? _editingProduct;
    private UserDto? _editingUser;
    private string _formName = "", _formDescription = "", _confirmMessage = "";
    private short _formPrice, _formQuantity;
    private Func<Task>? _onConfirmAction;

    private string _newUserEmail = "", _newUserPassword = "", _newUserRole = "Student";
    private short _editBalance;
    private string _newOrderLogin = "";
    private List<OrderItemForm> _newOrderItems = new();

    private class OrderItemForm
    {
        public int ProductId { get; set; }
        public short Quantity { get; set; } = 1;
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadAllData();
        await LoadHistory();
        _refreshTimer = new PeriodicTimer(TimeSpan.FromSeconds(30));
        _ = RefreshLoop();
    }

    private async Task RefreshLoop()
    {
        while (_refreshTimer is not null && await _refreshTimer.WaitForNextTickAsync())
        {
            await LoadAllData();
            await InvokeAsync(StateHasChanged);
        }
    }

    public void Dispose()
    {
        _refreshTimer?.Dispose();
        _productSearchCts?.Dispose();
        _orderSearchCts?.Dispose();
        _userSearchCts?.Dispose();
    }

    private async Task LoadAllData()
    {
        await Task.WhenAll(LoadProducts(), LoadOrders(), LoadUsers());
    }

    private async Task LoadProducts()
    {
        try
        {
            _loadingProducts = Products.Count == 0;
            var r = await Http.GetFromJsonAsync<PagedProductResponse>($"api/Product/paged?page={_productPage}&pageSize={PageSize}");
            if (r != null) { Products = r.Items; _productTotalCount = r.TotalCount; }
        }
        catch (Exception ex) { ShowNotification($"Ошибка загрузки товаров: {ex.Message}", "danger"); }
        finally { _loadingProducts = false; }
    }

    private async Task LoadOrders()
    {
        try
        {
            _loadingOrders = Orders.Count == 0;
            var r = await Http.GetFromJsonAsync<PagedOrderResponse>($"api/Order/paged?page={_orderPage}&pageSize={PageSize}");
            if (r != null) { Orders = r.Items; _orderTotalCount = r.TotalCount; }
        }
        catch (Exception ex) { ShowNotification($"Ошибка загрузки заказов: {ex.Message}", "danger"); }
        finally { _loadingOrders = false; }
    }

    private async Task LoadUsers()
    {
        try
        {
            _loadingUsers = Users.Count == 0;
            var r = await Http.GetFromJsonAsync<PagedUserResponse>($"api/User/paged?page={_userPage}&pageSize={PageSize}");
            if (r != null) { Users = r.Items; _userTotalCount = r.TotalCount; }
        }
        catch (Exception ex) { ShowNotification($"Ошибка загрузки пользователей: {ex.Message}", "danger"); }
        finally { _loadingUsers = false; }
    }

    private async Task LoadHistory()
    {
        try { _actionHistory = await Http.GetFromJsonAsync<List<AdminActionDto>>("api/AdminAction/last?count=50") ?? new(); }
        catch { }
    }

    private async Task LogAction(string type, string details)
    {
        try { await Http.PostAsJsonAsync("api/AdminAction", new { ActionType = type, Details = details }); }
        catch { }
        _actionHistory.Insert(0, new AdminActionDto { ActionType = type, Details = details, CreatedAt = DateTime.Now });
        if (_actionHistory.Count > 50) _actionHistory.RemoveAt(_actionHistory.Count - 1);
        await InvokeAsync(StateHasChanged);
    }

    private void ShowNotification(string message, string type = "success")
    {
        _notification = message; _notificationType = type;
        _ = Task.Delay(4000).ContinueWith(_ => { if (_notification == message) _notification = null; InvokeAsync(StateHasChanged); });
    }

    private void ShowConfirm(string message, Func<Task> action)
    { _confirmMessage = message; _onConfirmAction = action; _showConfirmModal = true; }

    private void CancelConfirm() { _showConfirmModal = false; _onConfirmAction = null; }
    private async Task ExecuteConfirm()
    { _showConfirmModal = false; if (_onConfirmAction is not null) await _onConfirmAction(); _onConfirmAction = null; }

    private void OpenProductModal(ProductDto? product = null)
    {
        _editingProduct = product;
        _formName = product?.Name ?? ""; _formDescription = product?.Description ?? "";
        _formPrice = product?.Price ?? 0; _formQuantity = product?.Quantity ?? 0;
        _showProductModal = true;
    }

    private void CloseProductModal() => _showProductModal = false;

    private async Task SaveProduct()
    {
        _saving = true;
        try
        {
            var body = new { Name = _formName, Description = _formDescription, Price = _formPrice, Quantity = _formQuantity };
            if (_editingProduct == null)
            {
                var r = await Http.PostAsJsonAsync("api/Product/create-product", body);
                if (r.IsSuccessStatusCode)
                {
                    var c = await r.Content.ReadFromJsonAsync<ProductDto>();
                    if (c != null) Products.Add(c);
                    await LogAction("Создание", $"Товар «{_formName}»");
                    ShowNotification("Товар создан");
                    CloseProductModal();
                }
                else ShowNotification($"Ошибка: {await r.Content.ReadAsStringAsync()}", "danger");
            }
            else
            {
                var r = await Http.PutAsJsonAsync($"api/Product/update-product?id={_editingProduct.Id}", body);
                if (r.IsSuccessStatusCode)
                {
                    (_editingProduct.Name, _editingProduct.Description, _editingProduct.Price, _editingProduct.Quantity)
                        = (_formName, _formDescription, _formPrice, _formQuantity);
                    await LogAction("Изменение", $"Товар #{_editingProduct.Id} «{_formName}»");
                    ShowNotification("Товар обновлён");
                    CloseProductModal();
                }
                else ShowNotification($"Ошибка: {await r.Content.ReadAsStringAsync()}", "danger");
            }
        }
        catch (Exception ex) { ShowNotification($"Ошибка: {ex.Message}", "danger"); }
        finally { _saving = false; }
    }

    private async Task OnQuantityChanged(ProductDto product, ChangeEventArgs e)
    {
        var oldQuantity = product.Quantity;
        if (short.TryParse(e.Value?.ToString(), out short q) && product.Quantity != q)
        {
            var r = await Http.PutAsJsonAsync($"api/Product/update-product?id={product.Id}", new { Quantity = q });
            if (r.IsSuccessStatusCode)
            {
                product.Quantity = q;
                await LogAction("Изменение", $"«{product.Name}»: склад = {q}");
                ShowNotification($"«{product.Name}»: количество = {q}");
            }
            else
            {
                product.Quantity = oldQuantity;
                ShowNotification($"Не удалось обновить количество «{product.Name}»", "danger");
            }
        }
    }

    private async Task ToggleProductStatus(ProductDto product)
    {
        var newStatus = product.Status switch { 0 => 1, 1 => 2, _ => 0 };
        var r = await Http.PutAsJsonAsync($"api/Product/update-product?id={product.Id}", new { Status = newStatus });
        if (r.IsSuccessStatusCode) { product.Status = newStatus; await LogAction("Изменение", $"«{product.Name}»: {StatusText(newStatus)}"); ShowNotification($"«{product.Name}»: {StatusText(newStatus)}"); }
    }

    private void DeleteProduct(ProductDto product)
    {
        ShowConfirm($"Удалить «{product.Name}»?", async () =>
        {
            var r = await Http.DeleteAsync($"api/Product/delete-product?id={product.Id}");
            if (r.IsSuccessStatusCode) { Products.Remove(product); _productTotalCount--; await LogAction("Удаление", $"Товар «{product.Name}»"); ShowNotification("Товар удалён"); StateHasChanged(); }
        });
    }

    private void DeleteSelectedProducts()
    {
        var sel = Products.Where(p => p.IsSelected).ToList();
        ShowConfirm($"Удалить {sel.Count} товар(ов)?", async () =>
        {
            var ids = sel.Select(p => p.Id).ToList();
            var r = await Http.PostAsJsonAsync("api/Product/batch-delete", new { ProductIds = ids });
            if (r.IsSuccessStatusCode)
            {
                foreach (var p in sel) Products.Remove(p);
                _productTotalCount -= sel.Count;
                await LogAction("Удаление", $"{sel.Count} товар(ов)");
                ShowNotification($"Удалено: {sel.Count} товар(ов)");
                StateHasChanged();
            }
        });
    }

    private async Task ShowSelectedProducts() => await SetSelectedStatus(0);
    private async Task HideSelectedProducts() => await SetSelectedStatus(1);

    private async Task SetSelectedStatus(int status)
    {
        var sel = Products.Where(p => p.IsSelected).ToList();
        var ids = sel.Select(p => p.Id).ToList();
        var r = await Http.PostAsJsonAsync("api/Order/batch-update-status", new { OrderIds = ids, NewStatus = status });
        if (r.IsSuccessStatusCode) foreach (var p in sel) p.Status = status;
        await LogAction("Изменение", $"{sel.Count} товар(ов): {StatusText(status)}");
        ShowNotification($"Обновлено: {sel.Count} товар(ов)");
        StateHasChanged();
    }

    private async Task ChangeOrderStatus(OrderDto order, int newStatus)
    {
        if (!OrderStatuses.ContainsKey(newStatus.ToString())) return;
        var r = await Http.PutAsJsonAsync($"api/Order/update-order?id={order.Id}", new { Status = newStatus });
        if (r.IsSuccessStatusCode) { order.Status = newStatus; await LogAction("Изменение", $"Заказ #{order.Id}: статус = {OrderStatuses[newStatus.ToString()]}"); ShowNotification($"Заказ #{order.Id}: статус изменён"); }
    }

    private async Task MassChangeOrderStatus(int newStatus)
    {
        if (!OrderStatuses.ContainsKey(newStatus.ToString())) return;
        var sel = Orders.Where(o => o.IsSelected).ToList();
        var ids = sel.Select(o => o.Id).ToList();
        var r = await Http.PostAsJsonAsync("api/Order/batch-update-status", new { OrderIds = ids, NewStatus = newStatus });
        if (r.IsSuccessStatusCode) foreach (var o in sel) o.Status = newStatus;
        await LogAction("Изменение", $"{sel.Count} заказ(ов): {OrderStatuses[newStatus.ToString()]}");
        ShowNotification($"Обновлено: {sel.Count} заказ(ов)");
        StateHasChanged();
    }

    private async Task CreateUser()
    {
        var body = new { Email = _newUserEmail, Password = _newUserPassword };
        var url = _newUserRole == "Admin" ? "api/User/create-admin" : "api/User/create-student";
        var r = await Http.PostAsJsonAsync(url, body);
        if (r.IsSuccessStatusCode)
        {
            var user = await r.Content.ReadFromJsonAsync<UserDto>();
            if (user != null) Users.Add(user);
            _userTotalCount++;
            await LogAction("Создание", $"Пользователь «{_newUserEmail}» ({_newUserRole})");
            ShowNotification("Пользователь создан");
            _showUserModal = false;
            _newUserEmail = ""; _newUserPassword = ""; _newUserRole = "Student";
            StateHasChanged();
        }
        else ShowNotification($"Ошибка: {await r.Content.ReadAsStringAsync()}", "danger");
    }

    private void OpenEditUserModal(UserDto user)
    {
        _editingUser = user;
        _editBalance = user.Balance ?? 0;
        _showEditUserModal = true;
    }

    private async Task SaveUserBalance()
    {
        if (_editingUser == null) return;
        var r = await Http.PutAsJsonAsync($"api/User?id={_editingUser.Id}", new { Balance = _editBalance });
        if (r.IsSuccessStatusCode)
        {
            _editingUser.Balance = _editBalance;
            await LogAction("Изменение", $"Баланс «{_editingUser.Email}» = {_editBalance}");
            ShowNotification("Баланс обновлён");
            _showEditUserModal = false;
            StateHasChanged();
        }
    }

    private async Task DeleteUser(UserDto user)
    {
        ShowConfirm($"Удалить «{user.Email}»?", async () =>
        {
            var r = await Http.DeleteAsync($"api/User?id={user.Id}");
            if (r.IsSuccessStatusCode) { Users.Remove(user); _userTotalCount--; await LogAction("Удаление", $"Пользователь «{user.Email}»"); ShowNotification($"Пользователь «{user.Email}» удалён"); StateHasChanged(); }
        });
    }

    private async Task CreateOrder()
    {
        var items = _newOrderItems.Where(i => i.ProductId > 0).Select(i => new { ProductId = i.ProductId, Quantity = i.Quantity }).ToList();
        var body = new { CustomerLogin = _newOrderLogin, Items = items };
        var r = await Http.PostAsJsonAsync("api/Order/create-order", body);
        if (r.IsSuccessStatusCode)
        {
            await LogAction("Создание", $"Заказ для «{_newOrderLogin}» ({items.Count} поз.)");
            ShowNotification("Заказ создан");
            _showOrderModal = false;
            _newOrderLogin = ""; _newOrderItems.Clear();
            _orderPage = 0;
            await LoadOrders();
        }
        else ShowNotification($"Ошибка: {await r.Content.ReadAsStringAsync()}", "danger");
    }

    private static string StatusBadge(int s) => s switch { 0 => "bg-success", 1 => "bg-secondary", _ => "bg-info" };
    private static string StatusText(int s) => s switch { 0 => "В наличии", 1 => "Нет", _ => "Скоро" };
    private static string ActionBadge(string t) => t switch { "Создание" => "bg-success", "Удаление" => "bg-danger", "Изменение" => "bg-primary", _ => "bg-secondary" };

    private class PagedProductResponse { public List<ProductDto> Items { get; set; } = new(); public int Page { get; set; } public int PageSize { get; set; } public int TotalCount { get; set; } }
    private class PagedOrderResponse { public List<OrderDto> Items { get; set; } = new(); public int Page { get; set; } public int PageSize { get; set; } public int TotalCount { get; set; } }
    private class PagedUserResponse { public List<UserDto> Items { get; set; } = new(); public int Page { get; set; } public int PageSize { get; set; } public int TotalCount { get; set; } }
}
