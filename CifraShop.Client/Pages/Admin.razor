@page "/admin"
@using System.Net.Http.Json
@implements IDisposable
@inject HttpClient Http

<PageTitle>Админ-панель — CifraShop</PageTitle>

<style>
    .autocomplete-wrap { position: relative; }
    .autocomplete-list { position: absolute; top: 100%; left: 0; right: 0; z-index: 1050; background: #fff; border: 1px solid #dee2e6; border-top: 0; border-radius: 0 0 0.375rem 0.375rem; max-height: 12rem; overflow-y: auto; box-shadow: 0 4px 8px rgba(0,0,0,.1); }
    .autocomplete-list .autocomplete-item { padding: 0.4rem 0.75rem; cursor: pointer; font-size: 0.85rem; }
    .autocomplete-list .autocomplete-item:hover { background: #e9ecef; }
    .editable-cell { cursor: pointer; border-bottom: 1px dashed #dee2e6; }
    .editable-cell:hover { border-bottom-color: #0d6efd; }
</style>

<div class="container-fluid px-3 py-2">

    <!-- УВЕДОМЛЕНИЕ (Toast) -->
    @if (!string.IsNullOrEmpty(_notification))
    {
        <div class="alert alert-@_notificationType alert-dismissible fade show py-2 small" role="alert">
            <i class="bi bi-@(_notificationType == "success" ? "check-circle-fill" : "exclamation-triangle-fill") me-1"></i>
            @_notification
            <button type="button" class="btn-close btn-close-sm" @onclick="() => _notification = null"></button>
        </div>
    }

    <!-- ШАПКА + МЕТРИКИ -->
    <div class="d-flex justify-content-between align-items-center mb-2">
        <div class="d-flex align-items-center gap-3">
            <h5 class="fw-bold mb-0"><i class="bi bi-grid-3x3-gap me-1"></i>Админ-панель</h5>
            @if (_lastUpdated.HasValue)
            {
                <small class="text-secondary"><i class="bi bi-arrow-clockwise me-1"></i>Обновлено @_lastUpdated.Value.ToString("HH:mm:ss")</small>
            }
        </div>
        <div class="d-flex align-items-center gap-2">
            <small class="text-secondary">Филиал:</small>
            <select class="form-select form-select-sm" style="width:auto;" @bind="_selectedBranch">
                <option value="">Все филиалы</option>
                @foreach (var branch in _notificationSettings.Select(s => s.Branch).Distinct().OrderBy(b => b))
                {
                    <option value="@branch">@branch</option>
                }
            </select>
        </div>
    </div>
    <div class="row g-2 mb-3">
        <MetricCard Title="Товаров" Count="@_productTotalCount" Subtitle="@_lowStockSubtitle" Icon="bi-box" Color="primary" />
        <MetricCard Title="Заказы" Count="@_orderTotalCount" Subtitle="@($"{_totalRevenue:N0} ₽ выручка")" Icon="bi-cart-check" Color="warning" />
        <MetricCard Title="Пользователи" Count="@_userTotalCount" Subtitle="@($"{_adminCount} админ(ов)")" Icon="bi-people" Color="success" />
        <MetricCard Title="Филиалы" Count="@_notificationSettings.Count" Subtitle="@($"{_configuredFilials} с настройками")" Icon="bi-geo-alt" Color="info" />
    </div>

    <!-- ==================== ТОВАРЫ ==================== -->
    <div class="row g-3 mb-3">
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-header bg-white border-0 pt-3 px-3 d-flex justify-content-between align-items-center">
                    <h6 class="fw-semibold mb-0"><i class="bi bi-box me-1"></i>Товары</h6>
                    <button class="btn btn-primary btn-sm" @onclick="() => OpenProductModal()">
                        <i class="bi bi-plus-lg me-1"></i>Добавить
                    </button>
                </div>
                <div class="card-body pt-0">
                    <SearchBar Value="@_productSearch" ValueChanged="OnProductSearchChanged"
                               FilterValue="@_productFilter" FilterValueChanged="OnProductFilterChanged"
                               Placeholder="Название, описание...">
                        <option value="">Все статусы</option>
                        <option value="0">В наличии</option>
                        <option value="1">Нет в наличии</option>
                        <option value="2">Скоро</option>
                    </SearchBar>

                    @if (Products.Any(p => p.IsSelected))
                    {
                        <div class="d-flex gap-2 mb-2 p-2 bg-light rounded flex-wrap">
                            <span class="small text-secondary me-auto align-self-center">Выбрано: @Products.Count(p => p.IsSelected)</span>
                            <button class="btn btn-outline-success btn-sm" @onclick="ShowSelectedProducts">
                                <i class="bi bi-eye me-1"></i>Показать
                            </button>
                            <button class="btn btn-outline-secondary btn-sm" @onclick="HideSelectedProducts">
                                <i class="bi bi-eye-slash me-1"></i>Скрыть
                            </button>
                            <button class="btn btn-outline-danger btn-sm" @onclick="DeleteSelectedProducts">
                                <i class="bi bi-trash me-1"></i>Удалить
                            </button>
                        </div>
                    }

                    @if (_loadingProducts)
                    {
                        <Spinner />
                    }
                    else if (!Products.Any())
                    {
                        <div class="text-center py-4 text-secondary small">
                            <i class="bi bi-box fs-3 d-block mb-1"></i>
                            @if (!string.IsNullOrEmpty(_productSearch) || !string.IsNullOrEmpty(_productFilter))
                            {
                                <span>Товары не найдены по заданным критериям</span>
                            }
                            else
                            {
                                <span>Товаров пока нет. Добавьте первый товар</span>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-sm align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th style="width:2.25rem">
                                            <input type="checkbox" class="form-check-input"
                                                   checked="@(IsAllProductsSelected)"
                                                   indeterminate="@(IsProductPartialSelected)"
                                                   @onchange="ToggleSelectAllProducts" />
                                        </th>
                                        <th>Товар</th>
                                        <th style="width:4rem;">Цена</th>
                                        <th style="width:5rem;">Склад</th>
                                        <th style="width:6rem;">Статус</th>
                                        <th style="width:4rem;"></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var p in Products)
                                    {
                                        var isLowStock = p.Status == StatusProduct.InStock && p.Quantity <= 5;
                                        var isOutOfStock = p.Status == StatusProduct.OutOfStock;
                                        <tr class="@(isOutOfStock ? "opacity-50" : "") @(isLowStock ? "table-warning" : "")">
                                            <td><input type="checkbox" class="form-check-input" @bind="p.IsSelected" /></td>
                                            <td>
                                                <div class="d-flex align-items-center gap-2">
                                                    @if (!string.IsNullOrEmpty(p.ImageUrl))
                                                    {
                                                        <img src="@p.ImageUrl" alt="@p.Name"
                                                             style="width:2rem;height:2rem;object-fit:cover;border-radius:0.375rem;" />
                                                    }
                                                    else
                                                    {
                                                        <div class="bg-light rounded d-flex align-items-center justify-content-center"
                                                             style="width:2rem;height:2rem;">
                                                            <i class="bi bi-image text-secondary small"></i>
                                                        </div>
                                                    }
                                                    <div>
                                                        <div class="fw-semibold text-truncate" style="max-width:10rem;">
                                                            @p.Name
                                                            @if (isLowStock)
                                                            {
                                                                <i class="bi bi-exclamation-triangle text-warning ms-1" title="Низкий остаток"></i>
                                                            }
                                                        </div>
                                                        @if (!string.IsNullOrEmpty(p.Description))
                                                        {
                                                            <small class="text-secondary text-truncate d-block" style="max-width:10rem;">@p.Description</small>
                                                        }
                                                    </div>
                                                </div>
                                            </td>
                                            <td>@p.Price ₽</td>
                                            <td>
                                                <input type="number" class="form-control form-control-sm @(isLowStock ? "border-warning" : "")"
                                                       style="width:3.75rem;" value="@p.Quantity"
                                                       @onchange="(ChangeEventArgs e) => OnQuantityChanged(p, e)" />
                                            </td>
                                            <td>
                                                <span class="badge @(StatusBadge(p.Status))"
                                                      style="cursor:pointer"
                                                      @onclick="() => ToggleProductStatus(p)"
                                                      title="Нажмите для смены статуса">
                                                    @StatusText(p.Status)
                                                </span>
                                            </td>
                                            <td class="text-nowrap">
                                                <button class="btn btn-sm btn-outline-primary me-1" title="Редактировать"
                                                        @onclick="() => OpenProductModal(p)">
                                                    <i class="bi bi-pencil"></i>
                                                </button>
                                                <button class="btn btn-sm btn-outline-danger" title="Удалить"
                                                        @onclick="() => DeleteProduct(p)">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mt-2">
                            <small class="text-secondary">
                                @_productTotalCount товар(ов)
                                @if (_totalStockValue > 0)
                                {
                                    <span class="ms-2 text-muted">· @_totalStockValue.ToString("N0") ₽ на складе</span>
                                }
                            </small>
                            <Pagination Page="_productPage" TotalPages="@_productTotalPages" Loading="@_loadingProducts"
                                         PageChanged="OnProductPageChanged" />
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- ==================== ЗАКАЗЫ ==================== -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-header bg-white border-0 pt-3 px-3 d-flex justify-content-between align-items-center">
                    <h6 class="fw-semibold mb-0"><i class="bi bi-cart-check me-1"></i>Заказы</h6>
                    <button class="btn btn-primary btn-sm" @onclick="OpenOrderModal">
                        <i class="bi bi-plus-lg me-1"></i>Создать
                    </button>
                </div>
                <div class="card-body pt-0">
                    <div class="d-flex gap-2 mb-2 flex-wrap align-items-center">
                        <SearchBar Value="@_orderSearch" ValueChanged="OnOrderSearchChanged"
                                   FilterValue="@_orderFilter" FilterValueChanged="OnOrderFilterChanged"
                                   Placeholder="Номер, email...">
                            <option value="">Все статусы</option>
                            @foreach (var s in OrderStatuses)
                            {
                                <option value="@s.Key">@s.Value</option>
                            }
                        </SearchBar>
                        <div class="d-flex align-items-center gap-1">
                            <small class="text-secondary">с</small>
                            <input type="date" class="form-control form-control-sm" style="width:auto;"
                                   value="@_orderDateFrom" @onchange="OnOrderDateFromChanged" />
                            <small class="text-secondary">по</small>
                            <input type="date" class="form-control form-control-sm" style="width:auto;"
                                   value="@_orderDateTo" @onchange="OnOrderDateToChanged" />
                        </div>
                    </div>

                    @if (Orders.Any(o => o.IsSelected))
                    {
                        <div class="d-flex gap-2 mb-2 p-2 bg-light rounded flex-wrap">
                            <span class="small text-secondary me-auto align-self-center">Выбрано: @Orders.Count(o => o.IsSelected)</span>
                            <select class="form-select form-select-sm" style="width:auto;"
                                    @onchange="async e => { if (int.TryParse(e.Value?.ToString(), out int s)) await MassChangeOrderStatus((StatusOrder)s); }">
                                <option value="">Сменить статус на...</option>
                                @foreach (var s in OrderStatuses)
                                {
                                    <option value="@s.Key">@s.Value</option>
                                }
                            </select>
                        </div>
                    }

                    @if (_loadingOrders)
                    {
                        <Spinner />
                    }
                    else if (!Orders.Any())
                    {
                        <div class="text-center py-4 text-secondary small">
                            <i class="bi bi-cart fs-3 d-block mb-1"></i>
                            @if (!string.IsNullOrEmpty(_orderSearch) || !string.IsNullOrEmpty(_orderFilter) || !string.IsNullOrEmpty(_orderDateFrom) || !string.IsNullOrEmpty(_orderDateTo))
                            {
                                <span>Заказы не найдены по заданным критериям</span>
                            }
                            else
                            {
                                <span>Заказов пока нет</span>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-sm align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th style="width:2.25rem">
                                            <input type="checkbox" class="form-check-input"
                                                   checked="@(IsAllOrdersSelected)"
                                                   indeterminate="@(IsOrderPartialSelected)"
                                                   @onchange="ToggleSelectAllOrders" />
                                        </th>
                                        <th>№</th>
                                        <th>Покупатель</th>
                                        <th>Состав</th>
                                        <th>Дата</th>
                                        <th>Сумма</th>
                                        <th>Статус</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var o in Orders)
                                    {
                                        var items = string.Join(", ", o.Items.Select(i => $"{i.Quantity}\u00d7{i.ProductName}"));
                                        var isExpanded = _expandedOrderId == o.Id;
                                        <tr style="cursor:pointer" @onclick="() => ToggleOrderExpand(o.Id)"
                                            class="@(isExpanded ? "table-active" : "")">
                                            <td @onclick:stopPropagation="true">
                                                <input type="checkbox" class="form-check-input" @bind="o.IsSelected" />
                                            </td>
                                            <td class="fw-semibold">#@o.Id</td>
                                            <td class="text-truncate" style="max-width:7.5rem;">@o.CustomerEmail</td>
                                            <td><small class="text-truncate d-block" style="max-width:9rem;">@items</small></td>
                                            <td><small>@o.DateOfPurchase.ToString("dd.MM.yy")</small></td>
                                            <td>@o.Sum ₽</td>
                                            <td @onclick:stopPropagation="true">
                                                <select class="form-select form-select-sm py-0"
                                                        value="@((int)o.Status)"
                                                        @onchange="e => ChangeOrderStatus(o, (StatusOrder)int.Parse(e.Value!.ToString()!))">
                                                    @foreach (var s in OrderStatuses)
                                                    {
                                                        <option value="@s.Key" selected="@((int)o.Status).ToString() == s.Key">@s.Value</option>
                                                    }
                                                </select>
                                            </td>
                                        </tr>
                                        @if (isExpanded)
                                        {
                                            <tr>
                                                <td colspan="7" class="bg-light p-3">
                                                    <div class="small">
                                                        <div class="d-flex justify-content-between align-items-center mb-2">
                                                            <div class="fw-semibold">Состав заказа:</div>
                                                            <div class="d-flex gap-2 align-items-center">
                                                                <span class="text-secondary"><i class="bi bi-calendar me-1"></i>@o.DateOfPurchase.ToString("dd.MM.yyyy HH:mm")</span>
                                                                <span class="badge @(OrderBadge(o.Status))">@OrderStatuses[((int)o.Status).ToString()]</span>
                                                            </div>
                                                        </div>
                                                        @if (o.Items.Any())
                                                        {
                                                            @foreach (var item in o.Items)
                                                            {
                                                                <div class="d-flex justify-content-between">
                                                                    <span>@item.ProductName (@item.Quantity шт. × @item.Price ₽)</span>
                                                                    <span class="fw-semibold">@item.Total ₽</span>
                                                                </div>
                                                            }
                                                            <div class="border-top mt-1 pt-1 fw-bold d-flex justify-content-between">
                                                                <span>Итого:</span>
                                                                <span>@o.Items.Sum(i => i.Total) ₽</span>
                                                            </div>
                                                        }
                                                        else
                                                        {
                                                            <span class="text-secondary">Нет позиций</span>
                                                        }
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mt-2">
                            <small class="text-secondary">
                                @_orderTotalCount заказ(ов)
                                @if (_totalRevenue > 0)
                                {
                                    <span class="ms-2 text-muted">· @_totalRevenue.ToString("N0") ₽</span>
                                }
                            </small>
                            <Pagination Page="_orderPage" TotalPages="@_orderTotalPages" Loading="@_loadingOrders"
                                         PageChanged="OnOrderPageChanged" />
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- ==================== ПОЛЬЗОВАТЕЛИ ==================== -->
    <div class="row g-3 mb-3">
        <div class="col-12">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-header bg-white border-0 pt-3 px-3 d-flex justify-content-between align-items-center">
                    <h6 class="fw-semibold mb-0"><i class="bi bi-people me-1"></i>Пользователи</h6>
                    <button class="btn btn-primary btn-sm" @onclick="() => _showUserModal = true">
                        <i class="bi bi-plus-lg me-1"></i>Добавить
                    </button>
                </div>
                <div class="card-body pt-0">
                    <SearchBar Value="@_userSearch" ValueChanged="OnUserSearchChanged"
                               FilterValue="@_userFilter" FilterValueChanged="OnUserFilterChanged"
                               Placeholder="Email...">
                        <option value="">Все роли</option>
                        <option value="0">Студенты</option>
                        <option value="1">Админы</option>
                    </SearchBar>

                    @if (_loadingUsers)
                    {
                        <Spinner />
                    }
                    else if (!Users.Any())
                    {
                        <div class="text-center py-4 text-secondary small">
                            <i class="bi bi-people fs-3 d-block mb-1"></i>
                            @if (!string.IsNullOrEmpty(_userSearch) || !string.IsNullOrEmpty(_userFilter))
                            {
                                <span>Пользователи не найдены по заданным критериям</span>
                            }
                            else
                            {
                                <span>Пользователей пока нет. Создайте первого пользователя</span>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-sm align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th style="width:3rem;">ID</th>
                                        <th>Email</th>
                                        <th style="width:6rem;">Баланс</th>
                                        <th>Роль</th>
                                        <th style="width:6rem;"></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var u in Users)
                                    {
                                        <tr>
                                            <td class="text-secondary small">#@u.Id</td>
                                            <td class="text-truncate" style="max-width:15rem;">@u.Email</td>
                                            <td>
                                                <span class="editable-cell px-1 rounded" @onclick="() => OpenEditUserModal(u)"
                                                      title="Нажмите для редактирования">
                                                    @(u.Balance?.ToString("N0") ?? "0") ₽
                                                    <i class="bi bi-pencil small text-primary ms-1"></i>
                                                </span>
                                            </td>
                                            <td>
                                                <span class="badge @(u.Role == UserRole.Admin ? "bg-warning text-dark" : "bg-info")">
                                                    @(u.Role == UserRole.Admin ? "Админ" : "Студент")
                                                </span>
                                            </td>
                                            <td>
                                                <button class="btn btn-sm btn-outline-danger" title="Удалить"
                                                        @onclick="() => DeleteUser(u)">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mt-2">
                            <small class="text-secondary">@_userTotalCount пользовател(ей)</small>
                            <Pagination Page="_userPage" TotalPages="@_userTotalPages" Loading="@_loadingUsers"
                                         PageChanged="OnUserPageChanged" />
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- ==================== ФИЛИАЛЫ И УВЕДОМЛЕНИЯ + ИСТОРИЯ ==================== -->
    <div class="row g-3 mb-3">
        <!-- Филиалы и уведомления -->
        <div class="col-lg-5">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-header bg-white border-0 pt-3 px-3 d-flex justify-content-between align-items-center">
                    <h6 class="fw-semibold mb-0"><i class="bi bi-geo-alt me-1"></i>Филиалы и уведомления</h6>
                    <div class="d-flex align-items-center gap-2">
                        @if (_notificationSettings.Any())
                        {
                            <small class="text-secondary">@_configuredFilials/@_notificationSettings.Count настроено</small>
                        }
                        <button class="btn btn-outline-primary btn-sm" @onclick="() => _showNotificationModal = true">
                            <i class="bi bi-gear"></i>
                        </button>
                    </div>
                </div>
                <div class="card-body pt-0">
                    @if (!_notificationSettings.Any())
                    {
                        <div class="text-center py-3">
                            <small class="text-secondary"><i class="bi bi-bell-slash me-1"></i>Не настроено</small>
                        </div>
                    }
                    else
                    {
                        @foreach (var s in _notificationSettings)
                        {
                            <div class="d-flex align-items-start gap-2 py-2 border-bottom">
                                <i class="bi bi-geo-alt text-primary mt-1"></i>
                                <div class="flex-grow-1">
                                    <div class="fw-semibold small">@s.Branch</div>
                                    @if (!string.IsNullOrEmpty(s.AdminEmails))
                                    {
                                        <div class="small text-secondary mt-1"><i class="bi bi-person me-1"></i>@s.AdminEmails</div>
                                    }
                                    <div class="d-flex gap-1 flex-wrap mt-1">
                                        @if (!string.IsNullOrEmpty(s.Email))
                                        {
                                            <span class="badge bg-light text-dark border"><i class="bi bi-envelope me-1"></i>Email</span>
                                        }
                                        @if (!string.IsNullOrEmpty(s.TelegramChatId))
                                        {
                                            <span class="badge bg-light text-dark border"><i class="bi bi-telegram me-1"></i>Telegram</span>
                                        }
                                        @if (s.NotifyOnNewOrder)
                                        {
                                            <span class="badge bg-primary bg-opacity-10 text-primary">Заказы</span>
                                        }
                                        @if (s.NotifyOnStatusChange)
                                        {
                                            <span class="badge bg-info bg-opacity-10 text-info">Статус</span>
                                        }
                                        @if (s.NotifyOnLowStock)
                                        {
                                            <span class="badge bg-warning text-dark">Остаток ≤ @s.LowStockThreshold</span>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>

        <!-- История действий -->
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-header bg-white border-0 pt-3 px-3 d-flex justify-content-between align-items-center"
                     style="cursor:pointer" @onclick="() => _showHistory = !_showHistory">
                    <h6 class="fw-semibold mb-0">
                        <i class="bi bi-clock-history me-1"></i>История действий
                        <span class="badge bg-secondary bg-opacity-10 text-secondary ms-1" style="font-size:0.7rem;">@_actionHistory.Count</span>
                    </h6>
                    <div class="d-flex align-items-center gap-2">
                        @if (_actionHistory.Any())
                        {
                            <select class="form-select form-select-sm" style="width:auto;font-size:0.75rem;"
                                    @onchange="OnHistoryTypeFilterChanged" @onclick:stopPropagation="true">
                                <option value="">Все типы</option>
                                <option value="Создание">Создание</option>
                                <option value="Изменение">Изменение</option>
                                <option value="Удаление">Удаление</option>
                            </select>
                            <select class="form-select form-select-sm" style="width:auto;font-size:0.75rem;"
                                    @onchange="OnHistoryBranchFilterChanged" @onclick:stopPropagation="true">
                                <option value="">Все филиалы</option>
                                @foreach (var branch in _availableBranches)
                                {
                                    <option value="@branch">@branch</option>
                                }
                            </select>
                        }
                        <i class="bi bi-chevron-@(_showHistory ? "up" : "down") text-secondary small"></i>
                    </div>
                </div>
                @if (_showHistory)
                {
                    <div class="card-body pt-0" style="max-height:18rem;overflow-y:auto;">
                        @if (!_filteredHistory.Any())
                        {
                            <div class="text-center py-4">
                                <i class="bi bi-clock-history fs-3 text-secondary d-block mb-1"></i>
                                <small class="text-secondary">Нет записей</small>
                            </div>
                        }
                        else
                        {
                            @foreach (var a in _filteredHistory)
                            {
                                <div class="d-flex align-items-start gap-2 py-2 border-bottom">
                                    <div class="d-flex flex-column align-items-center" style="min-width:3.5rem;">
                                        <small class="text-secondary">@a.CreatedAt.ToString("dd.MM")</small>
                                        <small class="fw-semibold">@a.CreatedAt.ToString("HH:mm")</small>
                                    </div>
                                    <div class="mt-1" style="width:3px;min-height:2rem;background:ActionColor(a.ActionType);border-radius:2px;"></div>
                                    <div class="flex-grow-1">
                                        <div class="d-flex align-items-center gap-1 mb-1">
                                            <span class="badge @(ActionBadge(a.ActionType))" style="font-size:0.65rem;">@a.ActionType</span>
                                        </div>
                                        <small class="text-dark">@a.Details</small>
                                    </div>
                                </div>
                            }
                        }
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- ==================== МОДАЛКА ТОВАРА ==================== -->
    @if (_showProductModal)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);" @onclick="CloseProductModal">
            <div class="modal-dialog modal-dialog-centered" @onclick:stopPropagation="true">
                <div class="modal-content rounded-3 shadow">
                    <div class="modal-header border-0 pb-0">
                        <h6 class="modal-title fw-semibold">
                            <i class="bi bi-@(_editingProduct == null ? "plus-circle" : "pencil-square") me-1"></i>
                            @(_editingProduct == null ? "Новый товар" : "Редактирование товара")
                        </h6>
                        <button type="button" class="btn-close" @onclick="CloseProductModal"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label small fw-medium">Название <span class="text-danger">*</span></label>
                            <input type="text" class="form-control @(_formName.Length > 0 ? "is-valid" : "")"
                                   @bind="_formName" placeholder="Введите название" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-medium">Описание</label>
                            <textarea class="form-control" rows="2" @bind="_formDescription" placeholder="Краткое описание товара"></textarea>
                        </div>
                        <div class="row g-3">
                            <div class="col-6">
                                <label class="form-label small fw-medium">Цена (₽)</label>
                                <input type="number" class="form-control" @bind="_formPrice" min="0" />
                            </div>
                            <div class="col-6">
                                <label class="form-label small fw-medium">Количество</label>
                                <input type="number" class="form-control" @bind="_formQuantity" min="0" />
                            </div>
                        </div>
                        <div class="mt-3">
                            <label class="form-label small fw-medium">URL изображения</label>
                            <input type="text" class="form-control" @bind="_formImageUrl" placeholder="https://... или image.jpg" />
                        </div>
                        @if (_editingProduct != null)
                        {
                            <div class="mt-3">
                                <label class="form-label small fw-medium">Фотографии товара</label>
                                <div class="d-flex gap-2 flex-wrap mb-2">
                                    @foreach (var img in _productImages)
                                    {
                                        <div class="position-relative" style="width:5rem;height:5rem;">
                                            <img src="@img.Url" style="width:100%;height:100%;object-fit:cover;border-radius:0.375rem;border:2px solid @(img.IsPrimary ? "#0d6efd" : "#dee2e6");"
                                                 alt="Фото" />
                                            <button class="btn btn-sm position-absolute top-0 end-0 p-0 lh-1"
                                                    style="background:rgba(0,0,0,.5);color:#fff;border-radius:50%;width:1.25rem;height:1.25rem;font-size:.6rem;"
                                                    @onclick="() => DeleteProductImage(img)" title="Удалить">×</button>
                                            @if (!img.IsPrimary)
                                            {
                                                <button class="btn btn-sm position-absolute bottom-0 start-0 p-0 lh-1"
                                                        style="background:rgba(13,110,253,.8);color:#fff;border-radius:50%;width:1.25rem;height:1.25rem;font-size:.6rem;"
                                                        @onclick="() => SetPrimaryImage(img)" title="Сделать главной">★</button>
                                            }
                                        </div>
                                    }
                                </div>
                                <InputFile OnChange="OnImageUpload" accept=".jpg,.jpeg,.png,.webp,.gif" class="form-control form-control-sm" />
                            </div>
                        }
                    </div>
                    <div class="modal-footer border-0 pt-0">
                        <button type="button" class="btn btn-secondary btn-sm" @onclick="CloseProductModal" disabled="@_saving">Отмена</button>
                        <button type="button" class="btn btn-primary btn-sm"
                                disabled="@(_formName.Length == 0 || _saving)"
                                @onclick="SaveProduct">
                            @if (_saving) { <span class="spinner-border spinner-border-sm me-1"></span> }
                            else { <i class="bi bi-check-lg me-1"></i> }
                            Сохранить
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- МОДАЛКА ПОЛЬЗОВАТЕЛЯ -->
    @if (_showUserModal)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);" @onclick="() => _showUserModal = false">
            <div class="modal-dialog modal-sm modal-dialog-centered" @onclick:stopPropagation="true">
                <div class="modal-content rounded-3 shadow">
                    <div class="modal-header border-0 pb-0">
                        <h6 class="modal-title fw-semibold"><i class="bi bi-person-plus me-1"></i>Новый пользователь</h6>
                        <button type="button" class="btn-close" @onclick="() => _showUserModal = false"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label small fw-medium">Email <span class="text-danger">*</span></label>
                            <input type="email" class="form-control" @bind="_newUserEmail" placeholder="user@example.com" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-medium">Пароль <span class="text-danger">*</span></label>
                            <input type="password" class="form-control" @bind="_newUserPassword" placeholder="Минимум 6 символов" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-medium">Роль</label>
                            <select class="form-select form-select-sm" @bind="_newUserRole">
                                <option value="Student">Студент</option>
                                <option value="Admin">Админ</option>
                            </select>
                        </div>
                    </div>
                    <div class="modal-footer border-0 pt-0">
                        <button type="button" class="btn btn-secondary btn-sm" @onclick="() => _showUserModal = false">Отмена</button>
                        <button type="button" class="btn btn-primary btn-sm"
                                disabled="@(_newUserEmail.Length == 0 || _newUserPassword.Length == 0 || _creatingUser)"
                                @onclick="CreateUser">
                            @if (_creatingUser) { <span class="spinner-border spinner-border-sm me-1"></span> }
                            else { <i class="bi bi-check-lg me-1"></i> }
                            Создать
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- МОДАЛКА РЕДАКТИРОВАНИЯ БАЛАНСА -->
    @if (_showEditUserModal && _editingUser != null)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);" @onclick="() => _showEditUserModal = false">
            <div class="modal-dialog modal-sm modal-dialog-centered" @onclick:stopPropagation="true">
                <div class="modal-content rounded-3 shadow">
                    <div class="modal-header border-0 pb-0">
                        <h6 class="modal-title fw-semibold"><i class="bi bi-wallet2 me-1"></i>Баланс — @_editingUser.Email</h6>
                        <button type="button" class="btn-close" @onclick="() => _showEditUserModal = false"></button>
                    </div>
                    <div class="modal-body">
                        <label class="form-label small fw-medium">Баланс (₽)</label>
                        <input type="number" class="form-control" @bind="_editBalance" />
                    </div>
                    <div class="modal-footer border-0 pt-0">
                        <button type="button" class="btn btn-secondary btn-sm" @onclick="() => _showEditUserModal = false">Отмена</button>
                        <button type="button" class="btn btn-primary btn-sm" @onclick="SaveUserBalance" disabled="@_savingBalance">
                            @if (_savingBalance) { <span class="spinner-border spinner-border-sm me-1"></span> }
                            else { <i class="bi bi-check-lg me-1"></i> }
                            Сохранить
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- МОДАЛКА СОЗДАНИЯ ЗАКАЗА -->
    @if (_showOrderModal)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);" @onclick="() => _showOrderModal = false">
            <div class="modal-dialog modal-dialog-centered" @onclick:stopPropagation="true">
                <div class="modal-content rounded-3 shadow">
                    <div class="modal-header border-0 pb-0">
                        <h6 class="modal-title fw-semibold"><i class="bi bi-cart-plus me-1"></i>Новый заказ</h6>
                        <button type="button" class="btn-close" @onclick="() => _showOrderModal = false"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3 autocomplete-wrap">
                            <label class="form-label small fw-medium">Email покупателя <span class="text-danger">*</span></label>
                            <input type="email" class="form-control" @bind="_newOrderEmail" @bind:after="OnOrderEmailInput"
                                   placeholder="Начните вводить email..." autocomplete="off" />
                            @if (_emailSuggestions.Any())
                            {
                                <div class="autocomplete-list">
                                    @foreach (var u in _emailSuggestions)
                                    {
                                        <div class="autocomplete-item" @onclick="() => SelectOrderEmail(u.Email)">
                                            <strong>@u.Email</strong>
                                            <small class="text-secondary ms-1">(@u.Role)</small>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-medium">Товары</label>
                            @foreach (var item in _newOrderItems)
                            {
                                <div class="d-flex gap-2 mb-2 align-items-center">
                                    <select class="form-select form-select-sm" style="flex:1;" @bind="item.ProductId">
                                        <option value="0">Выберите товар</option>
                                        @foreach (var p in _allProductsForOrder.Where(p => p.Status == StatusProduct.InStock))
                                        {
                                            <option value="@p.Id">@p.Name (@p.Price ₽)</option>
                                        }
                                    </select>
                                    <input type="number" class="form-control form-control-sm" style="width:4rem;" @bind="item.Quantity" min="1" />
                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => _newOrderItems.Remove(item)">
                                        <i class="bi bi-x"></i>
                                    </button>
                                </div>
                            }
                            <button class="btn btn-sm btn-outline-primary" @onclick="() => _newOrderItems.Add(new OrderItemForm())">
                                <i class="bi bi-plus me-1"></i>Добавить позицию
                            </button>
                        </div>
                        @if (_newOrderItems.Any(i => i.ProductId > 0))
                        {
                            <div class="border-top pt-2 small">
                                <div class="d-flex justify-content-between fw-bold">
                                    <span>Итого:</span>
                                    <span>@_newOrderItems.Where(i => i.ProductId > 0).Sum(i => (_allProductsForOrder.FirstOrDefault(p => p.Id == i.ProductId)?.Price ?? 0) * i.Quantity) ₽</span>
                                </div>
                            </div>
                        }
                    </div>
                    <div class="modal-footer border-0 pt-0">
                        <button type="button" class="btn btn-secondary btn-sm" @onclick="() => _showOrderModal = false">Отмена</button>
                        <button type="button" class="btn btn-primary btn-sm"
                                disabled="@(_newOrderEmail.Length == 0 || !_newOrderItems.Any(i => i.ProductId > 0) || _creatingOrder)"
                                @onclick="CreateOrder">
                            @if (_creatingOrder) { <span class="spinner-border spinner-border-sm me-1"></span> }
                            else { <i class="bi bi-check-lg me-1"></i> }
                            Создать
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- МОДАЛКА УВЕДОМЛЕНИЙ -->
    @if (_showNotificationModal)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);"
             @onmousedown="() => _showNotificationModal = false">
            <div class="modal-dialog modal-lg modal-dialog-centered"
                 @onclick:stopPropagation="true"
                 @onmousedown:stopPropagation="true"
                 @onkeydown:stopPropagation="true">
                <div class="modal-content rounded-3 shadow">
                    <div class="modal-header border-0 pb-0">
                        <h6 class="modal-title fw-semibold"><i class="bi bi-bell me-1"></i>Настройки уведомлений</h6>
                        <button type="button" class="btn-close" @onclick="() => _showNotificationModal = false"></button>
                    </div>
                    <div class="modal-body">
                        @if (!_notificationSettings.Any())
                        {
                            <p class="text-secondary small">Уведомления не настроены. Создайте первую настройку для филиала.</p>
                        }
                        @foreach (var s in _notificationSettings)
                        {
                            <div class="border rounded-3 p-3 mb-3">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <h6 class="fw-semibold mb-0"><i class="bi bi-geo-alt me-1"></i>@s.Branch</h6>
                                    <div class="d-flex gap-1">
                                        <button class="btn btn-sm @(s.Id == 0 ? "btn-success" : "btn-outline-primary")" @onclick="() => SaveNotificationSettings(s)">
                                            <i class="bi bi-check-lg me-1"></i>@(s.Id == 0 ? "Создать" : "Сохранить")
                                        </button>
                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteNotificationSettings(s)">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>
                                </div>
                                <div class="row g-2">
                                    <div class="col-12">
                                        <label class="form-label small">Название филиала</label>
                                        <input type="text" class="form-control form-control-sm" @bind="s.Branch" placeholder="Москва, Казань..." />
                                    </div>
                                    <div class="col-12">
                                        <label class="form-label small">Email для уведомлений</label>
                                        <input type="email" class="form-control form-control-sm" @bind="s.Email" placeholder="admin@example.com" />
                                    </div>
                                    <div class="col-6">
                                        <label class="form-label small">Telegram Bot Token</label>
                                        <input type="text" class="form-control form-control-sm" @bind="s.TelegramBotToken" placeholder="123456:ABC..." />
                                    </div>
                                    <div class="col-6">
                                        <label class="form-label small">Telegram Chat ID</label>
                                        <input type="text" class="form-control form-control-sm" @bind="s.TelegramChatId" placeholder="-100123..." />
                                    </div>
                                    <div class="col-12">
                                        <label class="form-label small">Email администраторов филиала</label>
                                        <input type="text" class="form-control form-control-sm" @bind="s.AdminEmails" placeholder="admin1@example.com, admin2@example.com" />
                                        <small class="text-secondary">Через запятую. Определяет, какие админы принадлежат этому филиалу.</small>
                                    </div>
                                    <div class="col-12">
                                        <label class="form-label small fw-medium">Уведомлять о:</label>
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" @bind="s.NotifyOnNewOrder" />
                                            <label class="form-check-label small">Новых заказах</label>
                                        </div>
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" @bind="s.NotifyOnStatusChange" />
                                            <label class="form-check-label small">Смене статуса заказа</label>
                                        </div>
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" @bind="s.NotifyOnLowStock" />
                                            <label class="form-check-label small">Малом остатке на складе</label>
                                        </div>
                                    </div>
                                    @if (s.NotifyOnLowStock)
                                    {
                                        <div class="col-6">
                                            <label class="form-label small">Порог остатка</label>
                                            <input type="number" class="form-control form-control-sm" @bind="s.LowStockThreshold" min="1" />
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                        <button class="btn btn-sm btn-outline-success" @onclick="AddNewNotificationSettings">
                            <i class="bi bi-plus-lg me-1"></i>Добавить филиал
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- МОДАЛКА ПОДТВЕРЖДЕНИЯ -->
    @if (_showConfirmModal)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);" @onclick="CancelConfirm">
            <div class="modal-dialog modal-sm modal-dialog-centered" @onclick:stopPropagation="true">
                <div class="modal-content rounded-3 shadow">
                    <div class="modal-body text-center py-4">
                        <i class="bi bi-exclamation-triangle text-warning fs-1 mb-2 d-block"></i>
                        <p class="mb-3 fw-medium">@_confirmMessage</p>
                        <div class="d-flex gap-2 justify-content-center">
                            <button class="btn btn-secondary btn-sm px-3" @onclick="CancelConfirm">Отмена</button>
                            <button class="btn btn-danger btn-sm px-3" @onclick="ExecuteConfirm">@_confirmButtonText</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private List<ProductDto> Products = new();
    private List<OrderDto> Orders = new();
    private List<UserDto> Users = new();
    private List<UserDto> _allUsersCache = new();
    private List<UserDto> _emailSuggestions = new();
    private List<AdminActionDto> _actionHistory = new();
    private List<NotificationSettingsDto> _notificationSettings = new();
    private List<ProductDto> _allProductsForOrder = new();
    private List<ProductImageDto> _productImages = new();

    private string? _notification;
    private string _notificationType = "success";
    private bool _loadingProducts = true;
    private bool _loadingOrders = true;
    private bool _loadingUsers = true;
    private bool _saving;
    private bool _creatingUser;
    private bool _creatingOrder;
    private bool _savingBalance;

    private int _productTotalCount, _orderTotalCount, _userTotalCount;
    private int _productPage, _orderPage, _userPage;
    private const int PageSize = 8;
    private int _productTotalPages => Math.Max(1, (int)Math.Ceiling(_productTotalCount / (double)PageSize));
    private int _orderTotalPages => Math.Max(1, (int)Math.Ceiling(_orderTotalCount / (double)PageSize));
    private int _userTotalPages => Math.Max(1, (int)Math.Ceiling(_userTotalCount / (double)PageSize));

    private DateTime? _lastUpdated;
    private int _totalRevenue => Orders.Sum(o => (int)o.Sum);
    private int _adminCount => Users.Count(u => u.Role == UserRole.Admin);
    private int _lowStockCount => Products.Count(p => p.Status == StatusProduct.InStock && p.Quantity <= 5);
    private string _lowStockSubtitle => _lowStockCount > 0 ? $"⚠ {_lowStockCount} с низким остатком" : "Все в наличии";
    private int _configuredFilials => _notificationSettings.Count(s => !string.IsNullOrEmpty(s.Email) || !string.IsNullOrEmpty(s.TelegramChatId));
    private int _totalStockValue => Products.Where(p => p.Status == StatusProduct.InStock).Sum(p => (int)p.Price * p.Quantity);

    private PeriodicTimer? _refreshTimer;

    private static readonly Dictionary<string, string> OrderStatuses = new()
    {
        ["0"] = "Ожидание", ["1"] = "Ожидает оплаты", ["2"] = "Оплачен",
        ["3"] = "В производстве", ["4"] = "Выполнен"
    };

    private string _productSearch = "", _productFilter = "";
    private string _orderSearch = "", _orderFilter = "", _orderDateFrom = "", _orderDateTo = "";
    private string _userSearch = "", _userFilter = "";
    private string _historyBranchFilter = "";
    private string _historyTypeFilter = "";
    private string _selectedBranch = "";
    private List<string> _availableBranches = new();

    private CancellationTokenSource? _productSearchCts, _orderSearchCts, _userSearchCts;

    private async Task OnProductSearchChanged(string value)
    {
        _productSearch = value;
        _productPage = 0;
        _productSearchCts?.Cancel();
        _productSearchCts = new CancellationTokenSource();
        try { await Task.Delay(300, _productSearchCts.Token); } catch (TaskCanceledException) { return; }
        await LoadProducts();
    }

    private async Task OnProductFilterChanged(string value)
    {
        _productFilter = value;
        _productPage = 0;
        await LoadProducts();
    }

    private async Task OnOrderSearchChanged(string value)
    {
        _orderSearch = value;
        _orderPage = 0;
        _orderSearchCts?.Cancel();
        _orderSearchCts = new CancellationTokenSource();
        try { await Task.Delay(300, _orderSearchCts.Token); } catch (TaskCanceledException) { return; }
        await LoadOrders();
    }

    private async Task OnOrderFilterChanged(string value)
    {
        _orderFilter = value;
        _orderPage = 0;
        await LoadOrders();
    }

    private async Task OnOrderDateFromChanged(ChangeEventArgs e)
    {
        _orderDateFrom = e.Value?.ToString() ?? "";
        _orderPage = 0;
        await LoadOrders();
    }

    private async Task OnOrderDateToChanged(ChangeEventArgs e)
    {
        _orderDateTo = e.Value?.ToString() ?? "";
        _orderPage = 0;
        await LoadOrders();
    }

    private async Task OnUserSearchChanged(string value)
    {
        _userSearch = value;
        _userPage = 0;
        _userSearchCts?.Cancel();
        _userSearchCts = new CancellationTokenSource();
        try { await Task.Delay(300, _userSearchCts.Token); } catch (TaskCanceledException) { return; }
        await LoadUsers();
    }

    private async Task OnUserFilterChanged(string value)
    {
        _userFilter = value;
        _userPage = 0;
        await LoadUsers();
    }

    private async Task OnProductPageChanged(int page) { _productPage = page; await LoadProducts(); }
    private async Task OnOrderPageChanged(int page) { _orderPage = page; await LoadOrders(); }
    private async Task OnUserPageChanged(int page) { _userPage = page; await LoadUsers(); }

    private bool IsAllProductsSelected => Products.Any() && Products.All(p => p.IsSelected);
    private bool IsProductPartialSelected => Products.Any(p => p.IsSelected) && !IsAllProductsSelected;
    private bool IsAllOrdersSelected => Orders.Any() && Orders.All(o => o.IsSelected);
    private bool IsOrderPartialSelected => Orders.Any(o => o.IsSelected) && !IsAllOrdersSelected;

