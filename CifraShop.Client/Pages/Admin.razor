    private IEnumerable<AdminActionDto> _filteredHistory
    {
        get
        {
            var query = _actionHistory.AsEnumerable();
            if (!string.IsNullOrEmpty(_historyTypeFilter))
                query = query.Where(a => a.ActionType == _historyTypeFilter);
            if (!string.IsNullOrEmpty(_historyBranchFilter))
                query = query.Where(a => a.Branch == _historyBranchFilter);
            return query;
        }
    }

    private async Task LogAction(string type, string details)
    {
        var branch = _selectedBranch;
        if (string.IsNullOrEmpty(branch) && _notificationSettings.Any())
            branch = _notificationSettings.First().Branch;
        try { await Http.PostAsJsonAsync("api/AdminAction", new { ActionType = type, Details = details, Branch = branch }); }
        catch { }
        _actionHistory.Insert(0, new AdminActionDto { ActionType = type, Details = details, Branch = branch ?? "", CreatedAt = DateTime.Now });
        if (_actionHistory.Count > 100) _actionHistory.RemoveAt(_actionHistory.Count - 1);
        await InvokeAsync(StateHasChanged);
    }

    private void ShowNotification(string message, string type = "success")
    {
        _notification = message; _notificationType = type;
        _ = Task.Delay(4000).ContinueWith(_ => { if (_notification == message) _notification = null; InvokeAsync(StateHasChanged); });
    }

