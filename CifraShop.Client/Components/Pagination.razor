@if (TotalPages > 1)
{
    <ul class="pagination pagination-sm mb-0">
        <li class="page-item @(Page == 0 ? "disabled" : "")">
            <button class="page-link" @onclick="Prev" disabled="@(Page == 0 || Loading)">
                <i class="bi bi-chevron-left"></i>
            </button>
        </li>
        @foreach (var idx in GetPageIndices())
        {
            if (idx == -1)
            {
                <li class="page-item disabled"><span class="page-link">...</span></li>
            }
            else
            {
                <li class="page-item @(idx == Page ? "active" : "")">
                    <button class="page-link" @onclick="() => PageChanged.InvokeAsync(idx)" disabled="@(Loading)">@(idx + 1)</button>
                </li>
            }
        }
        <li class="page-item @(Page >= TotalPages - 1 ? "disabled" : "")">
            <button class="page-link" @onclick="Next" disabled="@(Page >= TotalPages - 1 || Loading)">
                <i class="bi bi-chevron-right"></i>
            </button>
        </li>
    </ul>
    @if (Loading)
    {
        <small class="text-secondary ms-2"><span class="spinner-border spinner-border-sm"></span></small>
    }
}

@code {
    [Parameter] public int Page { get; set; }
    [Parameter] public int TotalPages { get; set; }
    [Parameter] public bool Loading { get; set; }
    [Parameter] public EventCallback<int> PageChanged { get; set; }

    private async Task Prev() => await PageChanged.InvokeAsync(Page - 1);
    private async Task Next() => await PageChanged.InvokeAsync(Page + 1);

    private IEnumerable<int> GetPageIndices()
    {
        if (TotalPages <= 7)
        {
            for (int i = 0; i < TotalPages; i++) yield return i;
            yield break;
        }

        yield return 0;

        int start = Math.Max(1, Page - 1);
        int end = Math.Min(TotalPages - 2, Page + 1);

        if (start > 1) yield return -1;

        for (int i = start; i <= end; i++) yield return i;

        if (end < TotalPages - 2) yield return -1;

        yield return TotalPages - 1;
    }
}
