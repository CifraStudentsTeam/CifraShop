@if (TotalPages > 1)
{
    <ul class="pagination pagination-sm mb-0">
        <li class="page-item @(Page == 0 ? "disabled" : "")">
            <button class="page-link" @onclick="Prev" disabled="@(Page == 0)">
                <i class="bi bi-chevron-left"></i>
            </button>
        </li>
        @for (int i = 0; i < TotalPages; i++)
        {
            var idx = i;
            <li class="page-item @(idx == Page ? "active" : "")">
                <button class="page-link" @onclick="() => PageChanged.InvokeAsync(idx)">@(idx + 1)</button>
            </li>
        }
        <li class="page-item @(Page >= TotalPages - 1 ? "disabled" : "")">
            <button class="page-link" @onclick="Next" disabled="@(Page >= TotalPages - 1)">
                <i class="bi bi-chevron-right"></i>
            </button>
        </li>
    </ul>
}

@code {
    [Parameter] public int Page { get; set; }
    [Parameter] public int TotalPages { get; set; }
    [Parameter] public EventCallback<int> PageChanged { get; set; }

    private async Task Prev() => await PageChanged.InvokeAsync(Page - 1);
    private async Task Next() => await PageChanged.InvokeAsync(Page + 1);
}
