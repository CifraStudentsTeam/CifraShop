@page "/profile"
@using BlazorApp1.Services
@inject UserState UserState
@inject NavigationManager Navigation

@if (!UserState.IsLoggedIn)
{
    Navigation.NavigateTo("/login", forceLoad: true);
    return;
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

<style>
    .profile-container {
        background: linear-gradient(145deg, #f6f9fc 0%, #e6f0f5 100%);
        min-height: 100vh;
        padding: 2rem 0;
    }
    .profile-card {
        background: white;
        border-radius: 1.5rem;
        box-shadow: 0 10px 25px rgba(0,0,0,0.1);
        padding: 2rem;
        margin-bottom: 2rem;
    }
    .balance-card {
        background: #1a3b5d;
        color: white;
        border-radius: 1rem;
        padding: 1rem;
        margin-bottom: 1.5rem;
    }
    .btn-topup {
        background: #ffc107;
        color: #1a3b5d;
        border: none;
        border-radius: 2rem;
        font-weight: bold;
        padding: 0.5rem 1rem;
    }
    .btn-topup:hover {
        background: #e0a800;
    }
</style>

<div class="profile-container">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-8">
                <div class="profile-card">
                    <h2 class="mb-4" style="color:#1a3b5d;">Личный кабинет</h2>
                    <div class="row">
                        <div class="col-md-6">
                            <p><strong>Имя:</strong> @UserState.UserName</p>
                            <p><strong>Email:</strong> @UserState.Email</p>
                        </div>
                        <div class="col-md-6">
                            <div class="balance-card">
                                <h5>Баланс Цифракоинов</h5>
                                <p class="h2">🪙 @UserState.Balance</p>
                                <button class="btn btn-topup mt-2" @onclick="TopUp">+ Пополнить на 500</button>
                            </div>
                        </div>
                    </div>
                    <hr />
                    <div class="mt-3">
                        <button class="btn btn-outline-danger" @onclick="Logout">Выйти из аккаунта</button>
                    </div>
                </div>

                <!-- Дополнительная информация: как зарабатывать монеты -->
                <div class="profile-card">
                    <h5>Как зарабатывать Цифракоины?</h5>
                    <ul>
                        <li>Выполняй домашние задания вовремя – +50 монет</li>
                        <li>Отличные оценки на экзаменах – +200 монет</li>
                        <li>Помогай другим студентам – +30 монет</li>
                        <li>Участвуй в хакатонах – до 1000 монет</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private void TopUp()
    {
        UserState.Balance += 500;
    }

    private void Logout()
    {
        UserState.Logout();
        Navigation.NavigateTo("/login");
    }
}