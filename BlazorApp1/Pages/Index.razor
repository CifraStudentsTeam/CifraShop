@page "/"
@using BlazorApp1.Services
@inject UserState UserState
@inject NavigationManager Navigation



<style>
    .accent-bg {
        background: linear-gradient(145deg, #f6f9fc 0%, #e6f0f5 100%);
    }

    .coin-badge {
        background-color: #ffc107;
        color: #1a1e2b;
        font-weight: bold;
        padding: 0.5rem 1rem;
        border-radius: 2rem;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        box-shadow: 0 4px 6px rgba(0,0,0,0.1);
    }

    .product-card {
        transition: transform 0.2s, box-shadow 0.2s;
        border: none;
        border-radius: 1rem;
        overflow: hidden;
        background: white;
    }

        .product-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 12px 20px rgba(0,0,0,0.15);
        }

    .buy-btn {
        background: #1a3b5d;
        border: none;
        border-radius: 2rem;
        padding: 0.5rem 1.5rem;
        font-weight: 600;
        transition: all 0.2s;
    }

        .buy-btn:hover:not(:disabled) {
            background: #0f2a44;
            transform: scale(1.03);
        }

        .buy-btn:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }

    .footer-note {
        border-top: 2px dashed #1a3b5d;
        text-align: center;
        padding: 1.5rem;
        margin-top: 2rem;
        color: #2c3e50;
        font-style: italic;
    }
</style>

<div class="accent-bg min-vh-100 py-4">
    <div class="container">
        <!-- Навбар с балансом -->
        <nav class="navbar navbar-expand-lg mb-4 rounded-3 shadow-sm bg-white px-3 py-2">
            <div class="container-fluid">
                <a class="navbar-brand fw-bold" href="#">
                    <span style="color:#1a3b5d;">Российская Академия «Цифра»</span>
                </a>
                <div class="ms-auto">
                    @if (UserState.IsLoggedIn)
                    {
                        <div class="coin-badge">
                            <span>🪙</span> @UserState.Balance Цифракоинов
                        </div>
                    }
                    else
                    {
                        <div class="coin-badge" style="background: #6c757d;">
                            🔒 Войдите
                        </div>
                    }
                </div>
            </div>
        </nav>

        <h2 class="display-6 fw-semibold mb-4 text-dark">Магазин атрибутики</h2>
        <p class="lead mb-5">Зарабатывай Цифракоины за успехи в учёбе и обменивай на крутые вещи!</p>

        <!-- Сетка товаров -->
        <div class="row g-4">
            @foreach (var product in products)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card product-card h-100 shadow-sm">
                        <div class="card-body d-flex flex-column">
                            <div class="d-flex align-items-center mb-3">
                                <span style="font-size: 2.5rem; margin-right: 1rem;">@product.Icon</span>
                                <h5 class="card-title mb-0 fw-bold">@product.Name</h5>
                            </div>
                            <p class="card-text text-secondary flex-grow-1">@product.Description</p>
                            <div class="d-flex justify-content-between align-items-center mt-3">
                                <span class="badge bg-warning text-dark p-2" style="font-size: 1.1rem;">
                                    🪙 @product.Price
                                </span>
                                <button class="btn buy-btn text-white"
                                        disabled="@(!UserState.IsLoggedIn || UserState.Balance < product.Price)"
                                        @onclick="() => BuyProduct(product)">
                                    Купить
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="footer-note">
            ✨ Сделано с любовью студентами Академии «Цифра» ✨
        </div>
    </div>
</div>

<!-- Всплывающие уведомления -->
@if (!string.IsNullOrEmpty(message))
{
    <div class="position-fixed bottom-0 end-0 p-3" style="z-index: 11">
        <div class="toast show align-items-center text-white bg-success border-0" role="alert">
            <div class="d-flex">
                <div class="toast-body">
                    @message
                </div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" @onclick="() => message = null"></button>
            </div>
        </div>
    </div>
}

@code {
    // Модель товара
    public class Product
    {
        public string Name { get; set; }
        public string Description { get; set; }
        public int Price { get; set; }
        public string Icon { get; set; }
    }

    private string? message;
    private List<Product> products = new List<Product>
    {
        new Product
        {
            Name = "Футболка «Цифровой код»",
            Description = "Качественный хлопок, оригинальный принт с логотипом академии.",
            Price = 500,
            Icon = "👕"
        },
        new Product
        {
            Name = "Кружка «Байт кофе»",
            Description = "Керамическая кружка с терморисунком: меняет цвет от горячего.",
            Price = 300,
            Icon = "☕"
        },
        new Product
        {
            Name = "Стикерпак «Гигабайты»",
            Description = "20 виниловых наклеек с мемами и символикой Цифры.",
            Price = 150,
            Icon = "🖼️"
        },
        new Product
        {
            Name = "Блокнот «Алгоритмы»",
            Description = "Твёрдая обложка, 120 листов, разлиновка в клетку и точку.",
            Price = 250,
            Icon = "📒"
        },
        new Product
        {
            Name = "Носки «Бинарные»",
            Description = "Яркие носки с двоичным кодом. Состав: хлопок 80%, полиэстер 20%.",
            Price = 200,
            Icon = "🧦"
        },
        new Product
        {
            Name = "Рюкзак «Цифра»",
            Description = "Водонепроницаемый рюкзак с отделом для ноутбука до 15.6 дюймов.",
            Price = 1200,
            Icon = "🎒"
        }
    };

    private void BuyProduct(Product product)
    {
        if (!UserState.IsLoggedIn)
        {
            message = "Пожалуйста, войдите в аккаунт.";
            return;
        }

        if (UserState.Balance >= product.Price)
        {
            UserState.Balance -= product.Price;
            message = $"Поздравляем! Вы приобрели {product.Name} за {product.Price} Цифракоинов. 🎉";
        }
        else
        {
            message = "Недостаточно Цифракоинов. Учись лучше и зарабатывай больше! 😊";
        }
    }
}