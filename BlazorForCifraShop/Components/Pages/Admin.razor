        public decimal Сумма { get; set; }
        public СтатусЗаказа Статус { get; set; }
        public DateTime ДатаСоздания { get; set; }
    }

    //Позиция заказа (для формы создания/редактирования)
    public class ПозицияЗаказа
    {
        public int ТоварId { get; set; }
        public int Количество { get; set; }
    }

    //Форма для заказа (используется в модалке)
    public class ФормаЗаказа
    {
        public string EmailПокупателя { get; set; }
        public List<ПозицияЗаказа> Позиции { get; set; } = new();
    }


    public class Пользователь
    {
        public int Id { get; set; }
        public string Имя { get; set; }
        public string Email { get; set; }
