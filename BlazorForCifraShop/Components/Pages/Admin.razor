            new Товар { Id = 4, Артикул = "126", Название = "Футболка", Цена = 2550, Количество = 7, Видим = true },
            new Товар { Id = 5, Артикул = "127", Название = "Кружка", Цена = 350, Количество = 15, Видим = true },
