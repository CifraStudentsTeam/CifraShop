    }


    private List<Товар> всеТовары = new();
    private List<Заказ> всеЗаказы = new();
    private List<Пользователь> всеПользователи = new();


    // МЕТРИКИ
    private int всегоТоваров => всеТовары.Count;
    private int всегоПользователей => всеПользователи.Count;

    // Периоды для верхней метрики "Заказы"
    private record Период(string Значение, string Текст);
    private Период[] периодыЗаказов = new[]
    {
        new Период("today", "сегодня"),
        new Период("yesterday", "вчера"),
        new Период("week", "неделя"),
        new Период("month", "месяц"),
        new Период("year", "год")
    };
    private string выбранныйПериодЗаказов = "today";
    private int количествоЗаказов => выбранныйПериодЗаказов switch
    {
        "today" => 24,
        "yesterday" => 18,
        "week" => 156,
        "month" => 680,
        "year" => 8240,
        _ => 0
    };


    // ФИЛЬТРЫ ДЛЯ ТОВАРОВ
    private string поискТоваров = "";
    private string фильтрСтатусТоваров = "";

    private IEnumerable<Товар> отфильтрованныеТовары =>
        всеТовары
            .Where(т => string.IsNullOrEmpty(поискТоваров) ||
                        т.Название.Contains(поискТоваров, StringComparison.OrdinalIgnoreCase) ||
                        т.Артикул.Contains(поискТоваров))
            .Where(т => фильтрСтатусТоваров switch
            {
                "visible" => т.Видим,
                "hidden" => !т.Видим,
                "out" => т.Количество == 0,
                _ => true
            });


    // ПАГИНАЦИЯ ТОВАРОВ
    private const int РазмерСтраницы = 4;
    private int индексСтраницыТоваров = 0;
    private int всегостраницТоваров => (int)Math.Ceiling(отфильтрованныеТовары.Count() / (double)РазмерСтраницы);
    private IEnumerable<Товар> товарыНаСтранице =>
        отфильтрованныеТовары
            .Skip(индексСтраницыТоваров * РазмерСтраницы)
            .Take(РазмерСтраницы);

    private bool выбратьВсеТовары
    {
        get => товарыНаСтранице.All(т => т.Выбран);
        set
        {
            foreach (var т in товарыНаСтранице)
                т.Выбран = value;
        }
    }


    // ФИЛЬТРЫ ДЛЯ ЗАКАЗОВ
    private string поискЗаказов = "";
    private string фильтрСтатусЗаказов = "";
    private string фильтрПериодЗаказов = "";

    private IEnumerable<Заказ> отфильтрованныеЗаказы =>
        всеЗаказы
            .Where(з => string.IsNullOrEmpty(поискЗаказов) ||
                        з.Номер.Contains(поискЗаказов) ||
                        з.EmailПокупателя.Contains(поискЗаказов, StringComparison.OrdinalIgnoreCase))
            .Where(з => string.IsNullOrEmpty(фильтрСтатусЗаказов) || з.Статус.ToString() == фильтрСтатусЗаказов)
            .Where(з => фильтрПериодЗаказов switch
            {
                "today" => з.ДатаСоздания.Date == DateTime.Today,
                "week" => з.ДатаСоздания >= DateTime.Today.AddDays(-7),
                "month" => з.ДатаСоздания >= DateTime.Today.AddMonths(-1),
                _ => true
            });


    // ПАГИНАЦИЯ ЗАКАЗОВ
    private int индексСтраницыЗаказов = 0;
    private int всегостраницЗаказов => (int)Math.Ceiling(отфильтрованныеЗаказы.Count() / (double)РазмерСтраницы);
    private IEnumerable<Заказ> заказыНаСтранице =>
        отфильтрованныеЗаказы
            .Skip(индексСтраницыЗаказов * РазмерСтраницы)
            .Take(РазмерСтраницы);


    // ФИЛЬТРЫ ДЛЯ ПОЛЬЗОВАТЕЛЕЙ
    private string поискПользователей = "";
    private string фильтрБалансПользователей = "";

    private IEnumerable<Пользователь> отфильтрованныеПользователи =>
        всеПользователи
            .Where(п => string.IsNullOrEmpty(поискПользователей) ||
                        п.Имя.Contains(поискПользователей, StringComparison.OrdinalIgnoreCase) ||
                        п.Email.Contains(поискПользователей, StringComparison.OrdinalIgnoreCase))
            .Where(п => фильтрБалансПользователей == "positive" ? п.Баланс > 0 : true);


    // ПАГИНАЦИЯ ПОЛЬЗОВАТЕЛЕЙ
    private int индексСтраницыПользователей = 0;
    private int всегостраницПользователей => (int)Math.Ceiling(отфильтрованныеПользователи.Count() / (double)РазмерСтраницы);
    private IEnumerable<Пользователь> пользователиНаСтранице =>
        отфильтрованныеПользователи
            .Skip(индексСтраницыПользователей * РазмерСтраницы)
            .Take(РазмерСтраницы);


    // НАСТРОЙКИ УВЕДОМЛЕНИЙ
    private bool уведомлениеEmail = true;
    private bool уведомлениеTelegram = false;
    private string emailДляУведомлений = "admin@shop.com";



    // ПЕРЕМЕННЫЕ ДЛЯ МОДАЛЬНЫХ ОКОН

    // Для товаров
    private int редактируемыйТоварId = 0; // 0 - режим добавления
    private Товар формаТовара = new();

    // Для заказов
    private int редактируемыйЗаказId = 0;
    private ФормаЗаказа формаЗаказа = new();

    // Для начисления средств
    private string поискПользователяДляНачисления = "";
    private Пользователь выбранныйПользовательДляНачисления = null;
    private decimal суммаНачисления;
    private string комментарийНачисления;


    // ИНИЦИАЛИЗАЦИЯ (загрузка тестовых данных)
    protected override async Task OnInitializedAsync()
    {
        await ЗагрузитьДанные();
    }

    private async Task ЗагрузитьДанные()
    {
        // Здесь получать данные из БД
        // Для примера заполняем тестовыми данными

