            new Заказ { Id = 2, Номер = "1002", EmailПокупателя = "petr@mail.com", СоставКратко = "3×Ручка", Сумма = 300, Статус = СтатусЗаказа.Выполнено, ДатаСоздания = DateTime.Today.AddDays(-2) },
