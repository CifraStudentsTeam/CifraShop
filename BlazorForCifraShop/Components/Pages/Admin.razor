                                    <label class="form-label small">Фото (заглушка)</label>
                                    <input type="file" class="form-control" disabled /> @* В реальном проекте здесь загрузка файла *@
                                </div>
                            </div>
                            <div class="modal-footer border-0">
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Отмена</button>
                                <button type="button" class="btn btn-primary" @onclick="СохранитьТовар">Сохранить</button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Модальное окно для создания/редактирования заказа (упрощённая версия) -->
                <div class="modal fade" id="заказМодал" tabindex="-1" aria-hidden="true">
                    <div class="modal-dialog modal-lg">
                        <div class="modal-content rounded-3">
                            <div class="modal-header border-0 pb-0">
                                <h5 class="modal-title">@(редактируемыйЗаказId == 0 ? "Создать заказ" : "Редактировать заказ")</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Закрыть"></button>
                            </div>
                            <div class="modal-body">
                                <!-- Email покупателя -->
                                <div class="mb-3">
                                    <label class="form-label small">Email покупателя</label>
                                    <input type="email" class="form-control" @bind="формаЗаказа.EmailПокупателя" />
                                </div>
                                <!-- Список позиций заказа (упрощённо: одна строка с выбором товара и количеством) -->
                                <div class="mb-3">
                                    <label class="form-label small">Товары</label>
                                    @for (int i = 0; i < формаЗаказа.Позиции.Count; i++)
                                    {
                                        <div class="d-flex gap-2 mb-2">
                                            <select class="form-select" @bind="формаЗаказа.Позиции[i].ТоварId">
                                                <option value="0">Выберите товар</option>
                                                @foreach (var т in всеТовары)
                                                {
                                                    <option value="@т.Id">@т.Артикул - @т.Название</option>
                                                }
                                            </select>
                                            <input type="number" class="form-control" style="width:100px;" placeholder="Кол-во" @bind="формаЗаказа.Позиции[i].Количество" />
                                            <button class="btn btn-outline-danger btn-sm" @onclick="() => УдалитьПозициюЗаказа(i)"><i class="fas fa-times"></i></button>
                                        </div>
                                    }
                                    <button class="btn btn-outline-primary btn-sm" @onclick="ДобавитьПозициюЗаказа"><i class="fas fa-plus me-1"></i>Добавить позицию</button>
                                </div>
                            </div>
                            <div class="modal-footer border-0">
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Отмена</button>
                                <button type="button" class="btn btn-primary" @onclick="СохранитьЗаказ">Сохранить</button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Модальное окно для начисления средств пользователю (доработанное с поиском) -->
                <div class="modal fade" id="fundsModal" tabindex="-1" aria-hidden="true">
                    <div class="modal-dialog">
                        <div class="modal-content rounded-3">
                            <div class="modal-header border-0 pb-0">
                                <h5 class="modal-title">Начислить средства</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Закрыть"></button>
                            </div>
                            <div class="modal-body">
                                <!-- Поиск пользователя по имени или email с использованием datalist -->
                                <div class="mb-3">
                                    <label class="form-label small">Поиск пользователя</label>
                                    <input list="пользователиDatalist" class="form-control" @bind="поискПользователяДляНачисления" placeholder="Введите имя или email" />
                                    <datalist id="пользователиDatalist">
                                        @foreach (var п in всеПользователи)
                                        {
                                            <option value="@п.Имя (@п.Email)" data-id="@п.Id"></option>
                                        }
                                    </datalist>
                                    <button class="btn btn-outline-secondary btn-sm mt-2" @onclick="ВыбратьНайденногоПользователя">Выбрать</button>
                                </div>
                                <!-- Отображение выбранного пользователя -->
                                @if (выбранныйПользовательДляНачисления != null)
                                {
                                    <div class="alert alert-info py-2 small">Выбран: @выбранныйПользовательДляНачисления.Имя (@выбранныйПользовательДляНачисления.Email)</div>
                                }
                                <!-- Поля суммы и комментария -->
                                <input type="number" class="form-control mb-3" placeholder="Сумма" @bind="суммаНачисления" />
                                <input type="text" class="form-control" placeholder="Комментарий" @bind="комментарийНачисления" />
                            </div>
                            <div class="modal-footer border-0">
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Отмена</button>
                                <button type="button" class="btn btn-primary" @onclick="НачислитьСредства">Начислить</button>
                            </div>
                        </div>
                    </div>
                </div>

            </div> <!-- container-fluid -->
@code {
    
    public class Товар
    {
        public int Id { get; set; }
        public string Артикул { get; set; }
        public string Название { get; set; }
        public decimal Цена { get; set; }
        public int Количество { get; set; }
