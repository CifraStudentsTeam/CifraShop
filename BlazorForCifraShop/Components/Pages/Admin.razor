@page "/admin"

<PageTitle>Admin</PageTitle>

<div class="container-fluid p-2">

    <!-- ======================== ШАПКА ======================== -->
    <!-- Верхняя панель с логотипом, уведомлениями и аватаром -->
    <div class="d-flex justify-content-between align-items-center mb-4 px-1">
        <span class="fw-semibold fs-5">
            <i class="fas fa-cubes me-2"></i>Админ-панель
        </span>
        <div class="d-flex align-items-center gap-3">
            <!-- Колокольчик уведомлений оформлен как кнопка с подсветкой при наведении -->
            <button class="btn btn-outline-secondary rounded-circle p-2 border-0" title="Уведомления">
                <i class="far fa-bell"></i>
            </button>
            <!-- Аватар пользователя (просто кружок) -->
            <div class="bg-primary rounded-circle d-flex align-items-center justify-content-center text-white"
                 style="width:40px; height:40px;">
                A
            </div>
        </div>
    </div>

    <!-- ======================== МЕТРИКИ (карточки статистики) ======================== -->
    <div class="row g-3 mb-4">
        <!-- Карточка "Товаров" -->
        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm rounded-3">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <div class="small text-secondary">Товаров (типов)</div>
                        <div class="fs-2 fw-semibold">@всегоТоваров</div>
                    </div>
                    <div class="bg-primary bg-opacity-10 rounded-3 p-3">
                        <i class="fas fa-box fs-2 text-primary"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Карточка "Заказы" с выбором периода -->
        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm rounded-3">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <div class="small text-secondary">Заказы</div>
                        <div class="fs-2 fw-semibold">@количествоЗаказов</div>
                        <div class="d-flex align-items-center gap-1 mt-1">
                            <span class="small text-secondary">за</span>
                            <!-- При изменении выбранного периода вызывается метод ИзменитьПериодЗаказов -->
                            <select class="form-select form-select-sm w-auto" @onchange="ИзменитьПериодЗаказов">
                                @foreach (var период in периодыЗаказов)
                                {
                                    <option value="@период.Значение" selected="@(период.Значение == выбранныйПериодЗаказов)">
                                        @период.Текст
                                    </option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="bg-primary bg-opacity-10 rounded-3 p-3">
                        <i class="fas fa-shopping-cart fs-2 text-primary"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Карточка "Пользователи" -->
        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm rounded-3">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <div class="small text-secondary">Пользователи</div>
                        <div class="fs-2 fw-semibold">@всегоПользователей</div>
                    </div>
                    <div class="bg-primary bg-opacity-10 rounded-3 p-3">
                        <i class="fas fa-users fs-2 text-primary"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ======================== ПЕРВЫЙ РЯД: ТОВАРЫ И ЗАКАЗЫ ======================== -->
    <div class="row g-3 mb-4">

        <!-- ========== БЛОК УПРАВЛЕНИЯ ТОВАРАМИ ========== -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-3">
                <!-- Заголовок блока товаров с кнопкой "Добавить" -->
                <div class="card-header bg-white border-0 pt-3 px-3 d-flex justify-content-between align-items-center">
                    <h5 class="fw-semibold mb-0">Управление товарами</h5>
                    <!-- Кнопка открывает модальное окно добавления товара -->
                    <button class="btn btn-primary btn-sm" @onclick="() => ОткрытьМодалкуТовара(0)">
                        <i class="fas fa-plus me-1"></i>Добавить
                    </button>
                </div>
                <div class="card-body pt-0">

                    <!-- Фильтры товаров (поиск и выбор статуса) -->
                    <div class="d-flex gap-2 mb-3">
                        <!-- Поиск по названию или артикулу с обновлением при каждом вводе -->
                        <div class="input-group input-group-sm flex-grow-1">
                            <span class="input-group-text bg-light border-0"><i class="fas fa-search text-secondary"></i></span>
                            <input type="text" class="form-control bg-light border-0"
                                   placeholder="Поиск по названию или артикулу..."
                                   @bind="поискТоваров"
                                   @bind:event="oninput" />
                        </div>
                        <!-- Фильтр по статусу видимости -->
                        <select class="form-select form-select-sm w-auto" @bind="фильтрСтатусТоваров">
                            <option value="">Все</option>
                            <option value="visible">Видимые</option>
                            <option value="hidden">Скрытые</option>
                            <option value="out">Нет в наличии</option>
                        </select>
                    </div>

                    <!-- Кнопки массовых действий над выделенными товарами -->
                    <div class="d-flex gap-2 mb-2">
                        <button class="btn btn-outline-danger btn-sm" @onclick="УдалитьВыбранныеТовары">
                            <i class="fas fa-trash me-1"></i>Удалить выбранные
                        </button>
                        <button class="btn btn-outline-secondary btn-sm" @onclick="СкрытьВыбранныеТовары">
                            <i class="fas fa-eye-slash me-1"></i>Скрыть
                        </button>
                        <button class="btn btn-outline-success btn-sm" @onclick="ПоказатьВыбранныеТовары">
                            <i class="fas fa-eye me-1"></i>Показать
                        </button>
                    </div>

                    <!-- Таблица товаров -->
                    <div class="table-responsive">
                        <table class="table table-sm align-middle small">
                            <thead class="table-light">
                                <tr>
                                    <!-- Чекбокс "Выбрать все" для текущей страницы -->
                                    <th><input type="checkbox" class="form-check-input" @bind="выбратьВсеТовары" /></th>
                                    <th>Фото</th>
                                    <th>Артикул / Название</th>
                                    <th>Цена</th>
                                    <th>Склад</th>
                                    <th>Статус</th>
                                    <th>Действия</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var товар in товарыНаСтранице)
                                {
                                    <!-- Строка товара: если скрыт, добавляем классы полупрозрачности -->
                                    <tr class="@(товар.Видим ? "" : "bg-light opacity-50")">
                                        <td><input type="checkbox" class="form-check-input" @bind="товар.Выбран" /></td>
                                        <td>
                                            <!-- Заглушка фото (иконка) -->
                                            <div class="bg-secondary bg-opacity-10 rounded-2 d-flex align-items-center justify-content-center"
                                                 style="width:32px; height:32px;">
                                                <i class="fas fa-image text-secondary"></i>
                                            </div>
                                        </td>
                                        <td><span class="fw-semibold">@товар.Артикул</span> @товар.Название</td>
                                        <td>@товар.Цена</td>
                                        <td>
                                            <input type="number" class="form-control form-control-sm"
                                                   style="width:70px;" @bind="товар.Количество" />
                                        </td>
                                        <td>
                                            <!-- Переключатель видимости товара (Switch) -->
                                            <div class="d-flex align-items-center gap-2">
                                                <div class="form-check form-switch">
                                                    <input class="form-check-input" type="checkbox"
                                                           @bind="товар.Видим" id="@($"prod_{товар.Id}")" />
                                                </div>
                                                <span class="small">@(товар.Видим ? "Видим" : "Скрыт")</span>
                                            </div>
                                        </td>
                                        <td class="text-secondary">
                                            <!-- Кнопки действий: редактировать и удалить -->
                                            <i class="fas fa-edit me-2" style="cursor:pointer;" @onclick="() => ОткрытьМодалкуТовара(товар.Id)"></i>
                                            <i class="fas fa-trash" style="cursor:pointer;" @onclick="() => УдалитьТовар(товар.Id)"></i>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <!-- Пагинация товаров -->
                    <nav class="d-flex justify-content-end">
                        <ul class="pagination pagination-sm">
                            <li class="page-item @(индексСтраницыТоваров == 0 ? "disabled" : "")">
                                <a class="page-link" href="#" @onclick="() => ПерейтиНаСтраницуТоваров(индексСтраницыТоваров - 1)">
                                    <i class="fas fa-chevron-left"></i>
                                </a>
                            </li>
                            @for (int i = 0; i < всегостраницТоваров; i++)
                            {
                                <li class="page-item @(i == индексСтраницыТоваров ? "active" : "")">
                                    <a class="page-link" href="#" @onclick="() => ПерейтиНаСтраницуТоваров(i)">@(i + 1)</a>
                                </li>
                            }
                            <li class="page-item @(индексСтраницыТоваров == всегостраницТоваров - 1 ? "disabled" : "")">
                                <a class="page-link" href="#" @onclick="() => ПерейтиНаСтраницуТоваров(индексСтраницыТоваров + 1)">
                                    <i class="fas fa-chevron-right"></i>
                                </a>
                            </li>
                        </ul>
                    </nav>

                </div> <!-- card-body -->
            </div> <!-- card -->
        </div> <!-- col Товары -->

        <!-- ========== БЛОК УПРАВЛЕНИЯ ЗАКАЗАМИ ========== -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-3">
                <!-- Заголовок блока заказов с кнопкой "Создать" -->
                <div class="card-header bg-white border-0 pt-3 px-3 d-flex justify-content-between align-items-center">
                    <h5 class="fw-semibold mb-0">Управление заказами</h5>
                    <button class="btn btn-primary btn-sm" @onclick="ОткрытьМодалкуСозданияЗаказа">
                        <i class="fas fa-plus me-1"></i>Создать
                    </button>
                </div>
                <div class="card-body pt-0">

                    <!-- Фильтры заказов (поиск, статус, период) -->
                    <div class="d-flex gap-2 mb-3 flex-wrap">
                        <!-- Поиск по номеру заказа или email покупателя -->
                        <div class="input-group input-group-sm flex-grow-1">
                            <span class="input-group-text bg-light border-0">
                                <i class="fas fa-search text-secondary"></i>
                                </span>
                            <input type="text" class="form-control bg-light border-0"
                                   placeholder="Поиск по номеру или email..."
                                   @bind="поискЗаказов"
                                   @bind:event="oninput" />
                        </div>
                        <!-- Фильтр по статусу заказа -->
                        <select class="form-select form-select-sm w-auto" @bind="фильтрСтатусЗаказов">
                            <option value="">Все статусы</option>
                            <option value="New">Новые</option>
                            <option value="Paid">Оплачено</option>
                            <option value="Completed">Выполнено</option>
                            <option value="Cancelled">Отменено</option>
                        </select>
                        <!-- Фильтр по периоду (дате создания) -->
                        <select class="form-select form-select-sm w-auto" @bind="фильтрПериодЗаказов">
                            <option value="">За всё время</option>
                            <option value="today">Сегодня</option>
                            <option value="week">Неделя</option>
                            <option value="month">Месяц</option>
                        </select>
                    </div>

                    <!-- Таблица заказов -->
                    <div class="table-responsive">
                        <table class="table table-sm align-middle small">
                            <thead class="table-light">
                                <tr>
                                    <th>№</th>
                                    <th>Покупатель</th>
                                    <th>Состав</th>
                                    <th>Сумма</th>
                                    <th>Статус</th>
                                    <th>Действия</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var заказ in заказыНаСтранице)
                                {
                                    <tr>
                                        <td>#@заказ.Номер</td>
                                        <td>@заказ.EmailПокупателя</td>
                                        <td>@заказ.СоставКратко</td>
                                        <td>@заказ.Сумма</td>
                                        <td>
                                            <!-- Выпадающий список для изменения статуса заказа (привязка к свойству) -->
                                            <select class="form-select form-select-sm" @bind="заказ.Статус">
                                                @foreach (var статус in Enum.GetValues(typeof(СтатусЗаказа)).Cast<СтатусЗаказа>())
                                                {
                                                    <option value="@статус">@статус</option>
                                                }
                                            </select>
                                        </td>
                                        <td class="text-secondary">
                                            <!-- Иконка глаза для просмотра деталей (можно доработать как скрытие, но пока просмотр) -->
                                            <i class="fas fa-eye me-2" style="cursor:pointer;" @onclick="() => ПросмотретьЗаказ(заказ.Id)"></i>
                                            <!-- Иконка редактирования -->
                                            <i class="fas fa-edit" style="cursor:pointer;" @onclick="() => ОткрытьМодалкуРедактированияЗаказа(заказ.Id)"></i>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <!-- Пагинация заказов -->
                    <nav class="d-flex justify-content-end">
                        <ul class="pagination pagination-sm">
                            <li class="page-item @(индексСтраницыЗаказов == 0 ? "disabled" : "")">
                                <a class="page-link" href="#" @onclick="() => ПерейтиНаСтраницуЗаказов(индексСтраницыЗаказов - 1)">
                                    <i class="fas fa-chevron-left"></i>
                                </a>
                            </li>
                            @for (int i = 0; i < всегостраницЗаказов; i++)
                            {
                                <li class="page-item @(i == индексСтраницыЗаказов ? "active" : "")">
                                    <a class="page-link" href="#" @onclick="() => ПерейтиНаСтраницуЗаказов(i)">@(i + 1)</a>
                                </li>
                            }
                            <li class="page-item @(индексСтраницыЗаказов == всегостраницЗаказов - 1 ? "disabled" : "")">
                                <a class="page-link" href="#" @onclick="() => ПерейтиНаСтраницуЗаказов(индексСтраницыЗаказов + 1)">
                                    <i class="fas fa-chevron-right"></i>
                                </a>
                            </li>
                        </ul>
                    </nav>

                </div> <!-- card-body -->
            </div> <!-- card -->
        </div> <!-- col Заказы -->

    </div> <!-- первый ряд -->


    <!-- ======================== ВТОРОЙ РЯД: ПОЛЬЗОВАТЕЛИ И НАСТРОЙКИ ======================== -->
    <div class="row g-3">

        <!-- ========== БЛОК УПРАВЛЕНИЯ ПОЛЬЗОВАТЕЛЯМИ ========== -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-3">
                <!-- Заголовок блока с кнопкой "Начислить" -->
                <div class="card-header bg-white border-0 pt-3 px-3 d-flex justify-content-between align-items-center">
                    <h5 class="fw-semibold mb-0">Управление пользователями</h5>
                    <button class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#fundsModal">
                        <i class="fas fa-coins me-1"></i>Начислить
                    </button>
                </div>
                <div class="card-body pt-0">

                    <!-- Фильтры пользователей (поиск по имени или email) -->
                    <div class="d-flex gap-2 mb-3">
                        <div class="input-group input-group-sm flex-grow-1">
                            <span class="input-group-text bg-light border-0"><i class="fas fa-search text-secondary"></i></span>
                            <input type="text" class="form-control bg-light border-0"
                                   placeholder="Поиск по имени или email..."
                                   @bind="поискПользователей"
                                   @bind:event="oninput" />
                        </div>
                        <!-- Фильтр по балансу -->
                        <select class="form-select form-select-sm w-auto" @bind="фильтрБалансПользователей">
                            <option value="">Все</option>
                            <option value="positive">С балансом > 0</option>
                        </select>
                    </div>

                    <!-- Таблица пользователей -->
                    <div class="table-responsive">
                        <table class="table table-sm align-middle small">
                            <thead class="table-light">
                                <tr>
                                    <th>Аватар</th>
                                    <th>Имя</th>
                                    <th>Email</th>
                                    <th>Баланс</th>
                                    <th>Действия</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var пользователь in пользователиНаСтранице)
                                {
                                    <tr>
                                        <td>
                                            <!-- Заглушка аватара -->
                                            <div class="rounded-circle bg-secondary bg-opacity-10 d-flex align-items-center justify-content-center"
                                                 style="width:32px; height:32px;">
                                                <i class="fas fa-user text-secondary"></i>
                                            </div>
                                        </td>
                                        <td>@пользователь.Имя</td>
                                        <td>@пользователь.Email</td>
                                        <td>@пользователь.Баланс</td>
                                        <td class="text-secondary">
                                            <!-- Редактирование и блокировка (удаление) -->
                                            <i class="fas fa-edit me-2" style="cursor:pointer;" @onclick="() => ОткрытьМодалкуРедактированияПользователя(пользователь.Id)"></i>
                                            <i class="fas fa-ban" style="cursor:pointer;" @onclick="() => УдалитьПользователя(пользователь.Id)"></i>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <!-- Пагинация пользователей -->
                    <nav class="d-flex justify-content-end">
                        <ul class="pagination pagination-sm">
                            <li class="page-item @(индексСтраницыПользователей == 0 ? "disabled" : "")">
                                <a class="page-link" href="#" @onclick="() => ПерейтиНаСтраницуПользователей(индексСтраницыПользователей - 1)">
                                    <i class="fas fa-chevron-left"></i>
                                </a>
                            </li>
                            @for (int i = 0; i < всегостраницПользователей; i++)
                            {
                                <li class="page-item @(i == индексСтраницыПользователей ? "active" : "")">
                                    <a class="page-link" href="#" @onclick="() => ПерейтиНаСтраницуПользователей(i)">@(i + 1)</a>
                                </li>
                            }
                            <li class="page-item @(индексСтраницыПользователей == всегостраницПользователей - 1 ? "disabled" : "")">
                                <a class="page-link" href="#" @onclick="() => ПерейтиНаСтраницуПользователей(индексСтраницыПользователей + 1)">
                                    <i class="fas fa-chevron-right"></i>
                                </a>
                            </li>
                        </ul>
                    </nav>

                </div> <!-- card-body -->
            </div> <!-- card -->
        </div> <!-- col Пользователи -->

        <!-- ========== БЛОК НАСТРОЕК УВЕДОМЛЕНИЙ ========== -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-header bg-white border-0 pt-3 px-3">
                    <h5 class="fw-semibold mb-0">Настройки уведомлений</h5>
                </div>
                <div class="card-body">
                    <!-- Настройка Email уведомлений -->
                    <div class="d-flex align-items-center gap-4 flex-wrap">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="notifyEmail" @bind="уведомлениеEmail">
                                <label class="form-check-label small" for="notifyEmail">Email</label>
                            </div>
                            <div>
                                <input type="email" class="form-control form-control-sm"
                                       @bind="emailДляУведомлений" placeholder="Email" style="width:200px;">
                                </div>
                                <!-- Настройка Telegram уведомлений -->
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="notifyTelegram" @bind="уведомлениеTelegram">
                                        <label class="form-check-label small" for="notifyTelegram">Telegram</label>
                                    </div>
                                </div>
                                <p class="text-secondary small mt-3 mb-0">Уведомления о новых заказах</p>
                            </div>
                        </div>
                    </div> <!-- col Настройки -->

                </div> <!-- второй ряд -->


                <!-- ======================== МОДАЛЬНЫЕ ОКНА ======================== -->
                <!-- Модальное окно для добавления/редактирования товара -->
                <div class="modal fade" id="товарМодал" tabindex="-1" aria-hidden="true">
                    <div class="modal-dialog">
                        <div class="modal-content rounded-3">
                            <div class="modal-header border-0 pb-0">
                                <h5 class="modal-title">@(редактируемыйТоварId == 0 ? "Добавить товар" : "Редактировать товар")</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Закрыть"></button>
                            </div>
                            <div class="modal-body">
                                <!-- Поля ввода для товара -->
                                <div class="mb-3">
                                    <label class="form-label small">Артикул</label>
                                    <input type="text" class="form-control" @bind="формаТовара.Артикул" />
                                </div>
                                <div class="mb-3">
                                    <label class="form-label small">Название</label>
                                    <input type="text" class="form-control" @bind="формаТовара.Название" />
                                </div>
                                <div class="mb-3">
                                    <label class="form-label small">Цена</label>
                                    <input type="number" class="form-control" @bind="формаТовара.Цена" />
                                </div>
                                <div class="mb-3">
                                    <label class="form-label small">Количество на складе</label>
                                    <input type="number" class="form-control" @bind="формаТовара.Количество" />
                                </div>
                                <div class="mb-3">
                                    <label class="form-label small">Статус видимости</label>
                                    <select class="form-select" @bind="формаТовара.Видим">
