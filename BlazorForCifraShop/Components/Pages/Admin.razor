    private void УдалитьПользователя(int id)
    {
        var пользователь = всеПользователи.FirstOrDefault(п => п.Id == id);
        if (пользователь != null)
            всеПользователи.Remove(пользователь);
    }

    // ---------- НАЧИСЛЕНИЕ СРЕДСТВ ----------
    private void ВыбратьНайденногоПользователя()
    {
        // Ищем пользователя по введённой строке (простой вариант: точное совпадение имени или email)
        выбранныйПользовательДляНачисления = всеПользователи.FirstOrDefault(п =>
            п.Имя.Contains(поискПользователяДляНачисления, StringComparison.OrdinalIgnoreCase) ||
            п.Email.Contains(поискПользователяДляНачисления, StringComparison.OrdinalIgnoreCase));
    }

    private void НачислитьСредства()
    {
        if (выбранныйПользовательДляНачисления != null && суммаНачисления > 0)
        {
            выбранныйПользовательДляНачисления.Баланс += суммаНачисления;
            // Сброс полей
            выбранныйПользовательДляНачисления = null;
            поискПользователяДляНачисления = "";
            суммаНачисления = 0;
            комментарийНачисления = "";
        }
    }
