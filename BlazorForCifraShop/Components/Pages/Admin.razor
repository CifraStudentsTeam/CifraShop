        public bool Выбран { get; set; } // для чекбокса в таблице
    }


    public enum СтатусЗаказа
    {
        Новый,       
        Оплачено,   
        Выполнено,  
        Отменено   
    }


    public class Заказ
    {
        public int Id { get; set; }
        public string Номер { get; set; }
        public string EmailПокупателя { get; set; }
