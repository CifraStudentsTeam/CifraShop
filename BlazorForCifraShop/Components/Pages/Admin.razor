    // ОБРАБОТЧИКИ СОБЫТИЙ

    // Изменение периода в метрике заказов
    private void ИзменитьПериодЗаказов(ChangeEventArgs e)
    {
        выбранныйПериодЗаказов = e.Value?.ToString();
    }

    // Пагинация
    private void ПерейтиНаСтраницуТоваров(int новыйИндекс)
    {
        if (новыйИндекс >= 0 && новыйИндекс < всегостраницТоваров)
            индексСтраницыТоваров = новыйИндекс;
    }

    private void ПерейтиНаСтраницуЗаказов(int новыйИндекс)
    {
        if (новыйИндекс >= 0 && новыйИндекс < всегостраницЗаказов)
            индексСтраницыЗаказов = новыйИндекс;
    }

    private void ПерейтиНаСтраницуПользователей(int новыйИндекс)
    {
        if (новыйИндекс >= 0 && новыйИндекс < всегостраницПользователей)
            индексСтраницыПользователей = новыйИндекс;
    }

    // ---------- ДЕЙСТВИЯ С ТОВАРАМИ ----------
    private void ОткрытьМодалкуТовара(int id)
    {
        редактируемыйТоварId = id;
        if (id == 0)
        {
            // Новый товар
            формаТовара = new Товар { Видим = true };
        }
        else
        {
            // Редактирование: копируем данные из списка в форму
            var исходный = всеТовары.FirstOrDefault(т => т.Id == id);
            if (исходный != null)
            {
                формаТовара = new Товар
                {
                    Id = исходный.Id,
                    Артикул = исходный.Артикул,
                    Название = исходный.Название,
                    Цена = исходный.Цена,
                    Количество = исходный.Количество,
                    Видим = исходный.Видим
                };
            }
        }
    }

    private void СохранитьТовар()
    {
        if (редактируемыйТоварId == 0)
        {
            // Добавление
            var новыйId = всеТовары.Any() ? всеТовары.Max(т => т.Id) + 1 : 1;
            формаТовара.Id = новыйId;
            всеТовары.Add(формаТовара);
        }
        else
        {
            // Редактирование
            var существующий = всеТовары.FirstOrDefault(т => т.Id == редактируемыйТоварId);
            if (существующий != null)
            {
                существующий.Артикул = формаТовара.Артикул;
                существующий.Название = формаТовара.Название;
                существующий.Цена = формаТовара.Цена;
                существующий.Количество = формаТовара.Количество;
                существующий.Видим = формаТовара.Видим;
            }
        }
        // Закрыть модалку
        StateHasChanged();
    }

    private void УдалитьТовар(int id)
    {
        var товар = всеТовары.FirstOrDefault(т => т.Id == id);
        if (товар != null)
        {
            всеТовары.Remove(товар);
            // Корректировка страницы, если текущая стала пустой
            if (товарыНаСтранице.Count() == 0 && индексСтраницыТоваров > 0)
                индексСтраницыТоваров--;
        }
    }

    // Массовые действия
    private void УдалитьВыбранныеТовары()
    {
        var выбранные = всеТовары.Where(т => т.Выбран).ToList();
        foreach (var т in выбранные)
            всеТовары.Remove(т);
        // Сброс страницы при необходимости
        if (товарыНаСтранице.Count() == 0 && индексСтраницыТоваров > 0)
            индексСтраницыТоваров--;
    }

    private void СкрытьВыбранныеТовары()
    {
        foreach (var т in всеТовары.Where(т => т.Выбран))
            т.Видим = false;
    }

    private void ПоказатьВыбранныеТовары()
    {
        foreach (var т in всеТовары.Where(т => т.Выбран))
            т.Видим = true;
    }

    // ---------- ДЕЙСТВИЯ С ЗАКАЗАМИ ----------
    private void ОткрытьМодалкуСозданияЗаказа()
    {
        редактируемыйЗаказId = 0;
        формаЗаказа = new ФормаЗаказа();
        // Открыть модалку (через JS)
    }

    private void ОткрытьМодалкуРедактированияЗаказа(int id)
    {
        редактируемыйЗаказId = id;
        var существующий = всеЗаказы.FirstOrDefault(з => з.Id == id);
        if (существующий != null)
        {
            // Заполнить форму (упрощённо, без позиций)
            формаЗаказа = new ФормаЗаказа
            {
                EmailПокупателя = существующий.EmailПокупателя,
                // Позиции нужно восстанавливать из деталей заказа, для простоты оставим пустым
            };
        }
    }

    private void ДобавитьПозициюЗаказа()
    {
        формаЗаказа.Позиции.Add(new ПозицияЗаказа());
    }

    private void УдалитьПозициюЗаказа(int индекс)
    {
        if (индекс >= 0 && индекс < формаЗаказа.Позиции.Count)
            формаЗаказа.Позиции.RemoveAt(индекс);
    }

    private void СохранитьЗаказ()
    {
        if (редактируемыйЗаказId == 0)
        {
            // Создание нового заказа
            var новыйId = всеЗаказы.Any() ? всеЗаказы.Max(з => з.Id) + 1 : 1;
            // Генерация номера
            string новыйНомер = (1000 + новыйId).ToString();
            // Формирование краткого состава
            var состав = string.Join(", ", формаЗаказа.Позиции.Select(p => $"{p.Количество}×{всеТовары.FirstOrDefault(т => т.Id == p.ТоварId)?.Артикул ?? "?"}"));
            var сумма = формаЗаказа.Позиции.Sum(p => p.Количество * (всеТовары.FirstOrDefault(т => т.Id == p.ТоварId)?.Цена ?? 0));

            всеЗаказы.Add(new Заказ
            {
                Id = новыйId,
                Номер = новыйНомер,
                EmailПокупателя = формаЗаказа.EmailПокупателя,
                СоставКратко = состав,
                Сумма = сумма,
                Статус = СтатусЗаказа.Новый,
                ДатаСоздания = DateTime.Now
            });
        }
        else
        {
            // Редактирование существующего заказа (обновление полей)
            var заказ = всеЗаказы.FirstOrDefault(з => з.Id == редактируемыйЗаказId);
            if (заказ != null)
            {
                заказ.EmailПокупателя = формаЗаказа.EmailПокупателя;
                // Обновление состава и суммы аналогично созданию
                var состав = string.Join(", ", формаЗаказа.Позиции.Select(p => $"{p.Количество}×{всеТовары.FirstOrDefault(т => т.Id == p.ТоварId)?.Артикул ?? "?"}"));
                заказ.СоставКратко = состав;
                заказ.Сумма = формаЗаказа.Позиции.Sum(p => p.Количество * (всеТовары.FirstOrDefault(т => т.Id == p.ТоварId)?.Цена ?? 0));
            }
        }
        // Закрыть модалку
        StateHasChanged();
    }

