@inherits LayoutComponentBase
@using CifraShop.Client.Services
@inject UserState UserState
@inject NavigationManager Navigation

<main>
    <div class="top-row px-4 d-flex justify-content-between align-items-center">
        <div>
            <a href="/" class="navbar-brand fw-bold" style="color:#1a3b5d;">Академия Цифра</a>
            <a href="/" class="btn btn-sm btn-outline-primary ms-3">Магазин</a>
        </div>
        @if (UserState.IsLoggedIn)
        {
            <div>
                <span>Привет, @UserState.UserName!</span>
                <a href="/profile" class="ms-2">Профиль</a>
                <a href="#" class="ms-2" @onclick:preventDefault @onclick="Logout">Выйти</a>
            </div>
        }
        else
        {
            <a href="/login" class="btn btn-outline-secondary">Войти</a>
        }
    </div>
    <article class="content px-4">
        @Body
    </article>
</main>

@code {
    private void Logout()
    {
        UserState.Logout();
        Navigation.NavigateTo("/login");
    }
}