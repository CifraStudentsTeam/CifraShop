@inherits LayoutComponentBase
@using CifraShop.Client.Services
@inject UserState UserState
@inject NavigationManager Navigation

<div class="page">
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark px-3">
        <a class="navbar-brand" href="/">🎓 Академия Цифра — Магазин</a>

        <div class="navbar-nav ms-auto">
            @if (UserState.IsLoggedIn)
            {
                <span class="navbar-text me-3">
                    Привет, <strong>@UserState.UserName</strong>! 🪙 @UserState.Balance
                </span>
                <a class="nav-link" href="/profile">Профиль</a>
                <button class="btn btn-outline-light btn-sm ms-2" @onclick="Logout">Выйти</button>
            }
            else
            {
                <a class="nav-link" href="/login">Войти</a>
            }
        </div>
    </nav>

    <main class="container mt-4">
        @Body
    </main>
</div>

@code {
    protected override void OnInitialized()
    {
        UserState.OnChange += StateHasChanged;
    }

    private void Logout()
    {
        UserState.Logout();
        Navigation.NavigateTo("/login");
    }

    public void Dispose()
    {
        UserState.OnChange -= StateHasChanged;
    }
}