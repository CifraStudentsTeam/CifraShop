@page "/"
@rendermode InteractiveWebAssembly
@using CifraShop.Client.Services
@using CifraShop.Dto
@inject UserState UserState
@inject NavigationManager Navigation
@inject ApiService Api

<h2>Магазин атрибутики</h2>
<p>Зарабатывай Цифракоины за успехи в учёбе и обменивай на крутые вещи!</p>

@if (isLoading)
{
    <p>Загрузка товаров...</p>
}
else if (products == null || products.Count == 0)
{
    <p>Товары пока не добавлены.</p>
}
else
{
    <div class="row">
        @foreach (var product in products)
        {
            <div class="col-md-4 mb-4">
                <div class="card h-100">
                    <div class="card-body">
                        <h5 class="card-title">@product.Name</h5>
                        <p class="card-text">@product.Description</p>
                        <p class="card-text"><strong>🪙 @product.Price Цифракоинов</strong></p>
                        <p class="card-text text-muted">В наличии: @product.Quantity шт.</p>
                        <button class="btn btn-primary" @onclick="() => BuyProduct(product)"
                                disabled="@(product.Quantity == 0)">
                            @(product.Quantity == 0 ? "Нет в наличии" : "Купить")
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>
}

<p class="mt-3 text-muted">✨ Сделано с любовью студентами Академии «Цифра» ✨</p>

@if (!string.IsNullOrEmpty(message))
{
    <div class="alert @(isError ? "alert-danger" : "alert-success") mt-3">@message</div>
}

@code {
    private List<ProductResponce>? products;
    private bool isLoading = true;
    private string? message;
    private bool isError = false;

    protected override async Task OnInitializedAsync()
    {
        products = await Api.GetAllProducts();
        isLoading = false;
    }

    private async Task BuyProduct(ProductResponce product)
    {
        message = null;
        isError = false;

        if (!UserState.IsLoggedIn)
        {
            message = "Пожалуйста, войдите в аккаунт для покупки.";
            isError = true;
            return;
        }

        if (UserState.Balance < product.Price)
        {
            message = $"Недостаточно Цифракоинов. Нужно {product.Price}, у вас {UserState.Balance}. Учись лучше! 😊";
            isError = true;
            return;
        }

        var order = await Api.CreateOrder(UserState.UserName!, product.Price);
        if (order == null)
        {
            message = "Ошибка при создании заказа. Попробуйте позже.";
            isError = true;
            return;
        }

        await UserState.SpendBalance(product.Price);

        message = $"Поздравляем! Вы приобрели «{product.Name}» за {product.Price} Цифракоинов. 🎉";

        products = await Api.GetAllProducts();
    }
}