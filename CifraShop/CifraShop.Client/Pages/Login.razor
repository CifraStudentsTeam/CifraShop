@page "/login"
@rendermode InteractiveWebAssembly
@using CifraShop.Client.Services
@inject UserState UserState
@inject NavigationManager Navigation
@inject ApiService Api

<h1>Академия «Цифра»</h1>

<div class="tabs mb-3">
    <button class="@GetLoginButtonClass()" @onclick="SetLoginTab">Вход</button>
    <button class="@GetRegisterButtonClass()" @onclick="SetRegisterTab">Регистрация</button>
</div>

@if (CurrentTab == "login")
{
    <div class="form-group mb-2">
        <label>Логин</label>
        <input @bind="loginLogin" class="form-control" placeholder="Введите логин" />
    </div>
    <div class="form-group mb-2">
        <label>Пароль</label>
        <input @bind="loginPassword" type="password" class="form-control" placeholder="Введите пароль" />
    </div>
    <button class="btn btn-primary" @onclick="HandleLogin" disabled="@isLoading">
        @(isLoading ? "Загрузка..." : "Войти")
    </button>
}
else
{
    <div class="form-group mb-2">
        <label>Логин</label>
        <input @bind="registerLogin" class="form-control" placeholder="Придумайте логин" />
    </div>
    <div class="form-group mb-2">
        <label>Дата рождения</label>
        <input @bind="registerDateOfBirth" type="date" class="form-control" />
    </div>
    <div class="form-group mb-2">
        <label>Пароль</label>
        <input @bind="registerPassword" type="password" class="form-control" placeholder="Придумайте пароль" />
    </div>
    <div class="form-group mb-2">
        <label>Подтвердите пароль</label>
        <input @bind="registerConfirmPassword" type="password" class="form-control" />
    </div>
    <button class="btn btn-success" @onclick="HandleRegister" disabled="@isLoading">
        @(isLoading ? "Загрузка..." : "Зарегистрироваться")
    </button>
}

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger mt-3">@errorMessage</div>
}

<p class="mt-4 text-muted">✨ Создано студентами Академии «Цифра» — честно, своими руками ✨</p>

@code {
    private string CurrentTab = "login";
    private bool isLoading = false;

    private string loginLogin = "";
    private string loginPassword = "";

    private string registerLogin = "";
    private string registerPassword = "";
    private string registerConfirmPassword = "";
    private DateTime registerDateOfBirth = new DateTime(2000, 1, 1);

    private string? errorMessage;

    private string GetLoginButtonClass()
        => CurrentTab == "login" ? "btn btn-outline-primary active" : "btn btn-outline-secondary";

    private string GetRegisterButtonClass()
        => CurrentTab == "register" ? "btn btn-outline-primary active" : "btn btn-outline-secondary";

    private void SetLoginTab() { CurrentTab = "login"; errorMessage = null; }
    private void SetRegisterTab() { CurrentTab = "register"; errorMessage = null; }

    private async Task HandleLogin()
    {
        errorMessage = null;
        if (string.IsNullOrWhiteSpace(loginLogin) || string.IsNullOrWhiteSpace(loginPassword))
        {
            errorMessage = "Заполните все поля!";
            return;
        }

        isLoading = true;
        StateHasChanged();

        var success = await UserState.Login(loginLogin, loginPassword);
        isLoading = false;

        if (success)
        {
            Navigation.NavigateTo("/profile");
        }
        else
        {
            errorMessage = "Неверный логин или пароль!";
        }
    }

    private async Task HandleRegister()
    {
        errorMessage = null;
        if (string.IsNullOrWhiteSpace(registerLogin) ||
            string.IsNullOrWhiteSpace(registerPassword))
        {
            errorMessage = "Заполните все поля!";
            return;
        }
        if (registerPassword != registerConfirmPassword)
        {
            errorMessage = "Пароли не совпадают!";
            return;
        }

        isLoading = true;
        StateHasChanged();

        var success = await UserState.Register(registerLogin, registerPassword, registerDateOfBirth);
        isLoading = false;

        if (success)
        {
            Navigation.NavigateTo("/profile");
        }
        else
        {
            errorMessage = "Ошибка регистрации. Возможно, логин уже занят.";
        }
    }
}