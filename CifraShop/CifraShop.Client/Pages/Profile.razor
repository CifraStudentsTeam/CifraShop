@page "/profile"
@rendermode InteractiveWebAssembly
@using CifraShop.Client.Services
@using CifraShop.Dto
@inject UserState UserState
@inject NavigationManager Navigation
@inject ApiService Api

@if (!UserState.IsLoggedIn)
{
    Navigation.NavigateTo("/login");
    return;
}

<h2>Личный кабинет</h2>

<div class="card mb-4">
    <div class="card-body">
        <p><strong>Логин:</strong> @UserState.UserName</p>
        <p><strong>ID студента:</strong> @UserState.StudentId</p>

        <h5>Баланс Цифракоинов</h5>
        <p class="fs-3">🪙 @UserState.Balance</p>

        <button class="btn btn-success" @onclick="TopUp" disabled="@isTopUpLoading">
            @(isTopUpLoading ? "Загрузка..." : "+ Пополнить на 500")
        </button>
    </div>
</div>

<h4>Мои заказы</h4>
@if (orders == null)
{
    <p>Загрузка заказов...</p>
}
else if (orders.Count == 0)
{
    <p>У вас пока нет заказов.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>ID</th>
                <th>Сумма</th>
                <th>Дата</th>
                <th>Статус</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var order in orders)
            {
                <tr>
                    <td>@order.Id</td>
                    <td>🪙 @order.Sum</td>
                    <td>@order.DateOfPurchase.ToString("dd.MM.yyyy HH:mm")</td>
                    <td>@order.Status</td>
                </tr>
            }
        </tbody>
    </table>
}

<hr />

<h5>Как зарабатывать Цифракоины?</h5>
<ul>
    <li>Выполняй домашние задания вовремя – +50 монет</li>
    <li>Отличные оценки на экзаменах – +200 монет</li>
    <li>Помогай другим студентам – +30 монет</li>
    <li>Участвуй в хакатонах – до 1000 монет</li>
</ul>

<button class="btn btn-danger mt-3" @onclick="Logout">Выйти из аккаунта</button>

@code {
    private List<OrderResponce>? orders;
    private bool isTopUpLoading = false;

    protected override async Task OnInitializedAsync()
    {
        if (UserState.IsLoggedIn && UserState.UserName != null)
        {
            orders = await Api.GetOrdersByLogin(UserState.UserName);
        }
    }

    private async Task TopUp()
    {
        isTopUpLoading = true;
        StateHasChanged();

        await UserState.TopUpBalance(500);

        isTopUpLoading = false;
        StateHasChanged();
    }

    private void Logout()
    {
        UserState.Logout();
        Navigation.NavigateTo("/login");
    }
}