@page "/admin"
@using CifraShop.Domain.Enums
@using CifraShop.Domain.Models
@using CIfraShop.Services.Interfaces
@inject IProductService ProductService
@inject IOrderService OrderService
@inject IStudentService StudentService
@rendermode InteractiveServer

<PageTitle>Admin</PageTitle>

<div class="container-fluid p-2">

    <!-- ======================== ШАПКА ======================== -->
    <div class="d-flex justify-content-between align-items-center mb-4 px-1">
        <span class="fw-semibold fs-5">
            <i class="fas fa-cubes me-2"></i>Админ-панель
        </span>
        <div class="d-flex align-items-center gap-3">
            <button class="btn btn-outline-secondary rounded-circle p-2 border-0" title="Уведомления">
                <i class="far fa-bell"></i>
            </button>
            <div class="bg-primary rounded-circle d-flex align-items-center justify-content-center text-white"
                 style="width:40px; height:40px;">
                A
            </div>
        </div>
    </div>

    <!-- ======================== МЕТРИКИ ======================== -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm rounded-3">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <div class="small text-secondary">Товаров (типов)</div>
                        <div class="fs-2 fw-semibold">@AllProductsCount</div>
                    </div>
                    <div class="bg-primary bg-opacity-10 rounded-3 p-3">
                        <i class="fas fa-box fs-2 text-primary"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm rounded-3">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <div class="small text-secondary">Заказы</div>
                        <div class="fs-2 fw-semibold">@OrdersCount</div>
                        <div class="d-flex align-items-center gap-1 mt-1">
                            <span class="small text-secondary">за</span>
                            <select class="form-select form-select-sm w-auto" @onchange="e => _selectedPeriodOrders = e.Value?.ToString()">
                                @foreach (var период in _periods)
                                {
                                    <option value="@период.value" selected="@(_selectedPeriodOrders == период.value)">
                                        @период.textInRussian
                                    </option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="bg-primary bg-opacity-10 rounded-3 p-3">
                        <i class="fas fa-shopping-cart fs-2 text-primary"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm rounded-3">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <div class="small text-secondary">Пользователи</div>
                        <div class="fs-2 fw-semibold">@AllUsersCount</div>
                    </div>
                    <div class="bg-primary bg-opacity-10 rounded-3 p-3">
                        <i class="fas fa-users fs-2 text-primary"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ======================== ПЕРВЫЙ РЯД: ТОВАРЫ И ЗАКАЗЫ ======================== -->
    <div class="row g-3 mb-4">

        <!-- ========== БЛОК УПРАВЛЕНИЯ ТОВАРАМИ ========== -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-header bg-white border-0 pt-3 px-3 d-flex justify-content-between align-items-center">
                    <h5 class="fw-semibold mb-0">Управление товарами</h5>
                    <button class="btn btn-primary btn-sm" @onclick="() => OpenProductModal(0)">
                        <i class="fas fa-plus me-1"></i>Добавить
                    </button>
                </div>
                <div class="card-body pt-0">

                    <!-- Фильтры -->
                    <div class="d-flex gap-2 mb-3">
                        <div class="input-group input-group-sm flex-grow-1">
                            <span class="input-group-text bg-light border-0"><i class="fas fa-search text-secondary"></i></span>
                            <input type="text" class="form-control bg-light border-0"
                                   placeholder="Поиск по названию или описанию..."
                                   @bind="_searchProduct"
                                   @bind:event="oninput" />
                        </div>
                        <select class="form-select form-select-sm w-auto" @bind="_filterStatusProduct">
                            <option value="">Все</option>
                            <option value="visible">Видимые (в наличии)</option>
                            <option value="hidden">Скрытые (нет в наличии / скоро)</option>
                            <option value="out">Нет в наличии</option>
                        </select>
                    </div>

                    <!-- Массовые действия -->
                    <div class="d-flex gap-2 mb-2">
                        <button class="btn btn-outline-danger btn-sm" @onclick="DeleteSelectedProducts">
                            <i class="fas fa-trash me-1"></i>Удалить выбранные
                        </button>
                        <button class="btn btn-outline-secondary btn-sm" @onclick="HideSelectedProducts">
                            <i class="fas fa-eye-slash me-1"></i>Скрыть
                        </button>
                        <button class="btn btn-outline-success btn-sm" @onclick="ShowSelectedProducts">
                            <i class="fas fa-eye me-1"></i>Показать
                        </button>
                    </div>

                    <!-- Таблица товаров -->
                    <div class="table-responsive">
                        <table class="table table-sm align-middle small">
                            <thead class="table-light">
                                <tr>
                                    <th><input type="checkbox" class="form-check-input" @bind="_selectAllProducts" @bind:event="onchange" /></th>
                                    <th>Фото</th>
                                    <th>Название / Описание</th>
                                    <th>Цена</th>
                                    <th>Склад</th>
                                    <th>Статус</th>
                                    <th>Действия</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var product in ProductsOnPage)
                                {
                                    bool isVisible = product.Status == StatusProduct.InStock;
                                    <tr class="@(isVisible ? "" : "bg-light opacity-50")">
                                        <td><input type="checkbox" class="form-check-input" @bind="product.IsSelected" /></td>
                                        <td>
                                            <div class="bg-secondary bg-opacity-10 rounded-2 d-flex align-items-center justify-content-center"
                                                 style="width:32px; height:32px;">
                                                <i class="fas fa-image text-secondary"></i>
                                            </div>
                                        </td>
                                        <td>
                                            <span class="fw-semibold">@product.Name</span><br />
                                            <small class="text-secondary">@product.Description</small>
                                        </td>
                                        <td>@product.Price</td>
                                        <td>
                                            <input type="number" class="form-control form-control-sm"
                                                   style="width:70px;" @bind="product.Quantity"
                                                   @onfocusout="() => UpdateProductQuantity(product)" />
                                        </td>
                                        <td>
                                            <div class="d-flex align-items-center gap-2">
                                                <div class="form-check form-switch">
                                                    <input class="form-check-input" type="checkbox"
                                                           checked="@isVisible"
                                                           @onchange="(args) => ToggleProductVisibility(product, (bool)args.Value!)" />
                                                </div>
                                                <span class="small">@(isVisible ? "Видим" : "Скрыт")</span>
                                            </div>
                                        </td>
                                        <td class="text-secondary">
                                            <i class="fas fa-edit me-2" style="cursor:pointer;" @onclick="() => OpenProductModal((int)product.Id)"></i>
                                            <i class="fas fa-trash" style="cursor:pointer;" @onclick="() => DeleteProduct((int)product.Id)"></i>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <!-- Пагинация товаров -->
                    <nav class="d-flex justify-content-end">
                        <ul class="pagination pagination-sm">
                            <li class="page-item @(_indexPageProduct == 0 ? "disabled" : "")">
                                <a class="page-link" href="#" @onclick="() => GoToProductPage(_indexPageProduct - 1)">
                                    <i class="fas fa-chevron-left"></i>
                                </a>
                            </li>
                            @for (int i = 0; i < TotalProductsPages; i++)
                            {
                                <li class="page-item @(i == _indexPageProduct ? "active" : "")">
                                    <a class="page-link" href="#" @onclick="() => GoToProductPage(i)">@(i + 1)</a>
                                </li>
                            }
                            <li class="page-item @(_indexPageProduct == TotalProductsPages - 1 ? "disabled" : "")">
                                <a class="page-link" href="#" @onclick="() => GoToProductPage(_indexPageProduct + 1)">
                                    <i class="fas fa-chevron-right"></i>
                                </a>
                            </li>
                        </ul>
                    </nav>

                </div>
            </div>
        </div>

        <!-- ========== БЛОК УПРАВЛЕНИЯ ЗАКАЗАМИ ========== -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-header bg-white border-0 pt-3 px-3 d-flex justify-content-between align-items-center">
                    <h5 class="fw-semibold mb-0">Управление заказами</h5>
                    <button class="btn btn-primary btn-sm" @onclick="OpenCreateOrderModal">
                        <i class="fas fa-plus me-1"></i>Создать
                    </button>
                </div>
                <div class="card-body pt-0">

                    <!-- Фильтры -->
                    <div class="d-flex gap-2 mb-3 flex-wrap">
                        <div class="input-group input-group-sm flex-grow-1">
                            <span class="input-group-text bg-light border-0">
                                <i class="fas fa-search text-secondary"></i>
                            </span>
                            <input type="text" class="form-control bg-light border-0"
                                   placeholder="Поиск по номеру или логину..."
                                   @bind="_searchOrder"
                                   @bind:event="oninput" />
                        </div>
                        <select class="form-select form-select-sm w-auto" @bind="_filterStatusOrder">
                            <option value="">Все статусы</option>
                            @foreach (var status in Enum.GetValues(typeof(StatusOrder)).Cast<StatusOrder>())
                            {
                                <option value="@status">@status</option>
                            }
                        </select>
                        <select class="form-select form-select-sm w-auto" @bind="_filterPeriodOrder">
                            <option value="">За всё время</option>
                            <option value="today">Сегодня</option>
                            <option value="week">Неделя</option>
                            <option value="month">Месяц</option>
                        </select>
                    </div>

                    <!-- Таблица заказов -->
                    <div class="table-responsive">
                        <table class="table table-sm align-middle small">
                            <thead class="table-light">
                                <tr>
                                    <th>№</th>
                                    <th>Покупатель</th>
                                    <th>Состав</th>
                                    <th>Сумма</th>
                                    <th>Статус</th>
                                    <th>Действия</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var order in OrdersOnPage)
                                {
                                    var состав = string.Join(", ", order.OrderItems.Select(oi => $"{oi.Quantity}×{_allProductsList.FirstOrDefault(т => т.Id == oi.ProductId)?.Name ?? "?"}"));
                                    <tr>
                                        <td>#@order.Id</td>
                                        <td>@order.CustomerLogin</td>
                                        <td>@состав</td>
                                        <td>@order.Sum</td>
                                        <td>
                                            <select class="form-select form-select-sm" @onchange="async (e) => await ChangeStatusOrder(order, (StatusOrder)Enum.Parse(typeof(StatusOrder), e.Value.ToString()))">
                                                @foreach (var статус in Enum.GetValues(typeof(StatusOrder)).Cast<StatusOrder>())
                                                {
                                                    <option value="@статус" selected="@(order.Status == статус)">@статус</option>
                                                }
                                            </select>
                                        </td>
                                        <td class="text-secondary">
                                            <i class="fas fa-eye me-2" style="cursor:pointer;" @onclick="() => ViewOrder(order)"></i>
                                            <i class="fas fa-edit" style="cursor:pointer;" @onclick="() => OpenEditOrderModal((int)order.Id)"></i>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <!-- Пагинация заказов -->
                    <nav class="d-flex justify-content-end">
                        <ul class="pagination pagination-sm">
                            <li class="page-item @(_indexPageOrder == 0 ? "disabled" : "")">
                                <a class="page-link" href="#" @onclick="() => GoToOrderPage(_indexPageOrder - 1)">
                                    <i class="fas fa-chevron-left"></i>
                                </a>
                            </li>
                            @for (int i = 0; i < TotalOrdersPages; i++)
                            {
                                <li class="page-item @(i == _indexPageOrder ? "active" : "")">
                                    <a class="page-link" href="#" @onclick="() => GoToOrderPage(i)">@(i + 1)</a>
                                </li>
                            }
                            <li class="page-item @(_indexPageOrder == TotalOrdersPages - 1 ? "disabled" : "")">
                                <a class="page-link" href="#" @onclick="() => GoToOrderPage(_indexPageOrder + 1)">
                                    <i class="fas fa-chevron-right"></i>
                                </a>
                            </li>
                        </ul>
                    </nav>

                </div>
            </div>
        </div>

    </div>

    <!-- ======================== ВТОРОЙ РЯД: ПОЛЬЗОВАТЕЛИ И НАСТРОЙКИ ======================== -->
    <div class="row g-3">

        <!-- ========== БЛОК УПРАВЛЕНИЯ ПОЛЬЗОВАТЕЛЯМИ ========== -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-header bg-white border-0 pt-3 px-3 d-flex justify-content-between align-items-center">
                    <h5 class="fw-semibold mb-0">Управление пользователями</h5>
                    <button class="btn btn-primary btn-sm" @onclick="OpenFundsModal">
                        <i class="fas fa-coins me-1"></i>Начислить
                    </button>
                </div>
                <div class="card-body pt-0">

                    <!-- Фильтры -->
                    <div class="d-flex gap-2 mb-3">
                        <div class="input-group input-group-sm flex-grow-1">
                            <span class="input-group-text bg-light border-0"><i class="fas fa-search text-secondary"></i></span>
                            <input type="text" class="form-control bg-light border-0"
                                   placeholder="Поиск по логину..."
                                   @bind="_searchUsers"
                                   @bind:event="oninput" />
                        </div>
                        <select class="form-select form-select-sm w-auto" @bind="_filterBalansUsers">
                            <option value="">Все</option>
                            <option value="positive">С балансом > 0</option>
                        </select>
                    </div>

                    <!-- Таблица пользователей -->
                    <div class="table-responsive">
                        <table class="table table-sm align-middle small">
                            <thead class="table-light">
                                <tr>
                                    <th>Аватар</th>
                                    <th>Логин</th>
                                    <th>Баланс</th>
                                    <th>Действия</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var user in UsersOnPage)
                                {
                                    <tr>
                                        <td>
                                            <div class="rounded-circle bg-secondary bg-opacity-10 d-flex align-items-center justify-content-center"
                                                 style="width:32px; height:32px;">
                                                <i class="fas fa-user text-secondary"></i>
                                            </div>
                                        </td>
                                        <td>@user.LoginName</td>
                                        <td>@user.Balance</td>
                                        <td class="text-secondary">
                                            <i class="fas fa-ban" style="cursor:pointer;" @onclick="() => DeleteUser((int)user.Id)"></i>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <!-- Пагинация пользователей -->
                    <nav class="d-flex justify-content-end">
                        <ul class="pagination pagination-sm">
                            <li class="page-item @(_indexPageUsers == 0 ? "disabled" : "")">
                                <a class="page-link" href="#" @onclick="() => GoToUserPage(_indexPageUsers - 1)">
                                    <i class="fas fa-chevron-left"></i>
                                </a>
                            </li>
                            @for (int i = 0; i < TotalUsersPages; i++)
                            {
                                <li class="page-item @(i == _indexPageUsers ? "active" : "")">
                                    <a class="page-link" href="#" @onclick="() => GoToUserPage(i)">@(i + 1)</a>
                                </li>
                            }
                            <li class="page-item @(_indexPageUsers == TotalUsersPages - 1 ? "disabled" : "")">
                                <a class="page-link" href="#" @onclick="() => GoToUserPage(_indexPageUsers + 1)">
                                    <i class="fas fa-chevron-right"></i>
                                </a>
                            </li>
                        </ul>
                    </nav>

                </div>
            </div>
        </div>

        <!-- ========== БЛОК НАСТРОЕК УВЕДОМЛЕНИЙ ========== -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-header bg-white border-0 pt-3 px-3">
                    <h5 class="fw-semibold mb-0">Настройки уведомлений</h5>
                </div>
                <div class="card-body">
                    <div class="d-flex align-items-center gap-4 flex-wrap">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="notifyEmail" @bind="_notificationsEmail">
                                <label class="form-check-label small" for="notifyEmail">Email</label>
                            </div>
                            <div>
                                <input type="email" class="form-control form-control-sm"
                                       @bind="_emailForNotifications" placeholder="Email" style="width:200px;">
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="notifyTelegram" @bind="_notificationsTelegram">
                                        <label class="form-check-label small" for="notifyTelegram">Telegram</label>
                                    </div>
                                </div>
                                <p class="text-secondary small mt-3 mb-0">Уведомления о новых заказах</p>
                            </div>
                        </div>
                    </div>

                </div>

                <!-- ======================== МОДАЛЬНЫЕ ОКНА (Blazor, без JS) ======================== -->
                <!-- Модалка товара -->
                @if (_showProductModal)
                {
                    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);" @onclick="CloseProductModal">
                        <div class="modal-dialog modal-dialog-centered" @onclick:stopPropagation="true">
                            <div class="modal-content rounded-3">
                                <div class="modal-header border-0 pb-0">
                                    <h5 class="modal-title">@(_editableProductId == 0 ? "Добавить товар" : "Редактировать товар")</h5>
                                    <button type="button" class="btn-close" aria-label="Закрыть" @onclick="CloseProductModal"></button>
                                </div>
                                <div class="modal-body">
                                    <div class="mb-3">
                                        <label class="form-label small">Название</label>
                                        <input type="text" class="form-control" @bind="_formProduct.Name" />
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label small">Описание</label>
                                        <input type="text" class="form-control" @bind="_formProduct.Description" />
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label small">Цена</label>
                                        <input type="number" class="form-control" @bind="_formProduct.Price" />
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label small">Количество на складе</label>
                                        <input type="number" class="form-control" @bind="_formProduct.Quantity" />
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label small">Статус</label>
                                        <select class="form-select" @bind="_formProduct.Status">
                                            @foreach (var status in Enum.GetValues(typeof(StatusProduct)).Cast<StatusProduct>())
                                            {
                                                <option value="@status">@status</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label small">Фото (заглушка)</label>
                                        <input type="file" class="form-control" disabled />
                                    </div>
                                </div>
                                <div class="modal-footer border-0">
                                    <button type="button" class="btn btn-secondary" @onclick="CloseProductModal">Отмена</button>
                                    <button type="button" class="btn btn-primary" @onclick="SaveProduct">Сохранить</button>
                                </div>
                            </div>
                        </div>
                    </div>
                }

                <!-- Модалка заказа -->
                @if (_showOrderModal)
                {
                    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);" @onclick="CloseOrderModal">
                        <div class="modal-dialog modal-dialog-centered modal-lg" @onclick:stopPropagation="true">
                            <div class="modal-content rounded-3">
                                <div class="modal-header border-0 pb-0">
                                    <h5 class="modal-title">@(_editableOrderId == 0 ? "Создать заказ" : "Редактировать заказ")</h5>
                                    <button type="button" class="btn-close" aria-label="Закрыть" @onclick="CloseOrderModal"></button>
                                </div>
                                <div class="modal-body">
                                    <div class="mb-3">
                                        <label class="form-label small">Логин покупателя</label>
                                        <input type="text" class="form-control" @bind="_formOrder.CustomerLogin" />
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label small">Товары</label>
                                        @for (int i = 0; i < _formOrder.Positions.Count; i++)
                                        {
                                            var index = i;
                                            <div class="d-flex gap-2 mb-2">
                                                <select class="form-select" @bind="_formOrder.Positions[index].ProductId">
                                                    <option value="0">Выберите товар</option>
                                                    @foreach (var product in _allProductsList)
                                                    {
                                                        <option value="@product.Id">@product.Name</option>
                                                    }
                                                </select>
                                                <input type="number" class="form-control" style="width:100px;" placeholder="Кол-во" @bind="_formOrder.Positions[index].Quantity" />
                                                <button class="btn btn-outline-danger btn-sm" @onclick="() => DeleteOrderItem(index)"><i class="fas fa-times"></i></button>
                                            </div>
                                        }
                                        <button class="btn btn-outline-primary btn-sm" @onclick="AddOrderItem"><i class="fas fa-plus me-1"></i>Добавить позицию</button>
                                    </div>
                                </div>
                                <div class="modal-footer border-0">
                                    <button type="button" class="btn btn-secondary" @onclick="CloseOrderModal">Отмена</button>
                                    <button type="button" class="btn btn-primary" @onclick="SaveOrder">Сохранить</button>
                                </div>
                            </div>
                        </div>
                    </div>
                }

                <!-- Модалка начисления средств -->
                @if (_showFundsModal)
                {
                    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);" @onclick="CloseFundsModal">
                        <div class="modal-dialog modal-dialog-centered" @onclick:stopPropagation="true">
                            <div class="modal-content rounded-3">
                                <div class="modal-header border-0 pb-0">
                                    <h5 class="modal-title">Начислить средства</h5>
                                    <button type="button" class="btn-close" aria-label="Закрыть" @onclick="CloseFundsModal"></button>
                                </div>
                                <div class="modal-body">
                                    <div class="mb-3">
                                        <label class="form-label small">Поиск пользователя</label>
                                        <input list="usersDatalist" class="form-control"
                                               @bind="_userSearchForAccrual" @bind:event="oninput"
                                               @onchange="SelectedInSearchUser"
                                               placeholder="Введите логин" />
                                        <datalist id="usersDatalist">
                                            @foreach (var user in _allUsersList)
                                            {
                                                <option value="@user.LoginName"></option>
                                            }
                                        </datalist>
                                        <button class="btn btn-outline-secondary btn-sm mt-2" @onclick="SelectedInSearchUser">Выбрать</button>
                                    </div>
                                    @if (_selectedUserForAccrual != null)
                                    {
                                        <div class="alert alert-info py-2 small">Выбран: @_selectedUserForAccrual.LoginName</div>
                                    }
                                    <input type="number" class="form-control mb-3" placeholder="Сумма" @bind="_sumAccrual" />
                                    <input type="text" class="form-control" placeholder="Комментарий" @bind="_commentAccrual" />
                                </div>
                                <div class="modal-footer border-0">
                                    <button type="button" class="btn btn-secondary" @onclick="CloseFundsModal">Отмена</button>
                                    <button type="button" class="btn btn-primary" @onclick="AddFunds">Начислить</button>
                                </div>
                            </div>
                        </div>
                    </div>
                }
</div>